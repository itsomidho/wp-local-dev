# Docker Compose project name — pins container/volume/network names so they
# stay stable regardless of what this directory is called. Set once and
# leave it; changing it later requires migrating the mysql/portainer volumes
# over to volumes under the new name, or Compose will look for new, empty
# ones instead of your real data.
COMPOSE_PROJECT_NAME=wp-local-dev

# MySQL Root Password
DB_ROOT_PASSWORD=root_password

# Port Configuration
#
# HTTP/HTTPS stay on the standard 80/443 -- that's what lets you visit
# https://mysite.test with no port in the URL, the whole point of mkcert.
# Override only if something else on this machine is already bound to them.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
#
# Everything else below is intentionally NOT on its service's usual default
# (3306, 6379, 8080, 9000, 8025/1025, 9090, 8081) -- those are some of the
# most commonly-already-bound ports on a dev machine (another local MySQL/
# Redis, some other tool's web UI on 8080/9000, etc). One dedicated block
# (39000-39007) instead, picked specifically for being unlikely to already
# be taken by anything else -- change any single one here if it ever does
# collide, same as you would have had to with the old defaults anyway.
MYSQL_PORT=39000
REDIS_PORT=39001
ADMINER_PORT=39002
PORTAINER_PORT=39003
MAILPIT_UI_PORT=39004
MAILPIT_SMTP_PORT=39005
API_PORT=39006
DASHBOARD_PORT=39007

# API service (optional HTTP API wrapping wpdev, for a GUI or other tooling —
# see the README's "API service" section). Bound to 127.0.0.1 only
# regardless of these settings.
#
# If unset, the API runs with no auth at all beyond that 127.0.0.1 binding.
# Set this to require "Authorization: Bearer <token>" on every request.
#API_TOKEN=
#
# Optional: the output of `mkcert -CAROOT` on this host. Lets sites created
# through the API get a properly browser-trusted certificate, same as sites
# created from the CLI. Leave unset and the API container just uses its own
# local CA instead — certs still work, but browsers won't trust them.
#MKCERT_CAROOT=
#
# Auto-managed by `wpdev up` — do not set these by hand. PROJECT_DIR is this
# directory's real path; API_UID/API_GID are `id -u`/`id -g` for whoever ran
# `wpdev up` (so files the API container writes directly — snapshots, nginx
# configs, SSL certs, backups — land owned by you on the host, not root);
# DOCKER_GID is the bind-mounted Docker socket's real gid (so that
# non-root user can still reach it). All four are real facts about this
# machine, re-detected and kept in sync on every `wpdev up` — never copy
# another machine's (or this file's) values by hand.
#PROJECT_DIR=
#API_UID=
#API_GID=
#DOCKER_GID=
#
# Also auto-managed by `wpdev up` — `git describe` for this checkout,
# shown in the dashboard's header. Re-detected on every `wpdev up`, so it
# always reflects whatever commit/tag is actually checked out here.
#APP_VERSION=

# Build-time proxy (optional). Only needed if your network requires a proxy to
# reach the internet during a build (apt, wp-cli/PECL, npm). Every build
# service gets these; 127.0.0.1 works because builds use the host network
# namespace. Note this covers BUILDS only -- image pulls are the daemon's
# work and need a "proxies" block in /etc/docker/daemon.json instead (see
# the README's "Host environment").
# Leave unset/empty for a normal, no-proxy build.
#HTTP_PROXY=http://127.0.0.1:10808
#HTTPS_PROXY=http://127.0.0.1:10808
#NO_PROXY=localhost,127.0.0.1
