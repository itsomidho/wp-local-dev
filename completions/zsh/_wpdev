#compdef wpdev
#
# Zsh completion for wpdev (wp-local-dev's CLI). Autoloadable: works with
# plain zsh (add this file's directory to $fpath before `compinit`) and with
# oh-my-zsh (symlink the wpdev/ directory containing this file into
# ~/.oh-my-zsh/custom/plugins/wpdev, then add wpdev to plugins=(...) in
# .zshrc -- oh-my-zsh adds each listed plugin's directory to $fpath itself).
#
# Site-name completion resolves wpdev's own project directory the same way
# wpdev itself does (readlink -f on its own path, see SCRIPT_DIR in wpdev),
# and reads nginx/sites/*.conf -- the same source wpdev's own site_domains()
# treats as authoritative -- not sites/*/, which can contain stray leftover
# directories that were never actually provisioned.

_wpdev_root() {
    local p
    p="$(command -v wpdev 2>/dev/null)" || return 1
    dirname "$(readlink -f "$p")"
}

_wpdev_sites() {
    local root f name site
    root="$(_wpdev_root)" || return
    for f in "$root"/nginx/sites/*.conf(N); do
        name="${f:t:r}"
        [[ "$name" == default ]] && continue
        # The site's name is the directory its vhost serves (any suffix).
        site="$(sed -n 's|^[[:space:]]*root /var/www/\([^/;]*\);.*|\1|p' "$f" | head -1)"
        print -r -- "${site:-$name}"
    done
}

_wpdev() {
    local -a cmds
    cmds=(
        'up:Start all containers'
        'down:Stop all containers'
        'restart:Restart all containers, or the named services'
        'stats:Live CPU/memory/network/disk I/O per container'
        'images:This project'\''s images (list, rm, prune)'
        'volumes:This project'\''s volumes (list, rm)'
        'inspect:A service'\''s container details (secrets masked)'
        'update:git pull, then rebuild + recreate all containers'
        'update-check:Fetch and report whether an update is available'
        'status:Show container status'
        'doctor:Proactive health check'
        'fix-vpn-network:Move Docker networks off VPN-routed ranges'
        'logs:Tail logs (all services, or one)'
        'shell:Shell into a container'
        'db:Open a MySQL prompt'
        'adminer:Open Adminer in the browser'
        'mailpit:Open Mailpit in the browser'
        'reload-nginx:Test and reload Nginx config'
        'cache:Toggle nginx full-page cache for a site'
        'cache-purge:Clear the full-page cache'
        'backup:mysqldump --all-databases to backups/'
        'restore-all:Replace every database from a backup'
        'install-mkcert:One-time local CA setup for trusted SSL'
        'clean:Remove containers (keeps data)'
        'clean-all:Remove containers + volumes (deletes data)'
        'uninstall:Remove containers/volumes/images + the wpdev symlink'
        'add:Provision a new WordPress site'
        'remove:Delete a site'
        'clone:Duplicate a site under a new domain'
        'snapshot:Save a files+DB snapshot of a site'
        'restore:Restore a site from a snapshot'
        "db-export:Dump just that site's database"
        "db-import:Replace that site's database from a dump"
        "db-tables:List that site's tables"
        "db-backup:Back up databases now"
        "db-backups:List, schedule or remove a site's backups"
        "debug:Show or change WordPress debug settings"
        "debug-log:Show, follow or clear a site's debug.log"
        "share:Share a site with other devices for a while"
        'list:List configured site domains'
        'hosts:Print /etc/hosts entries needed for all sites'
        'check-domain:Whether a domain is free for a new site'
        'update-tlds:Refresh the list of real top-level domains'
        "open:Open a site's folder in the file manager or Neovim"
        "creds:Show a site's admin/DB credentials"
        "cert:Reissue a site's HTTPS certificate"
        "fix-perms:Give a site's files back to you"
        "media-proxy:Load uploads missing locally from production"
        "admin-domain:Move wp-admin to a separate domain"
        'link:Use a plugin or theme folder from outside this project in a site'
        'unlink:Remove a linked plugin or theme from a site'
        'links:List linked plugins and themes'
        "link-browse:A folder's subfolders, marking plugins and themes"
        'wp:Run a WP-CLI command against a site'
        'help:Show usage'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' cmds
        return
    fi

    local subcmd="${words[2]}"
    case "$subcmd" in
        remove|snapshot|restore|db-tables|creds|cert|fix-perms|media-proxy|admin-domain|wp|clone|db|adminer)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            fi
            ;;
        open)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            elif (( CURRENT == 4 )); then
                compadd -- --editor=nvim
            fi
            ;;
        cache)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            elif (( CURRENT == 4 )); then
                compadd on off
            fi
            ;;
        shell)
            if (( CURRENT == 3 )); then
                compadd php db nginx redis
            elif (( CURRENT == 4 )) && [[ "${words[3]}" == php ]]; then
                compadd 7.4 8.0 8.1 8.2 8.3 8.4 8.5
            fi
            ;;
        inspect)
            (( CURRENT == 3 )) && compadd mysql php74 php80 php81 php82 php83 php84 php85 redis mailpit nginx adminer api dashboard
            ;;
        images)
            (( CURRENT == 3 )) && compadd -- --json rm prune
            ;;
        volumes)
            (( CURRENT == 3 )) && compadd -- --json rm
            ;;
        restart)
            compadd mysql php74 php80 php81 php82 php83 php84 php85 redis mailpit nginx adminer api dashboard
            ;;
        logs)
            if (( CURRENT == 3 )); then
                compadd mysql php74 php80 php81 php82 php83 php84 php85 redis mailpit nginx adminer
            fi
            ;;
        restore-all)
            if (( CURRENT == 3 )); then
                _files
            fi
            ;;
        # Not in the plain site-name branch above, which would match first.
        db-import)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            elif (( CURRENT == 4 )); then
                _files
            else
                compadd -- --tables= --rewrite-urls --yes
            fi
            ;;
        db-export)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            else
                compadd -- --tables=
            fi
            ;;
        db-backup)
            compadd -- $(_wpdev_sites) --all --due --suffix=
            ;;
        link)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            elif (( CURRENT == 4 )); then
                _files -/
            else
                compadd -- --name=
            fi
            ;;
        unlink)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            elif (( CURRENT == 4 )); then
                local root l
                root="$(_wpdev_root)" || return
                for l in "$root/sites/${words[3]}/wp-content/"{plugins,themes}/*(N@); do
                    compadd -- "${l:t}"
                done
            fi
            ;;
        links)
            compadd -- $(_wpdev_sites) --json
            ;;
        link-browse)
            (( CURRENT == 3 )) && _files -/
            ;;
        update-check)
            compadd -- --porcelain
            ;;
        debug)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            elif (( CURRENT == 4 )); then
                compadd on off set
            elif (( CURRENT == 5 )) && [[ "${words[4]}" == set ]]; then
                compadd WP_DEBUG WP_DEBUG_LOG WP_DEBUG_DISPLAY SCRIPT_DEBUG SAVEQUERIES
            elif (( CURRENT == 6 )); then
                compadd true false
            fi
            ;;
        share)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            elif (( CURRENT == 4 )); then
                compadd on off
            elif [[ "${words[4]}" == on ]]; then
                compadd -- --for= --public --password= --admin
            fi
            ;;
        debug-log)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            else
                compadd -- --lines= --follow clear
            fi
            ;;
        db-backups)
            if (( CURRENT == 3 )); then
                compadd -- $(_wpdev_sites)
            elif (( CURRENT == 4 )); then
                compadd schedule rm
            elif [[ "${words[4]}" == schedule ]]; then
                compadd -- 1h 6h 12h 1d 1w off --keep=
            fi
            ;;
    esac
}

_wpdev "$@"
