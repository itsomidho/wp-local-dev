# Reissue a site's certificate from the current mkcert CA and reload
# nginx. `add`/`clone` never replace an existing cert, so this is the way
# out for one that expired or came from a different CA -- e.g. a site
# created from the dashboard before MKCERT_CAROOT was shared with it.
# Written to temp files first: a failed mkcert leaves the old cert (and
# a working site) in place rather than half-replaced. (#11)
cmd_cert() {
    arg="$1"
    if [ -z "$arg" ]; then
        print_warning "Usage: wpdev cert <site-name>"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi
    site_name="${arg%.test}"
    site_name="${site_name//./-}"
    domain="${site_name}.test"
    [ -f "nginx/sites/${domain}.conf" ] || print_error "No such site: ${site_name} (checked nginx/sites/${domain}.conf)"
    command -v mkcert >/dev/null 2>&1 || print_error "mkcert isn't installed — run: wpdev install-mkcert"

    mkdir -p nginx/ssl/certs nginx/ssl/private
    cert="nginx/ssl/certs/${domain}.pem"
    key="nginx/ssl/private/${domain}-key.pem"
    if ! mkcert -cert-file "${cert}.new" -key-file "${key}.new" "$domain" >/dev/null 2>&1; then
        rm -f "${cert}.new" "${key}.new"
        print_error "mkcert failed — the existing certificate was left as it was."
    fi
    mv -f "${cert}.new" "$cert"
    mv -f "${key}.new" "$key"
    print_info "Certificate reissued for ${domain} (CA: $(mkcert -CAROOT 2>/dev/null))"

    if docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1; then
        print_info "nginx reloaded — reload the page in your browser to pick it up"
    else
        print_warning "nginx didn't reload (is it running?) — the new cert takes effect on its next start: wpdev up"
    fi
}

# Opt-in nginx FastCGI full-page cache, toggled by regenerating the site's
# vhost from one of two templates (plain vs. cached) -- the same
# DOMAIN/SITE_NAME/PHP_UPSTREAM substitution cmd_add already does, just
# picking a different source template. Lets you catch cache-interaction
# bugs (stale content, logged-in users seeing anonymous pages, broken
# cache-busting on form submits) locally before a production box with
# caching turned on ever sees them.
cmd_cache() {
    arg="$1"
    mode="$2"
    if [ -z "$arg" ] || [ -z "$mode" ]; then
        print_warning "Usage: wpdev cache <site-name> <on|off>"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi
    case "$mode" in
        on|off) ;;
        *) print_error "Mode must be 'on' or 'off', got '${mode}'" ;;
    esac

    site_name="${arg%.test}"
    site_name="${site_name//./-}"
    domain="${site_name}.test"

    if [ ! -f "nginx/sites/${domain}.conf" ]; then
        print_error "No such site: ${site_name} (checked nginx/sites/${domain}.conf)"
    fi

    php_svc="$(site_php_service "$site_name")"
    if [ "$mode" = "on" ]; then
        template="nginx/sites/site.conf.cached.template"
    else
        template="nginx/sites/site.conf.template"
    fi

    sed "s/DOMAIN/$domain/g" "$template" > "nginx/sites/${domain}.conf"
    sed -i "s|/var/www/SITE_NAME|/var/www/$site_name|g" "nginx/sites/${domain}.conf"
    sed -i "s/SITE_NAME/$site_name/g" "nginx/sites/${domain}.conf"
    sed -i "s/PHP_UPSTREAM/$php_svc/g" "nginx/sites/${domain}.conf"

    if [ "$mode" = "on" ]; then
        # sites/<name>/.cache-ttl -- a plain duration (60m, 1h, 30s), not
        # nginx syntax to hand-tune; validated so a typo fails here with a
        # clear message instead of a cryptic nginx -t error later.
        # || true: same set -e gotcha as elsewhere in this script -- cat on
        # a missing file (the normal case: most sites have no .cache-ttl)
        # exits nonzero even with stderr silenced, and a bare assignment
        # isn't exempt from set -e the way `cmd1 && cmd2` is. Confirmed the
        # hard way: this silently killed the whole command with zero output
        # whenever .cache-ttl didn't exist.
        ttl="$(cat "sites/${site_name}/.cache-ttl" 2>/dev/null)" || true
        [ -z "$ttl" ] && ttl="60m"
        if [[ ! "$ttl" =~ ^[0-9]+[smhdwMy]?$ ]]; then
            print_error "Invalid .cache-ttl value '${ttl}' -- expected a plain duration like 60m, 1h, or 30s."
        fi

        # sites/<name>/.cache-bypass-cookies -- one cookie name per line,
        # never raw regex. A trailing '*' means "starts with" (needed for
        # cookies with a dynamic suffix, e.g. WooCommerce's session cookie);
        # anything else must match that exact name. Validated against a
        # strict whitelist BEFORE it's escaped and spliced into nginx's
        # bypass regex, so this file can't break the generated config or
        # smuggle in nginx syntax -- it only ever contains cookie names.
        bypass="comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in"
        cookie_file="sites/${site_name}/.cache-bypass-cookies"
        if [ -f "$cookie_file" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
                [ -z "$line" ] && continue
                case "$line" in \#*) continue ;; esac

                name="$line"
                case "$name" in
                    *'*') name="${name%\*}" ;;
                esac
                case "$name" in
                    *[!A-Za-z0-9_.-]*|'')
                        print_error "Invalid line in ${cookie_file}: '${line}' -- cookie names may only contain letters, digits, '_', '-', '.', and an optional trailing '*' for a prefix match."
                        ;;
                esac
                # Only '.' needs escaping -- the whitelist above already
                # excludes every other regex-meaningful character. Doubled
                # backslash here (not a single \.) because $bypass is used
                # as a sed REPLACEMENT value below, and sed's own escape
                # handling in that position silently consumes one layer of
                # backslash -- confirmed the hard way: without this, the
                # generated nginx config had a literal unescaped '.' where
                # a cookie name like "my.cookie" should have had '\.'.
                escaped="$(echo "$name" | sed 's/\./\\\\./g')"
                bypass="${bypass}|${escaped}"
            done < "$cookie_file"
        fi

        # sites/<name>/.cache-bypass-paths -- one URL path per line, never
        # raw regex. Same trailing-'*'-means-prefix contract as the cookies
        # file, but anchored (^pattern$ for exact, ^pattern for prefix)
        # rather than loose substring -- unlike cookie names, URL paths
        # routinely share prefixes (a bare substring match on /cart/ would
        # also false-positive on /shop/cart/), so this one needs real
        # anchoring to mean what it looks like it means. The baseline
        # wp-admin/xmlrpc/wp-login/wp-cron rules get the same anchoring.
        bypass_paths='^/wp-admin/|^/xmlrpc\\.php$|^/wp-login\\.php$|^/wp-cron\\.php$'
        path_file="sites/${site_name}/.cache-bypass-paths"
        if [ -f "$path_file" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
                [ -z "$line" ] && continue
                case "$line" in \#*) continue ;; esac

                path="$line"
                is_prefix=0
                case "$path" in
                    *'*') path="${path%\*}"; is_prefix=1 ;;
                esac
                case "$path" in
                    *[!A-Za-z0-9/_.-]*|'')
                        print_error "Invalid line in ${path_file}: '${line}' -- paths may only contain letters, digits, '/', '_', '-', '.', and an optional trailing '*' for a prefix match."
                        ;;
                esac
                # Same doubled-backslash reasoning as the cookie escaping
                # above -- $bypass_paths is a sed REPLACEMENT value too.
                escaped="$(echo "$path" | sed 's/\./\\\\./g')"
                if [ "$is_prefix" -eq 1 ]; then
                    bypass_paths="${bypass_paths}|^${escaped}"
                else
                    bypass_paths="${bypass_paths}|^${escaped}\$"
                fi
            done < "$path_file"
        fi

        sed -i "s/CACHE_TTL/$ttl/g" "nginx/sites/${domain}.conf"
        sed -i "s/CACHE_BYPASS_COOKIES/$bypass/g" "nginx/sites/${domain}.conf"
        # '#' delimiter, not '/': unlike cookie names, every path value
        # contains '/' by definition (e.g. "/cart/"), which would otherwise
        # end the sed replacement field early -- confirmed the hard way,
        # this broke outright the moment a real path was involved.
        sed -i "s#CACHE_BYPASS_PATHS#$bypass_paths#g" "nginx/sites/${domain}.conf"
    fi

    if [ "$mode" = "on" ]; then
        touch "sites/${site_name}/.cache"

        # nginx-helper: auto-purges this site's own cached pages on save,
        # via its "unlink files" method -- verified directly against the
        # plugin's source that this needs zero nginx-side changes, since
        # our fastcgi_cache_path (levels=1:2) and fastcgi_cache_key
        # ("$scheme$request_method$host$request_uri") already exactly
        # match what unlink_files expects (it's the plugin's own
        # documented recipe). Needs the cache directory actually shared
        # between nginx and php (see docker-compose.yml) -- PHP has no
        # other way to reach files nginx wrote.
        #
        # Best-effort, not required: the core caching feature below is
        # pure nginx config with zero WordPress dependency, and must keep
        # working even if this plugin fails to install (e.g. no network
        # reaching wordpress.org). Confirmed the hard way that an
        # unguarded failure here aborted the whole function before ever
        # reaching the nginx reload -- the vhost got regenerated on disk
        # with caching enabled, but nginx never actually reloaded to pick
        # it up, so the site silently got no caching at all.
        nh_ok=1
        if docker compose exec -T "$php_svc" wp plugin is-installed nginx-helper --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
            docker compose exec -T "$php_svc" wp plugin activate nginx-helper --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || nh_ok=0
        else
            docker compose exec -T "$php_svc" wp plugin install nginx-helper --activate --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || nh_ok=0
        fi
        if [ "$nh_ok" -eq 1 ]; then
            docker compose exec -T "$php_svc" wp config set RT_WP_NGINX_HELPER_CACHE_PATH '/var/cache/nginx/fastcgi' --type=constant --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || nh_ok=0
        fi
        if [ "$nh_ok" -eq 1 ]; then
            # Full options array, not just the two keys that matter
            # (enable_purge, purge_method) -- activating via WP-CLI never
            # populates this option at all (the plugin's own activator
            # checks current_user_can(), always false with no WP-CLI user
            # context, so its store_default_options() call never runs).
            # Values taken directly from the plugin's own
            # nginx_helper_default_settings(), not guessed.
            docker compose exec -T "$php_svc" wp option update rt_wp_nginx_helper_options '{"enable_purge":1,"cache_method":"enable_fastcgi","purge_method":"unlink_files","enable_map":0,"enable_log":0,"log_level":"INFO","log_filesize":"5","enable_stamp":0,"purge_homepage_on_edit":1,"purge_homepage_on_del":1,"purge_archive_on_edit":1,"purge_archive_on_del":1,"purge_archive_on_new_comment":0,"purge_archive_on_deleted_comment":0,"purge_page_on_mod":1,"purge_page_on_new_comment":1,"purge_page_on_deleted_comment":1,"purge_feeds":1,"redis_hostname":"127.0.0.1","redis_port":"6379","redis_prefix":"nginx-cache:","redis_unix_socket":"","redis_database":0,"redis_username":"","redis_password":"","purge_url":"","redis_enabled_by_constant":0,"purge_amp_urls":1,"redis_socket_enabled_by_constant":0,"redis_acl_enabled_by_constant":0,"preload_cache":0,"is_cache_preloaded":0,"roles_with_purge_cap":[],"purge_woo_products":0}' --format=json --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || nh_ok=0
        fi
        if [ "$nh_ok" -eq 1 ]; then
            print_info "nginx-helper installed and configured for auto-purge on save"
        else
            print_warning "Could not set up nginx-helper (auto-purge on save) -- caching still works, just purge manually with 'wpdev cache-purge' or wait out the TTL. Retry with: wpdev cache ${site_name} on"
        fi
    else
        rm -f "sites/${site_name}/.cache"
        docker compose exec -T "$php_svc" wp plugin deactivate nginx-helper --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || true
    fi

    if docker exec wp-nginx nginx -t >/dev/null 2>&1; then
        docker exec wp-nginx nginx -s reload >/dev/null 2>&1
    else
        print_error "Generated an invalid nginx config for ${domain} -- run 'docker exec wp-nginx nginx -t' to see why."
    fi

    if [ "$mode" = "on" ]; then
        print_info "Full-page cache enabled for ${domain}."
        echo "Check it: curl -skI $(site_url "$domain")/ | grep -i x-fastcgi-cache"
        echo "(MISS the first request, HIT after -- BYPASS whenever you're logged in,"
        echo "posting a form, or hitting wp-admin.)"
    else
        print_info "Full-page cache disabled for ${domain}."
    fi
}

cmd_cache_purge() {
    if docker compose exec -T nginx true </dev/null >/dev/null 2>&1; then
        docker compose exec -T nginx sh -c "rm -rf /var/cache/nginx/fastcgi/*" </dev/null 2>/dev/null
        print_info "Full-page cache purged (shared across every site that has it enabled)."
    else
        print_warning "Nginx isn't running -- nothing to purge."
    fi
}

cmd_backup() {
    mkdir -p backups
    timestamp=$(date +%Y%m%d_%H%M%S)
    echo "Creating backup..."
    docker exec wp-mysql mysqldump -u root -p"$(grep DB_ROOT_PASSWORD .env | cut -d '=' -f2)" --all-databases > "backups/all_databases_${timestamp}.sql"
    echo "Backup saved to: backups/all_databases_${timestamp}.sql"
}

# Counterpart to `backup` -- until this existed, backup was one-directional:
# you could dump every database, but the only way to actually use that dump
# was hand-crafting a `mysql < dump.sql` yourself. A mysqldump --all-databases
# file already contains its own CREATE DATABASE/USE statements per database,
# so piping the whole thing into a bare `mysql` (no database selected) is the
# standard, correct way to restore one.
cmd_restore_all() {
    assume_yes=0
    args=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            *) args+=("$a") ;;
        esac
    done
    in_file="${args[0]:-}"
    if [ -z "$in_file" ]; then
        # Lexical sort = chronological, same reasoning as snapshot IDs: the
        # timestamp format (YYYYMMDD_HHMMSS) sorts correctly as text.
        in_file="$(ls -1 backups/all_databases_*.sql backups/all_databases_*.sql.gz 2>/dev/null | sort | tail -1)"
        if [ -z "$in_file" ]; then
            print_error "No backups found in backups/. Run 'wpdev backup' first, or pass a file explicitly."
        fi
        print_info "No file given — using the most recent backup: ${in_file}"
    fi
    if [ ! -f "$in_file" ]; then
        print_error "No such file: ${in_file}"
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    echo "This will REPLACE every database currently in MySQL with the contents of:"
    echo "  ${in_file}"
    echo ""
    echo "Any current data not already in this backup will be lost. This does NOT"
    echo "back up the current state first — run 'wpdev backup' before this if you"
    echo "want to keep what's there now."
    echo ""
    echo "Known sites right now: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Type RESTORE to confirm: " confirm
        if [ "$confirm" != "RESTORE" ]; then
            cancelled
        fi
    fi

    print_step "1/2 Restoring from ${in_file}..."
    # Not swallowing stderr here (unlike db-import) -- this touches every
    # database at once, so a partial/silent failure is worth seeing.
    if gzip -t "$in_file" 2>/dev/null; then
        gunzip -c "$in_file" | docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD"
    else
        docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" < "$in_file"
    fi
    print_info "Databases restored"

    print_step "2/2 Flushing Redis (every site's object cache)..."
    if docker compose exec -T redis true </dev/null >/dev/null 2>&1; then
        docker compose exec -T redis redis-cli FLUSHALL >/dev/null 2>&1
    fi
    print_info "Cache flushed"

    echo ""
    print_info "All databases restored from ${in_file}."
}

cmd_install_mkcert() { ./install-mkcert.sh; }

cmd_clean() { docker compose down; }

cmd_clean_all() {
    assume_yes=0
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
        esac
    done
    echo "⚠️  WARNING: This will delete all WordPress files and databases!"
    if [ "$assume_yes" -eq 1 ]; then
        confirm="yes"
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Are you sure? (yes/no): " confirm
    fi
    if [ "$confirm" = "yes" ]; then
        docker compose down -v
        rm -rf sites/*/
        echo "All data removed."
    else
        cancelled
    fi
}

# Full removal, in three separately-confirmed stages — each one is
# independently safe to stop after, so cancelling partway through never
# leaves a confusing half-removed state:
#   1. containers + volumes + the images built from this repo (same as
#      clean-all, plus --rmi local, since clean-all alone leaves the
#      wp-local-dev-php8x images behind)
#   2. the `wpdev` symlink on PATH (only if it actually points at this
#      checkout -- never touches a symlink belonging to some other project)
#   3. this directory itself, including every site's files, logs,
#      snapshots, and backups -- requires typing DELETE, not just yes/no,
#      since unlike steps 1-2 there is no undo
cmd_uninstall() {
    print_warning "This removes wp-local-dev's containers, volumes, and built images."
    echo "Site files on disk (sites/, backups/, snapshots/, logs/) are not touched by this step."
    read -p "Continue? (yes/no): " confirm
    if [ "$confirm" != "yes" ]; then
        cancelled
    fi
    docker compose down -v --rmi local
    print_info "Containers, volumes, and images removed."

    for bin_dir in "$HOME/.local/bin" "/usr/local/bin"; do
        link="${bin_dir}/wpdev"
        if [ -L "$link" ] && [ "$(readlink -f "$link")" = "${SCRIPT_DIR}/wpdev" ]; then
            rm -f "$link"
            print_info "Removed symlink ${link}"
        fi
    done

    echo
    echo "Everything above this line is done. What's left is this directory itself:"
    echo "  ${SCRIPT_DIR}"
    echo "including every site's files, database dumps, and snapshots -- there is no undo for this part."
    read -p "Delete it too? Type DELETE to confirm, anything else to keep it: " confirm2
    if [ "$confirm2" = "DELETE" ]; then
        target="$SCRIPT_DIR"
        cd /
        rm -rf "$target"
        echo "wp-local-dev fully removed."
    else
        print_info "Directory kept. Remove it yourself anytime with: rm -rf ${SCRIPT_DIR}"
    fi
}

# ---------------------------------------------------------------------------
# Sites
# ---------------------------------------------------------------------------

# Domains are derived from nginx/sites/*.conf, the actual source of truth for
# what's routable (default.conf is the catch-all, not a site; .template isn't
# a config at all — both excluded).
site_domains() {
    for conf in nginx/sites/*.conf; do
        [ -e "$conf" ] || continue
        name="$(basename "$conf" .conf)"
        [ "$name" = "default" ] && continue
        echo "$name"
    done
}

# A freshly-created MySQL container (first-ever `up`, or any CI run, which
# is always a cold start) takes a few seconds to accept connections after
# `docker compose up` returns -- the container exists and is "Started" well
# before mysqld inside it is actually ready. Without this wait, the CREATE
# DATABASE step right after can fail outright against a cold MySQL, which
# never showed up testing by hand (this machine's MySQL was always already
# warm) and was only caught by the CI smoke test's first real run.
#
# -h127.0.0.1 forces a TCP connection, not a Unix socket -- confirmed by
# direct reproduction that mysqld's own bootstrap phase (which sets the
# root password and runs init scripts, before the real server starts)
# listens on the socket but not TCP, so a socket-based ping here can
# report "ready" during a ~5s window where the server is about to shut
# down and restart, right before the CREATE DATABASE step would run.
wait_for_mysql() {
    for _ in $(seq 1 30); do
        docker compose exec -T mysql mysqladmin ping -h127.0.0.1 -uroot -p"$DB_ROOT_PASSWORD" --silent </dev/null >/dev/null 2>&1 && return 0
        sleep 1
    done
    print_error "MySQL did not become ready within 30 seconds."
}

# "8.3" -> "php83" — the compose service/container name for a PHP version.
php_slug() { echo "php${1//./}"; }

# The compose service (php81/php82/php83/php84) that actually serves a given
# site, based on sites/<name>/.php-version. Falls back to the default version
# for sites that predate multi-PHP support (no marker file) — which is
# exactly the version their Nginx vhost's literal `php:9000` already points
# at via the alias on php82, so this stays consistent with reality without
# needing every pre-existing site retrofitted.
site_php_service() {
    version="$(cat "sites/${1}/.php-version" 2>/dev/null)"
    [ -z "$version" ] && version="$DEFAULT_PHP_VERSION"
    php_slug "$version"
}

# Snapshot IDs sort lexically = chronologically, since they start with
# YYYYMMDD_HHMMSS.
site_snapshots() {
    for d in "snapshots/${1}"/*/; do
        [ -d "$d" ] || continue
        basename "$d"
    done | sort
}

cmd_list() {
    print_header "=== Configured WordPress Sites ==="
    echo ""

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        print_warning "No sites configured yet. Run: wpdev add"
        return
    fi

    for domain in $domains; do
        site_name="${domain%.test}"
        site_name="${site_name//./-}"
        if [ -d "sites/${site_name}" ]; then
            # || true: same set -e gotcha as cmd_status -- a site missing
            # .php-version would otherwise silently kill `wpdev list` for
            # every site, not just itself.
            php_version="$(cat "sites/${site_name}/.php-version" 2>/dev/null)" || true
            [ -z "$php_version" ] && php_version="$DEFAULT_PHP_VERSION"
            wp_status="provisioned, php ${php_version}"
        else
            wp_status="no site files found (expected sites/${site_name})"
        fi
        echo "  $(site_url "$domain")  →  sites/${site_name}  ($wp_status)"
    done
    echo ""
}

cmd_hosts() {
    print_header "=== Required /etc/hosts Entries ==="
    echo ""

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        print_warning "No sites configured yet."
        return
    fi

    for domain in $domains; do
        echo "127.0.0.1    $domain"
    done
    echo ""
    print_info "Add missing entries with: echo '<line above>' | sudo tee -a /etc/hosts"
}

cmd_creds() {
    site="$1"
    if [ -z "$site" ]; then
        print_warning "Usage: wpdev creds <site-name>"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi

    dir="sites/${site}"
    if [ ! -d "$dir" ]; then
        print_warning "No such site directory: $dir"
        return 1
    fi

    # || true: same set -e gotcha as cmd_status/cmd_list.
    php_version="$(cat "$dir/.php-version" 2>/dev/null)" || true
    [ -z "$php_version" ] && php_version="$DEFAULT_PHP_VERSION"

    echo "Site: $site"
    echo "  PHP:       ${php_version} ($(php_slug "$php_version"))"
    if [ -f "$dir/.admin-password" ]; then
        echo "  wp-admin:  admin / $(cat "$dir/.admin-password")"
    else
        echo "  wp-admin:  (no saved password — site predates wpdev automation, or was installed manually)"
    fi
    if [ -f "$dir/.db-password" ]; then
        echo "  DB user:   wp_${site//-/_} / $(cat "$dir/.db-password")"
    else
        echo "  DB user:   (no saved password)"
    fi
}

cmd_wp() {
    site="$1"
    if [ -z "$site" ]; then
        print_warning "Usage: wpdev wp <site-name> <wp-cli args...>"
        echo "Example: wpdev wp mysite plugin list"
        return 1
    fi
    shift
    docker compose exec -T "$(site_php_service "$site")" wp --path="/var/www/${site}" --allow-root "$@"
}

cmd_remove() {
    assume_yes=0
    args=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            *) args+=("$a") ;;
        esac
    done
    arg="${args[0]:-}"
    if [ -z "$arg" ]; then
        print_warning "Usage: wpdev remove <site-name> [--yes]"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi

    # Accept either the bare site name (matches `creds`/sites/<name>) or the
    # full domain (matches nginx/sites/<domain>.conf) — strip .test either way.
    site_name="${arg%.test}"
    site_name="${site_name//./-}"
    domain="${site_name}.test"

    if [ ! -f "nginx/sites/${domain}.conf" ] && [ ! -d "sites/${site_name}" ]; then
        print_error "No such site: ${domain} (checked nginx/sites/${domain}.conf and sites/${site_name}/)"
    fi

    php_svc="$(site_php_service "$site_name")"

    # Read the real DB_NAME/DB_USER from wp-config.php when available — same
    # principle as clone/doctor/adminer: don't guess wp_<slug>, since sites
    # set up before this tool existed don't follow that convention. Guessing
    # here would drop the wrong (nonexistent) database and silently orphan
    # the real one — exactly what happened once already with wp-lab.
    config="sites/${site_name}/wp-config.php"
    if [ -f "$config" ]; then
        db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
        db_user="$(grep "DB_USER" "$config" | sed -E "s/.*DB_USER',[[:space:]]*'([^']*)'.*/\1/")"
    fi
    if [ -z "${db_name:-}" ]; then
        db_slug="${site_name//-/_}"
        db_slug="${db_slug:0:28}"
        db_name="wp_${db_slug}"
        db_user="wp_${db_slug}"
    fi

    echo "This will permanently delete:"
    echo "  - sites/${site_name}/         (WordPress files)"
    echo "  - nginx/sites/${domain}.conf"
    echo "  - nginx/ssl/certs/${domain}.pem + private key"
    echo "  - logs/nginx/${site_name}_access.log + _error.log"
    if [ "$db_user" = "root" ]; then
        echo "  - MySQL database ${db_name} (its DB_USER is 'root' — shared infra, not dropped)"
    else
        echo "  - MySQL database ${db_name} and its user (${db_user})"
    fi
    echo "  - This site's cached keys in Redis (if any)"
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Type the domain to confirm (${domain}): " confirm
        if [ "$confirm" != "$domain" ]; then
            cancelled
        fi
    fi

    # Needs .env for root creds and mysql to be up. Skip gracefully if the
    # stack isn't running rather than failing the whole removal.
    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi

    if [ -n "${DB_ROOT_PASSWORD:-}" ] && docker compose exec -T mysql true </dev/null >/dev/null 2>&1; then
        if [ "$db_user" = "root" ]; then
            # Never drop the root user — it's shared across every site.
            docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
                DROP DATABASE IF EXISTS \`${db_name}\`;
            " </dev/null 2>/dev/null
            print_info "Dropped database '${db_name}'"
        else
            docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
                DROP DATABASE IF EXISTS \`${db_name}\`;
                DROP USER IF EXISTS '${db_user}'@'%';
            " </dev/null 2>/dev/null
            print_info "Dropped database '${db_name}' and user '${db_user}'"
        fi
    else
        print_warning "MySQL isn't reachable — database '${db_name}' was NOT dropped. Run 'wpdev up' then re-run this, or drop it manually."
    fi

    # Redis has no volume (pure cache), so this is just tidiness, not data
    # safety — orphaned keys under this site's prefix would otherwise sit in
    # the shared instance until it's restarted.
    if docker compose exec -T redis true </dev/null >/dev/null 2>&1; then
        docker compose exec -T redis sh -c "redis-cli --scan --pattern '${site_name}:*' | xargs -r redis-cli DEL" </dev/null >/dev/null 2>&1
    fi

    # WordPress files — written by the container (often as www-data/root), so
    # delete via the php container to sidestep host permission mismatches.
    if [ -d "sites/${site_name}" ]; then
        if docker compose exec -T "$php_svc" true </dev/null >/dev/null 2>&1; then
            docker compose exec -T "$php_svc" rm -rf "/var/www/${site_name}" </dev/null
        elif ! rm -rf "sites/${site_name}" 2>/dev/null; then
            print_warning "Could not remove sites/${site_name} (permission denied and ${php_svc} container isn't running). Run 'wpdev up' and retry, or: sudo rm -rf sites/${site_name}"
        fi
        [ -d "sites/${site_name}" ] || print_info "Removed sites/${site_name}"
    fi

    rm -f "nginx/sites/${domain}.conf" "nginx/ssl/certs/${domain}.pem" "nginx/ssl/private/${domain}-key.pem"
    print_info "Removed Nginx config and SSL certificate"

    # Nginx (running as root in-container) owns these on the host too, so a
    # plain host-side `rm` would hit "Permission denied" — delete via the
    # container instead. Includes logrotate remnants, not just the live files.
    if docker compose exec -T nginx true </dev/null >/dev/null 2>&1; then
        docker compose exec -T nginx sh -c "rm -f /var/log/nginx/${site_name}_access.log* /var/log/nginx/${site_name}_error.log*" </dev/null
        print_info "Removed Nginx logs"
        docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1 || true
    else
        print_warning "Nginx isn't running — logs/nginx/${site_name}_{access,error}.log were NOT removed (root-owned). Run 'wpdev up' and retry, or: sudo rm -f logs/nginx/${site_name}_*.log"
    fi

    echo ""
    print_info "${domain} removed."
    if grep -q "[[:space:]]${domain}" /etc/hosts 2>/dev/null; then
        echo "  It's still in /etc/hosts — remove it if you like:"
        echo "  sudo sed -i '/[[:space:]]${domain}\$/d' /etc/hosts"
    fi
}

cmd_clone() {
    assume_yes=0
    args=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            *) args+=("$a") ;;
        esac
    done
    source_arg="${args[0]:-}"
    new_arg="${args[1]:-}"
    if [ -z "$source_arg" ] || [ -z "$new_arg" ]; then
        print_warning "Usage: wpdev clone <source-site> <new-site> [--yes]"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi

    source_name="${source_arg%.test}"
    source_name="${source_name//./-}"
    new_name="${new_arg%.test}"
    new_name="${new_name//./-}"
    source_domain="${source_name}.test"
    new_domain="${new_name}.test"

    source_config="sites/${source_name}/wp-config.php"
    if [ ! -f "$source_config" ]; then
        print_error "No such site: ${source_name} (checked ${source_config})"
    fi
    if [ -d "sites/${new_name}" ] || [ -f "nginx/sites/${new_domain}.conf" ]; then
        print_error "sites/${new_name} or nginx/sites/${new_domain}.conf already exists — run 'wpdev remove ${new_name}' first, or pick a different name."
    fi

    # The clone inherits the source's PHP version — .php-version travels
    # along with everything else `cp -a` copies below, so this is also just
    # what site_php_service will resolve to for the clone afterward.
    php_svc="$(site_php_service "$source_name")"
    new_url="$(site_url "$new_domain")"

    echo "This will clone:"
    echo "  sites/${source_name}/  ->  sites/${new_name}/  (files + database)"
    echo "  New domain: $(site_url "$new_domain")"
    echo "  PHP version: $(cat "sites/${source_name}/.php-version" 2>/dev/null || echo "$DEFAULT_PHP_VERSION") (same as source)"
    echo "  Admin login will be the same as ${source_domain} (it's a copy of that database)."
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Continue? (y/n): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            cancelled
        fi
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    # New DB always follows the standard wp_<slug> convention, regardless of
    # what naming the SOURCE site happens to use (some predate this tool).
    db_slug="${new_name//-/_}"
    db_slug="${db_slug:0:28}"
    new_db_name="wp_${db_slug}"
    new_db_user="wp_${db_slug}"
    new_db_pass="$(openssl rand -hex 16)"

    print_step "1/8 Starting MySQL + PHP (${php_svc})..."
    docker compose up -d mysql "$php_svc" >/dev/null
    wait_for_mysql
    print_info "MySQL and PHP are up"

    print_step "2/8 Copying WordPress files..."
    docker compose exec -T "$php_svc" cp -a "/var/www/${source_name}" "/var/www/${new_name}" </dev/null
    # cp -a keeps symlinks verbatim, and an absolute one into the source
    # site would make the clone run the source's code. Query Monitor's
    # wp-content/db.php drop-in is exactly that, and it loads before
    # plugins, so the clone's own QM then fataled on a duplicate
    # autoloader class: a 500 on every page. (#15) Re-point every such
    # link at the same path inside the clone.
    docker compose exec -T "$php_svc" sh -c '
        src="/var/www/$1/"; dst="/var/www/$2/"
        find "$dst" -type l | while IFS= read -r link; do
            target="$(readlink "$link")"
            case "$target" in
                "$src"*) ln -sfn "${dst}${target#"$src"}" "$link" ;;
            esac
        done' sh "$source_name" "$new_name" </dev/null
    rm -f "sites/${new_name}/.admin-password" "sites/${new_name}/.db-password"
    [ -f "sites/${source_name}/.admin-password" ] && cp "sites/${source_name}/.admin-password" "sites/${new_name}/.admin-password"
    print_info "Files copied to sites/${new_name}"

    print_step "3/8 Creating Nginx configuration..."
    mkdir -p nginx/sites
    sed "s/DOMAIN/$new_domain/g" nginx/sites/site.conf.template > "nginx/sites/${new_domain}.conf"
    sed -i "s|/var/www/SITE_NAME|/var/www/$new_name|g" "nginx/sites/${new_domain}.conf"
    sed -i "s/SITE_NAME/$new_name/g" "nginx/sites/${new_domain}.conf"
    sed -i "s/PHP_UPSTREAM/$php_svc/g" "nginx/sites/${new_domain}.conf"
    print_info "Created nginx/sites/${new_domain}.conf"

    print_step "4/8 Cloning database..."
    source_db_name="$(grep "DB_NAME" "$source_config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
    docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
        CREATE DATABASE IF NOT EXISTS \`${new_db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        CREATE USER IF NOT EXISTS '${new_db_user}'@'%' IDENTIFIED BY '${new_db_pass}';
        ALTER USER '${new_db_user}'@'%' IDENTIFIED BY '${new_db_pass}';
        GRANT ALL PRIVILEGES ON \`${new_db_name}\`.* TO '${new_db_user}'@'%';
        FLUSH PRIVILEGES;
    " </dev/null 2>/dev/null
    docker compose exec -T mysql sh -c "mysqldump -uroot -p'${DB_ROOT_PASSWORD}' '${source_db_name}' | mysql -uroot -p'${DB_ROOT_PASSWORD}' '${new_db_name}'" </dev/null
    echo "$new_db_pass" > "sites/${new_name}/.db-password"
    print_info "Database '${source_db_name}' cloned to '${new_db_name}'"

    print_step "5/8 Rewriting wp-config.php for the clone..."
    # The URL the source's content actually uses -- its own WP_HOME, which
    # may carry a port (or a different one than nginx has now), rather than
    # a guess. Replacing a guessed https://<source> instead would turn
    # https://src.test:8444/... into https://new.test:8444:8444/...
    source_url="$(docker compose exec -T "$php_svc" wp config get WP_HOME --path="/var/www/${source_name}" --allow-root </dev/null 2>/dev/null | tr -d '\r')" || true
    [ -n "$source_url" ] || source_url="$(site_url "$source_domain")"
    # wp config set (not sed) so it works regardless of the source's file
    # layout/formatting, and correctly adds constants that aren't already there.
    docker compose exec -T "$php_svc" wp config set DB_NAME "${new_db_name}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    docker compose exec -T "$php_svc" wp config set DB_USER "${new_db_user}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    docker compose exec -T "$php_svc" wp config set DB_PASSWORD "${new_db_pass}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    docker compose exec -T "$php_svc" wp config set WP_HOME "${new_url}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    docker compose exec -T "$php_svc" wp config set WP_SITEURL "${new_url}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    docker compose exec -T "$php_svc" wp config set WP_REDIS_PREFIX "${new_name}:" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    docker compose exec -T "$php_svc" wp config set DISABLE_WP_CRON true --raw --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    print_info "wp-config.php updated"

    print_step "6/8 Generating SSL certificate..."
    mkdir -p nginx/ssl/certs nginx/ssl/private
    if ! command -v mkcert >/dev/null 2>&1; then
        print_warning "mkcert not installed. Run 'wpdev install-mkcert' then re-run this."
    else
        mkcert -install 2>/dev/null || true
        mkcert -cert-file "nginx/ssl/certs/${new_domain}.pem" \
               -key-file "nginx/ssl/private/${new_domain}-key.pem" \
               "${new_domain}" 2>/dev/null
        print_info "SSL certificate created"
    fi

    print_step "7/8 Re-pointing URLs and enabling object cache..."
    docker compose exec -T "$php_svc" wp search-replace "${source_url}" "${new_url}" \
        --path="/var/www/${new_name}" --all-tables --allow-root </dev/null >/dev/null
    docker compose exec -T "$php_svc" wp search-replace "${source_domain}" "${new_domain}" \
        --path="/var/www/${new_name}" --all-tables --allow-root </dev/null >/dev/null
    docker compose exec -T "$php_svc" wp redis enable --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null 2>&1 || true
    print_info "URLs re-pointed, object cache enabled"

    print_step "8/8 Reloading Nginx..."
    docker compose up -d nginx >/dev/null
    docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1 || true

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "${GREEN}✓ ${new_domain} is ready (cloned from ${source_domain})${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo -e "  Site:        ${GREEN}${new_url}${NC}"
    echo "  PHP version: $(cat "sites/${new_name}/.php-version" 2>/dev/null || echo "$DEFAULT_PHP_VERSION") (${php_svc})"
    echo "  Admin login: same as ${source_domain} (wpdev creds ${source_name})"
    echo "  Database:    ${new_db_name} / ${new_db_user} (password in sites/${new_name}/.db-password)"
    echo ""

    if grep -q "[[:space:]]${new_domain}$" /etc/hosts 2>/dev/null || grep -q "[[:space:]]${new_domain}[[:space:]]" /etc/hosts 2>/dev/null; then
        print_info "${new_domain} already in /etc/hosts"
    else
        # || true: everything above this already succeeded and printed its
        # own success banner -- if stdin hits EOF here (scripted/non-
        # interactive use that didn't expect this trailing optional prompt,
        # e.g. CI), `read`'s nonzero exit would otherwise take set -e down
        # with it this late, discarding a fully-completed clone over a
        # cosmetic prompt. EOF leaves add_hosts empty, which the check
        # below already treats the same as answering "n".
        # Non-interactive (--yes) never asks: there may be no one to
        # answer, and an open stdin that never sends EOF (a backgrounded
        # shell, a service) would otherwise block here forever after the
        # work is done. add_hosts stays empty, i.e. "n" -- just the hint.
        add_hosts=""
        if [ "$assume_yes" -ne 1 ]; then
            read -p "Add '127.0.0.1 ${new_domain}' to /etc/hosts now? (y/n): " add_hosts || true
        fi
        if [[ "$add_hosts" =~ ^[Yy]$ ]]; then
            echo "127.0.0.1    ${new_domain}" | sudo tee -a /etc/hosts >/dev/null
            print_info "Added ${new_domain} to /etc/hosts"
        else
            echo "  Remember: echo '127.0.0.1    ${new_domain}' | sudo tee -a /etc/hosts"
        fi
    fi
    echo ""
}

cmd_snapshot() {
    site_arg="$1"
    label="$2"
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev snapshot <site> [label]"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi

    site_name="${site_arg%.test}"
    site_name="${site_name//./-}"
    config="sites/${site_name}/wp-config.php"
    if [ ! -f "$config" ]; then
        print_error "No such site: ${site_name} (checked ${config})"
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    timestamp="$(date +%Y%m%d_%H%M%S)"
    snap_id="$timestamp"
    if [ -n "$label" ]; then
        safe_label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9_-' '-')"
        snap_id="${timestamp}_${safe_label}"
    fi
    snap_dir="snapshots/${site_name}/${snap_id}"
    mkdir -p "$snap_dir"

    db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"

    print_step "1/2 Dumping database (${db_name})..."
    docker compose exec -T mysql mysqldump -uroot -p"$DB_ROOT_PASSWORD" "$db_name" </dev/null 2>/dev/null | gzip > "$snap_dir/db.sql.gz"
    print_info "Database dumped ($(du -h "$snap_dir/db.sql.gz" | cut -f1))"

    print_step "2/2 Archiving files..."
    docker compose exec -T "$(site_php_service "$site_name")" tar -czf - -C /var/www "${site_name}" </dev/null > "$snap_dir/files.tar.gz"
    print_info "Files archived ($(du -h "$snap_dir/files.tar.gz" | cut -f1))"

    echo ""
    print_info "Snapshot saved: ${snap_id}"
    echo "  Restore with: wpdev restore ${site_name} ${snap_id}"
    echo "  (or just 'wpdev restore ${site_name}' to restore the most recent snapshot)"
}

cmd_snapshots() {
    site_arg="$1"
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev snapshots <site>"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi

    site_name="${site_arg%.test}"
    site_name="${site_name//./-}"

    available="$(site_snapshots "$site_name")"
    if [ -z "$available" ]; then
        echo "No snapshots found for '${site_name}'. Create one with: wpdev snapshot ${site_name}"
        return 0
    fi

    print_header "=== Snapshots for ${site_name} ==="
    echo "$available"
}

cmd_restore() {
    assume_yes=0
    args=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            *) args+=("$a") ;;
        esac
    done
    site_arg="${args[0]:-}"
    snap_id="${args[1]:-}"
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev restore <site> [snapshot-id] [--yes]"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi

    site_name="${site_arg%.test}"
    site_name="${site_name//./-}"
    domain="${site_name}.test"

    available="$(site_snapshots "$site_name")"
    if [ -z "$available" ]; then
        print_error "No snapshots found for '${site_name}'. Create one first: wpdev snapshot ${site_name}"
    fi

    if [ -z "$snap_id" ]; then
        snap_id="$(echo "$available" | tail -1)"
        print_info "No snapshot specified — using the most recent: ${snap_id}"
    fi

    snap_dir="snapshots/${site_name}/${snap_id}"
    if [ ! -d "$snap_dir" ]; then
        print_warning "No such snapshot: ${snap_id}"
        echo "Available snapshots for ${site_name}:"
        echo "$available" | sed 's/^/  /'
        return 1
    fi

    echo "This will overwrite the CURRENT files and database of ${domain} with"
    echo "snapshot '${snap_id}'. The current state is NOT saved first — take a new"
    echo "snapshot now if you want to keep it (wpdev snapshot ${site_name})."
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Type the domain to confirm (${domain}): " confirm
        if [ "$confirm" != "$domain" ]; then
            cancelled
        fi
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    db_name="$(grep "DB_NAME" "sites/${site_name}/wp-config.php" 2>/dev/null | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
    if [ -z "$db_name" ]; then
        db_slug="${site_name//-/_}"
        db_slug="${db_slug:0:28}"
        db_name="wp_${db_slug}"
    fi

    print_step "1/3 Restoring database (${db_name})..."
    docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
        DROP DATABASE IF EXISTS \`${db_name}\`;
        CREATE DATABASE \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
    " </dev/null 2>/dev/null
    gunzip -c "$snap_dir/db.sql.gz" | docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" "$db_name" 2>/dev/null
    print_info "Database restored"

    print_step "2/3 Restoring files..."
    php_svc="$(site_php_service "$site_name")"
    docker compose exec -T "$php_svc" sh -c "rm -rf /var/www/${site_name}" </dev/null
    docker compose exec -T "$php_svc" tar -xzf - -C /var/www < "$snap_dir/files.tar.gz"
    print_info "Files restored"

    print_step "3/3 Flushing this site's cache..."
    if docker compose exec -T redis true </dev/null >/dev/null 2>&1; then
        docker compose exec -T redis sh -c "redis-cli --scan --pattern '${site_name}:*' | xargs -r redis-cli DEL" </dev/null >/dev/null 2>&1
    fi
    docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1 || true
    print_info "Cache flushed (avoids serving stale cached content from before the restore)"

    echo ""
    print_info "${domain} restored to snapshot '${snap_id}'."
}

cmd_db_export() {
    site_arg="$1"
    out_file="$2"
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev db-export <site> [output-file]"
        echo "Known sites: $(site_domains | sed 's/\.test$//' | tr '\n' ' ')"
        return 1
    fi

    site_name="${site_arg%.test}"
    site_name="${site_name//./-}"
    config="sites/${site_name}/wp-config.php"
    if [ ! -f "$config" ]; then
        print_error "No such site: ${site_name} (checked ${config})"
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"

