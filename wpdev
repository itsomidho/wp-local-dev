# ---------------------------------------------------------------------------
# Host environment
# ---------------------------------------------------------------------------
#
# Two host-level misconfigurations that have nothing to do with this repo but
# present as "the stack is broken", both with error messages that point
# nowhere near their cause. Detected here so they get named instead of
# guessed at; see cmd_doctor (reports them) and cmd_up (repairs the first).

DOCKER_CONFIG_JSON="${DOCKER_CONFIG:-$HOME/.docker}/config.json"

# Echoes the credential helper ~/.docker/config.json asks for when that
# helper isn't actually installed; silent when the config is fine.
#
# The usual culprit is a "credsStore": "desktop" left behind by a Docker
# Desktop that's since been removed, which makes every pull die with
#   error getting credentials - err: exec: "docker-credential-desktop":
#   executable file not found in $PATH
# before it even reaches the registry -- so `wpdev up` fails on the very
# first image with a message naming neither Docker Desktop nor this file.
stale_creds_helper() {
    [ -f "$DOCKER_CONFIG_JSON" ] || return 0
    helper="$(sed -n 's/.*"credsStore"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DOCKER_CONFIG_JSON" | head -1)"
    [ -n "$helper" ] || return 0
    command -v "docker-credential-${helper}" >/dev/null 2>&1 || echo "$helper"
}

# Drops the dead credsStore key, keeping a timestamped backup. Only ever
# called on a config stale_creds_helper has already condemned: a helper that
# isn't on PATH can't be a preference worth preserving, it's just a config
# that can no longer work. Needs a JSON-aware editor -- deleting the line
# with sed would leave a trailing comma behind and turn a broken-but-valid
# config into an unparseable one -- so with neither python3 nor jq around we
# print the one-line manual edit rather than risk that.
repair_stale_creds_helper() {
    if ! command -v python3 >/dev/null 2>&1 && ! command -v jq >/dev/null 2>&1; then
        return 1
    fi
    backup="${DOCKER_CONFIG_JSON}.bak-$(date +%Y%m%d%H%M%S)"
    cp "$DOCKER_CONFIG_JSON" "$backup" || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$DOCKER_CONFIG_JSON" <<'PY' || { cp "$backup" "$DOCKER_CONFIG_JSON"; return 1; }
import json, sys
p = sys.argv[1]
with open(p) as f:
    d = json.load(f)
d.pop("credsStore", None)
with open(p, "w") as f:
    json.dump(d, f, indent="\t")
    f.write("\n")
PY
    else
        jq 'del(.credsStore)' "$backup" > "$DOCKER_CONFIG_JSON" || { cp "$backup" "$DOCKER_CONFIG_JSON"; return 1; }
    fi
    echo "$backup"
}

# Echoes "<ip> via <iface>" when the host's resolver is one containers can't
# reach; silent otherwise.
#
# With a corporate VPN connected (Cisco AnyConnect's cscotun0, WireGuard,
# plain tun0), systemd-resolved's uplink is typically a private address
# routed *through the tunnel*. Docker copies that address into every
# container's /etc/resolv.conf, but packets from a bridge network never
# enter the tunnel, so every lookup inside a container times out. `docker
# pull` keeps working the whole time -- the daemon resolves on the host --
# which is what makes this one so confusing: images download fine and then
# the build dies on "Temporary failure resolving 'deb.debian.org'", and
# anything a container fetches later (composer, npm, wp plugin install)
# hangs the same way. Fix: wpdev fix-dns.
vpn_dns_unreachable_from_containers() {
    # An explicit daemon-level override means containers are handed that
    # address instead of the host's, so the tunnel doesn't come into it.
    grep -q '"dns"' /etc/docker/daemon.json 2>/dev/null && return 0
    command -v resolvectl >/dev/null 2>&1 || return 0
    dns="$(resolvectl status 2>/dev/null | sed -n 's/.*Current DNS Server:[[:space:]]*\([0-9.]\{7,\}\).*/\1/p' | head -1)"
    [ -n "$dns" ] || return 0
    iface="$(ip route get "$dns" 2>/dev/null | sed -n 's/.*[[:space:]]dev[[:space:]]\([^[:space:]]*\).*/\1/p' | head -1)"
    case "$iface" in
        tun*|*tun[0-9]*|wg*|ppp*|utun*) echo "${dns} via ${iface}" ;;
    esac
}

# Echoes the images `docker compose up` would have to BUILD because they
# don't exist yet; silent when every build target is already present.
#
# This is what separates "container DNS is broken but it doesn't matter"
# from "container DNS is broken and nothing can possibly work": starting an
# already-built stack needs no name resolution inside a container at all, so
# a tunnel-only resolver is harmless then and `up` should not get in the
# way. A missing image, on the other hand, means a build, and a build means
# apt/npm reaching out from inside a container -- guaranteed to fail, after
# several minutes of retries, on exactly the DNS that's broken.
#
# Compose names a build target it has no explicit `image:` for after
# <project>-<service>, which is what's reconstructed here. Needs python3 to
# read compose's own resolved config; without it this stays silent and the
# caller falls back to warning rather than guessing.
pending_image_builds() {
    command -v python3 >/dev/null 2>&1 || return 0
    docker compose config --format json 2>/dev/null | python3 -c '
import json, subprocess, sys
try:
    c = json.load(sys.stdin)
except Exception:
    sys.exit(0)
project = c.get("name") or ""
for name, svc in sorted(c.get("services", {}).items()):
    if "build" not in svc:
        continue
    image = svc.get("image") or (f"{project}-{name}" if project else None)
    if not image:
        continue
    if subprocess.run(["docker", "image", "inspect", image],
                      stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        print(image)
' 2>/dev/null
}

# Echoes "<url>" when a build-time proxy is configured but nothing is
# accepting connections at it; silent when there's no proxy or it answers.
#
# Every image build inherits HTTP_PROXY (docker-compose.yml passes it as a
# build arg, from .env or the environment), and apt and npm obey it
# absolutely: with the proxy down they don't fall back to a direct
# connection, they fail. The failure surfaces several minutes in as
# "Connection refused [IP: 127.0.0.1 10808]" buried in apt output, which
# reads like a mirror problem rather than a local one. Cheap to rule out up
# front, and a local proxy (xray, v2ray, an SSH tunnel) not running yet is
# an ordinary morning.
unreachable_build_proxy() {
    proxy="${HTTP_PROXY:-${http_proxy:-}}"
    if [ -z "$proxy" ] && [ -f .env ]; then
        proxy="$(sed -n 's/^[[:space:]]*HTTP_PROXY=//p' .env | head -1)"
    fi
    [ -n "$proxy" ] || return 0

    # http://host:port/ -> host, port. Only host:port forms are checked; a
    # proxy named without a port isn't something to guess a default for.
    hostport="${proxy#*://}"
    hostport="${hostport%%/*}"
    hostport="${hostport##*@}"
    case "$hostport" in
        *:*) phost="${hostport%:*}"; pport="${hostport##*:}" ;;
        *) return 0 ;;
    esac
    case "$pport" in ''|*[!0-9]*) return 0 ;; esac

    # bash's own /dev/tcp, so this needs neither nc nor curl installed.
    if ! timeout 3 bash -c "exec 3<>/dev/tcp/${phost}/${pport}" 2>/dev/null; then
        echo "$proxy"
    fi
}

# Echoes the build proxy when one is configured and reachable but the Docker
# DAEMON has no proxy of its own; silent otherwise.
#
# Worth telling apart from a build-time proxy problem, because they cover
# different traffic and only one of them is visible in .env. Image pulls --
# every `FROM`, every `docker pull` -- are done by dockerd, which does not
# read HTTP_PROXY from your shell or from a build arg; it needs a "proxies"
# block in /etc/docker/daemon.json. On a network that throttles or resets
# Docker Hub, the result is builds whose apt and npm steps fly through the
# proxy while the base-image pulls ahead of them crawl at kilobytes a second
# and die on "connection reset by peer" from the registry CDN.
#
# Not repaired automatically: sending every registry pull on the machine
# through a personal proxy is a policy choice, not a broken setting, and
# plenty of people set HTTP_PROXY for builds alone on purpose.
daemon_missing_registry_proxy() {
    grep -q '"proxies"' /etc/docker/daemon.json 2>/dev/null && return 0
    docker info 2>/dev/null | grep -qi "HTTP Proxy" && return 0
    proxy="${HTTP_PROXY:-${http_proxy:-}}"
    if [ -z "$proxy" ] && [ -f .env ]; then
        proxy="$(sed -n 's/^[[:space:]]*HTTP_PROXY=//p' .env | head -1)"
    fi
    [ -n "$proxy" ] || return 0
    # Only when it actually answers -- a dead proxy is unreachable_build_proxy's
    # story, and reporting both about the same URL would just be noise.
    [ -z "$(unreachable_build_proxy)" ] && echo "$proxy"
}

# Echoes a one-line verdict on what a bridge-network container can actually
# reach: "" when DNS resolves, "dns" when the gateway answers but names
# don't, "offline" when it can't even reach its own default gateway.
#
# Worth distinguishing, because the third case is not a DNS problem and the
# DNS advice is actively misleading there. A container with no route to its
# gateway has no outbound connectivity at all -- every lookup, every apt
# fetch, every composer download fails identically -- and the cause is a
# host firewall or a VPN client enforcing tunnel-all against traffic whose
# source isn't the tunnel address (Cisco Secure Client's vpnagentd does
# exactly this). No amount of resolver configuration fixes that.
container_reachability() {
    image=""
    for img in redis:alpine nginx:alpine alpine:latest; do
        if docker image inspect "$img" >/dev/null 2>&1; then image="$img"; break; fi
    done
    if [ -z "$image" ]; then
        image="alpine:latest"
        docker pull -q "$image" >/dev/null 2>&1 || return 0
    fi
    docker run --rm --entrypoint sh "$image" -c '
        nslookup deb.debian.org >/dev/null 2>&1 && exit 0
        gw="$(ip route | awk "/^default/ {print \$3; exit}")"
        [ -n "$gw" ] && ping -c 1 -W 2 "$gw" >/dev/null 2>&1 && exit 2
        exit 3
    ' >/dev/null 2>&1
    case "$?" in
        0) ;;
        2) echo "dns" ;;
        *) echo "offline" ;;
    esac
}

# Make container DNS work when the host's resolver lives behind a VPN
# tunnel (see vpn_dns_unreachable_from_containers for the diagnosis).
#
# systemd-resolved is told to listen on docker0's gateway in addition to
# 127.0.0.53, and the daemon is told to hand containers that address.
# Containers then ask the host, and the host forwards over the tunnel the
# way everything else on the machine does -- so this holds whether or not
# the VPN happens to be connected, which is why it's a one-time repair and
# not something to toggle per session.
#
# Called two ways: `wpdev up` runs it automatically on any machine with the
# problem (mode "auto"), and `wpdev fix-dns` runs it on demand (mode
# "manual", which lists the changes and waits for a yes first). The repair
# itself is identical; only the consent differs. Returns nonzero if it
# couldn't finish, so `up` can stop rather than march into a doomed build.
#
# Needs root. That's consistent with the rest of this script -- `wpdev add`
# already appends to /etc/hosts with sudo mid-provision, and install-mkcert
# installs packages -- so it prompts for a password where sudo would, and
# gives up with instructions where it can't (no TTY and no cached
# credentials, i.e. CI).
#
# Set WPDEV_SKIP_DNS_FIX=1 to suppress the automatic repair entirely, for a
# machine whose container DNS is managed some other way.
fix_container_dns() {
    mode="${1:-manual}"

    if ! command -v resolvectl >/dev/null 2>&1; then
        print_fail "This repair is systemd-resolved specific and resolvectl isn't here. Point /etc/docker/daemon.json's \"dns\" at a resolver your containers can reach."
        return 1
    fi

    gateway="$(ip -4 -o addr show docker0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
    if [ -z "$gateway" ]; then
        print_fail "No docker0 interface — is Docker running?"
        return 1
    fi

    tunnel_dns="$(vpn_dns_unreachable_from_containers)"
    if [ -z "$tunnel_dns" ]; then
        [ "$mode" = "manual" ] && print_info "Nothing to repair: container DNS already works (or /etc/docker/daemon.json already sets \"dns\")."
        return 0
    fi

    # The one genuinely destructive part: `dns` isn't among the options
    # dockerd re-reads on SIGHUP, so the daemon has to restart, and that
    # stops every running container -- including ones belonging to other
    # projects entirely. Ours are fair game (this `up` is about to recreate
    # them anyway); somebody else's are not, so those get an explicit yes
    # even in auto mode.
    # Asked as "running containers that aren't ours" rather than by
    # matching a project label against a hardcoded name -- the compose
    # project name follows the directory, so anyone who clones this
    # somewhere else would silently have every container of their own
    # treated as ours. --no-trunc so these ids are comparable with the full
    # ones `docker compose ps -q` returns.
    ours="$(docker compose ps -q 2>/dev/null)" || true
    foreign=""
    for cid in $(docker ps -q --no-trunc 2>/dev/null); do
        case " $(echo $ours) " in
            *" ${cid} "*) ;;
            *) foreign="${foreign}$(docker inspect -f '{{.Name}}' "$cid" 2>/dev/null | sed 's|^/||')
" ;;
        esac
    done
    foreign="$(echo "$foreign" | grep -v '^$')" || true

    if [ "$mode" = "manual" ] || [ -n "$foreign" ]; then
        print_warning "Host DNS is ${tunnel_dns}, which containers can't reach."
        echo "This will, with sudo:"
        echo "  1. have systemd-resolved listen on ${gateway} as well as 127.0.0.53"
        echo "  2. set \"dns\": [\"${gateway}\"] in /etc/docker/daemon.json (backed up first)"
        echo "  3. allow port 53 from 172.16.0.0/12 to ${gateway}, if ufw is active"
        echo "  4. restart systemd-resolved and docker"
        if [ -n "$foreign" ]; then
            echo ""
            print_warning "Restarting docker will stop these containers, which aren't part of this stack:"
            echo "$foreign" | sed 's/^/    /'
        fi
        echo ""
        if [ ! -t 0 ]; then
            print_fail "Needs confirmation but there's no terminal to ask on. Run 'wpdev fix-dns' interactively, or set WPDEV_SKIP_DNS_FIX=1 to skip."
            return 1
        fi
        read -r -p "Proceed? [y/N] " confirm
        case "$confirm" in [yY]*) ;; *) echo "Aborted."; return 1 ;; esac
    else
        print_warning "Host DNS is ${tunnel_dns} — not reachable from inside a container. Repairing (needs sudo)..."
    fi

    if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
        print_fail "Needs sudo, with no cached credentials and no terminal to prompt on. Run 'wpdev fix-dns' interactively first, or set WPDEV_SKIP_DNS_FIX=1."
        return 1
    fi

    sudo install -d /etc/systemd/resolved.conf.d || return 1
    printf '[Resolve]\nDNSStubListenerExtra=%s\n' "$gateway" | sudo tee /etc/systemd/resolved.conf.d/docker.conf >/dev/null || return 1
    print_info "Wrote /etc/systemd/resolved.conf.d/docker.conf"

    sudo install -d /etc/docker || return 1
    if [ -f /etc/docker/daemon.json ]; then
        sudo cp /etc/docker/daemon.json "/etc/docker/daemon.json.bak-$(date +%Y%m%d%H%M%S)" || return 1
        # Merged, not overwritten: daemon.json routinely carries unrelated
        # settings (registry mirrors, log limits, proxies) that have to
        # survive this.
        sudo python3 - "$gateway" <<'PY' || return 1
import json, sys
p = "/etc/docker/daemon.json"
with open(p) as f:
    d = json.load(f)
d["dns"] = [sys.argv[1]]
with open(p, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
PY
    else
        printf '{\n  "dns": ["%s"]\n}\n' "$gateway" | sudo tee /etc/docker/daemon.json >/dev/null || return 1
    fi
    print_info "Set \"dns\": [\"${gateway}\"] in /etc/docker/daemon.json"

    # ufw defaults to deny-incoming, and these queries arrive at the host on
    # the bridge gateway. Every docker bridge sits inside 172.16.0.0/12
    # (docker0 plus whatever subnets compose allocates), so one pair of
    # rules covers the networks that exist now and any added later.
    if command -v ufw >/dev/null 2>&1 && sudo ufw status 2>/dev/null | grep -q "^Status: active"; then
        sudo ufw allow from 172.16.0.0/12 to "$gateway" port 53 proto udp >/dev/null
        sudo ufw allow from 172.16.0.0/12 to "$gateway" port 53 proto tcp >/dev/null
        print_info "Opened port 53 from 172.16.0.0/12 to ${gateway} (ufw)"
    fi

    sudo systemctl restart systemd-resolved || return 1
    sudo systemctl restart docker || return 1
    print_info "Restarted systemd-resolved and docker"

    # The daemon needs a moment to accept connections again; without this
    # wait the probe below -- and, in auto mode, the `docker compose up`
    # right after it -- can race the restart and fail on a closed socket.
    for _ in $(seq 1 30); do
        docker info >/dev/null 2>&1 && break
        sleep 1
    done

    if ss -lnu 2>/dev/null | grep -q "${gateway}:53"; then
        print_info "systemd-resolved is listening on ${gateway}:53"
    else
        print_warning "systemd-resolved doesn't appear to be listening on ${gateway}:53 — check: resolvectl status"
    fi

    case "$(container_reachability)" in
        "")
            print_info "Container DNS works"
            return 0
            ;;
        offline)
            # The resolver config is now correct and irrelevant: nothing
            # outbound works from a bridge network, so say that plainly
            # instead of sending someone back to look at DNS again.
            print_fail "Containers have no outbound connectivity at all — a bridge-network container can't even reach its own gateway, so this isn't a DNS problem and the change just made won't help on its own."
            echo "  Likely a host firewall or a VPN client enforcing tunnel-all against traffic sourced from 172.16.0.0/12."
            if pgrep -x vpnagentd >/dev/null 2>&1; then
                echo "  Cisco Secure Client (vpnagentd) is running — the quickest way to confirm is to disconnect it and re-run 'wpdev doctor'."
            fi
            echo "  Check: sudo ufw status verbose; sudo iptables -t filter -L -n -v"
            return 1
            ;;
        *)
            print_fail "Container DNS still failing, though the gateway is reachable. Check 'sudo ufw status' and 'resolvectl status', then re-run 'wpdev doctor'."
            return 1
            ;;
    esac
}

cmd_fix_dns() { fix_container_dns manual; }

# ---------------------------------------------------------------------------
# Stack lifecycle
# ---------------------------------------------------------------------------

# Sets (or updates) one KEY=value line in .env, in place. Used by cmd_up to
# keep a handful of host-specific, auto-detected values in sync -- these are
# real host facts (this directory's path, this user's uid/gid, the Docker
# socket's gid), not preferences, so autodetecting and overwriting on every
# `wpdev up` is correct, not just convenient: a value hardcoded once in
# .env.example would be right on exactly one machine and silently wrong
# (wrong uid, wrong docker gid) on every other one, CI included.
set_env_var() {
    key="$1"
    value="$2"
    if grep -q "^${key}=" .env; then
        sed -i "s|^${key}=.*|${key}=${value}|" .env
    else
        echo "${key}=${value}" >> .env
    fi
}

cmd_up() {
    require_stack_services
    # Host config that would otherwise fail mid-pull or mid-build with a
    # message pointing nowhere near its cause. The credential one is
    # repaired in place (no sudo, nothing lost -- see
    # repair_stale_creds_helper); the DNS one needs root and a daemon
    # restart, so it's reported and left to an explicit `wpdev fix-dns`
    # rather than done behind your back halfway through bringing the
    # stack up.
    helper="$(stale_creds_helper)"
    if [ -n "$helper" ]; then
        print_warning "~/.docker/config.json wants credential helper 'docker-credential-${helper}', which isn't installed — every image pull would fail before reaching the registry."
        if backup="$(repair_stale_creds_helper)"; then
            print_info "Removed the dead \"credsStore\": \"${helper}\" (backup: ${backup})"
        else
            print_error "Couldn't edit it automatically (needs python3 or jq). Remove the \"credsStore\" line from ${DOCKER_CONFIG_JSON} by hand, then re-run."
        fi
    fi

    # Repaired here, not merely reported: a resolver containers can't reach
    # makes every image build fail (apt and npm run inside a container) and
    # bakes the dead address into the /etc/resolv.conf of every container
    # this `up` is about to create. Reporting it would just hand back a
    # 150-second build failure whose real cause has scrolled off the top of
    # a 70-step log. `up` is the right moment for the repair too: the daemon
    # restart it needs is cheapest before the stack is running, and `up` is
    # the command people actually run.
    # Before the DNS work, because a dead proxy breaks builds regardless of
    # how well DNS resolves, and it's a one-connect check.
    dead_proxy="$(unreachable_build_proxy)"
    if [ -n "$dead_proxy" ] && [ -n "$(pending_image_builds)" ]; then
        print_warning "A build proxy is configured (${dead_proxy}) but nothing is listening there."
        echo "  Every build inherits it as HTTP_PROXY, and apt and npm won't fall back to a direct connection — they'll fail several minutes in."
        print_error "Start the proxy, or unset HTTP_PROXY/HTTPS_PROXY (shell environment and .env) to build directly, then re-run."
    fi

    if [ -z "${WPDEV_SKIP_DNS_FIX:-}" ]; then
        if [ -n "$(vpn_dns_unreachable_from_containers)" ]; then
            # Config-only check, so it's cheap enough to run every time --
            # and worth acting on even with nothing to build, because every
            # container this `up` creates would otherwise bake the dead
            # resolver into its own /etc/resolv.conf.
            pending="$(pending_image_builds)"
            if [ -n "$pending" ]; then
                echo "These images still need building, and every build fetches packages from inside a container:"
                echo "$pending" | sed 's/^/    /'
            fi
            if ! fix_container_dns auto; then
                print_error "Couldn't repair container DNS — builds and in-container downloads would fail. Fix it and re-run, or set WPDEV_SKIP_DNS_FIX=1 to proceed anyway."
            fi
        else
            # The resolver is configured correctly, which is not the same as
            # containers being able to use it: a host firewall or a VPN
            # enforcing tunnel-all can still drop everything they send. That
            # takes an actual container to detect, so it's only paid for when
            # something needs building -- a build is what needs container
            # networking, and a plain `up` with every image present doesn't
            # deserve the extra few seconds.
            pending="$(pending_image_builds)"
            if [ -n "$pending" ]; then
                case "$(container_reachability)" in
                    offline)
                        # Warned about, not refused. Every build here uses
                        # `network: host`, so a build is immune to this --
                        # it resolves and fetches in the host's namespace,
                        # not a bridge. Blocking would be the wrong call
                        # twice over: it stops work that would have
                        # succeeded, and the stack it refuses to start is
                        # perfectly usable for serving sites locally, since
                        # nginx, php and mysql only ever talk to each other.
                        print_warning "Containers have no outbound connectivity — a bridge-network container can't reach its own gateway."
                        echo "  Builds are unaffected (they use the host network namespace), and the stack will serve sites fine."
                        echo "  What won't work is anything a running container fetches: wp plugin install, composer, plugin updates from wp-admin."
                        echo "  Not a DNS problem: a host firewall, or a VPN enforcing tunnel-all against 172.16.0.0/12, is dropping it."
                        if pgrep -x vpnagentd >/dev/null 2>&1; then
                            echo "  Cisco Secure Client (vpnagentd) is running — its chains sit above ufw's in INPUT, so no local Docker or ufw setting overrides them. Disconnecting is the quickest confirmation."
                        fi
                        ;;
                    dns)
                        print_warning "Containers can reach the network but can't resolve names. Builds are unaffected (host network namespace), but anything a running container fetches will fail. Check 'resolvectl status' and /etc/docker/daemon.json's \"dns\"."
                        ;;
                esac
            fi
        fi
    fi

    # Group-writable so www-data (PHP-FPM, inside every phpXX container) can
    # create its own top-level dirs here too -- e.g. wp-cli's cache dir
    # (/var/www/.wp-cli), which it otherwise warns about (non-fatal, just
    # slower repeat downloads) every time a plugin install runs as www-data
    # instead of root. A fresh git checkout gets ./sites at whatever mode
    # the checkout's umask produced, so this can't just be committed once.
    chmod g+w sites 2>/dev/null || true

    # Auto-detected values the `api` service (docker-compose.yml) needs --
    # see that file's comments for why each one matters. Keyed off real
    # facts about THIS machine (SCRIPT_DIR, `id -u`/`id -g`, the Docker
    # socket's actual gid), not $PWD or a guess, so this is correct
    # regardless of where `wpdev up` is invoked from and self-heals if any
    # of them ever change (this directory moves, docker.sock's gid differs
    # after a Docker reinstall, etc.).
    if [ -f .env ]; then
        set_env_var PROJECT_DIR "${SCRIPT_DIR}"
        set_env_var API_UID "$(id -u)"
        set_env_var API_GID "$(id -g)"
        docker_gid="$(stat -c '%g' /var/run/docker.sock 2>/dev/null)" || true
        [ -n "$docker_gid" ] && set_env_var DOCKER_GID "$docker_gid"

        # What the dashboard shows as its own version -- nearest tag plus
        # commits-since-and-hash (git describe), not a hand-maintained
        # version file that drifts the moment someone forgets to bump it.
        # `--always` falls back to a bare short hash if this checkout has
        # no tags reachable at all; `|| echo unknown` only fires if git
        # itself fails outright (e.g. .git missing from a tarball install).
        app_version="$(git -C "${SCRIPT_DIR}" describe --tags --always --dirty 2>/dev/null)" || app_version="unknown"
        set_env_var APP_VERSION "$app_version"

        # Share the host's (browser-trusted) mkcert CA with the api
        # container, so sites created from the dashboard get trusted certs
        # too -- otherwise it issues them from a private CA of its own.
        # Only fills an empty value, never overrides one you set; and never
        # from inside the api, where `mkcert -CAROOT` is the container's own
        # /mkcert-ca, not a host path. (#10)
        if [ -z "${WPDEV_IN_API:-}" ] && [ -z "$(sed -n 's/^MKCERT_CAROOT=//p' .env | tail -1)" ]; then
            host_caroot="$(mkcert_caroot)"
            if [ -n "$host_caroot" ]; then
                if grep -q '^#[[:space:]]*MKCERT_CAROOT=' .env; then
                    sed -i "0,/^#[[:space:]]*MKCERT_CAROOT=.*/s||MKCERT_CAROOT=${host_caroot}|" .env
                else
                    set_env_var MKCERT_CAROOT "$host_caroot"
                fi
                print_info "Set MKCERT_CAROOT=${host_caroot} in .env, so the dashboard issues browser-trusted certs"
            fi
        fi
    fi

    # Only ones that never started ("created"): a renamed container that's
    # still running or stopping belongs to a recreate in progress right now.
    stale="$(recreate_leftovers | awk '$2 == "created" {print $1}')"
    if [ -n "$stale" ]; then
        # shellcheck disable=SC2086
        docker rm $stale >/dev/null
        print_info "Removed container(s) left by an interrupted recreate: $(echo $stale)"
    fi

    docker compose up -d $(stack_services)
    warn_if_api_stale
    echo "Containers started. Give MySQL 30 seconds to initialize if this is the first run."
}

# Run from the dashboard, these commands execute inside the api container
# itself (docker-compose.yml sets WPDEV_IN_API there), and any compose
# command that stops or recreates wp-api kills the very process running it.
# Found live: `up` after a `git pull` changed APP_VERSION in .env, which
# wp-api loads via env_file, so compose recreated it -- the old container
# was SIGKILLed mid-recreate and the replacement was left "Created" under a
# hash-prefixed name, never started. So from in there, every service but
# api is named explicitly, and api is only ever (re)created by a `wpdev up`
# run on the host. Empty output outside the api means "all services".
#
# Fails closed: inside the api, an empty list would make every caller fall
# back to "all services" -- api included -- so it's an error instead. And
# since callers use it unquoted inside $(...), where a failure can't stop
# them under set -e, they must call require_stack_services first.
stack_services() {
    [ -n "${WPDEV_IN_API:-}" ] || return 0
    docker compose config --services 2>/dev/null | grep -vx api || true
}
require_stack_services() {
    [ -n "${WPDEV_IN_API:-}" ] || return 0
    [ -n "$(stack_services)" ] || print_error "Couldn't list the compose services (docker compose config failed), so this can't safely leave the api container out. Run it on the host instead."
}

# After an in-api `up`/`update`, say so if api itself is now stale -- its
# compose config hash differs from the running container's, i.e. a host
# `up` would recreate it -- rather than leaving it silently unapplied.
warn_if_api_stale() {
    [ -n "${WPDEV_IN_API:-}" ] || return 0
    want="$(docker compose config --hash api 2>/dev/null | awk '{print $2}')"
    have="$(docker inspect wp-api --format '{{index .Config.Labels "com.docker.compose.config-hash"}}' 2>/dev/null)"
    if [ -n "$want" ] && [ "$want" != "$have" ]; then
        print_warning "The api service's own config changed, but it can't recreate itself from the dashboard. Run ./wpdev up on the host to apply it."
    fi
}

cmd_down() {
    require_stack_services
    if [ -n "${WPDEV_IN_API:-}" ]; then
        # `down` takes no service list; stop+rm is its per-service form.
        # api stays up so the dashboard can still bring the stack back.
        docker compose stop $(stack_services)
        docker compose rm -f $(stack_services)
    else
        docker compose down
    fi
}
cmd_restart() { require_stack_services; docker compose restart $(stack_services); }

# Pull the latest wp-local-dev, then rebuild + fully recreate every
# container. The rebuild picks up Dockerfile changes (anything baked into
# the image, like php/crontab); --force-recreate is there because a plain
# `up -d` only restarts a container whose *compose service config* changed
# -- it has no way to know a bind-mounted file's *content* changed (e.g.
# nginx.conf, php/xdebug.ini), so without this, a pulled config fix can
# silently sit on disk unapplied until something else happens to restart
# that container. Discovered the hard way this session with exactly that
# class of bug (a stale bind mount after an in-place file edit).
cmd_update() {
    require_stack_services
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || print_error "Not a git checkout -- can't update. Re-clone from https://github.com/itsomidho/wp-local-dev."

    if [ -n "$(git status --porcelain)" ]; then
        print_error "You have uncommitted changes -- commit or stash them first, then run 'wpdev update' again."
    fi

    print_info "Fetching origin..."
    git fetch origin

    local_rev="$(git rev-parse HEAD)"
    if ! remote_rev="$(git rev-parse '@{u}' 2>/dev/null)"; then
        # install.sh clones with --depth 1, which is single-branch too:
        # remote.origin.fetch covers main alone, so no other branch has a
        # remote-tracking ref for @{u} to resolve -- not even one `git push
        # -u` has already written tracking config for. Git's own wording for
        # this is "no upstream configured", which sends you to
        # --set-upstream-to, and that doesn't help: the upstream is set, the
        # remote-tracking ref is what's missing.
        cur_branch="$(git rev-parse --abbrev-ref HEAD)"
        if ! git config --get-all remote.origin.fetch | grep -q 'refs/heads/\*'; then
            print_error "On branch '${cur_branch}', but this is a single-branch clone that only tracks main, so there's nothing here to update from. Either switch back: git checkout main && wpdev update — or widen the clone: git remote set-branches origin '*' && git fetch origin"
        fi
        print_error "Current branch has no upstream configured (git branch --set-upstream-to=origin/<branch>)."
    fi

    if [ "$local_rev" = "$remote_rev" ]; then
        print_info "Already up to date."
        return
    fi

    # --ff-only: never auto-merge or rewrite local commits. If history has
    # diverged, this fails loudly instead of guessing what you want.
    if ! git pull --ff-only; then
        print_error "Can't fast-forward -- your branch has local commits origin doesn't have. Resolve manually (e.g. git rebase origin/main), then run 'wpdev update' again."
    fi

    echo
    echo "Updated:"
    git log --oneline "${local_rev}..HEAD"
    echo

    print_info "Rebuilding images and recreating containers to apply changes..."
    docker compose build $(stack_services)
    docker compose up -d --force-recreate $(stack_services)
    warn_if_api_stale
    print_info "Update complete."
}

# Read-only counterpart to cmd_update -- fetches and reports whether
# there's anything to pull, without touching the working tree or any
# container. Exit code is the signal a caller (the dashboard, via the api
# service) actually needs: 0 up to date, 2 update available, 1 a real
# error (no git checkout, no upstream, fetch failed) -- distinct from 0/2
# so neither can be mistaken for the other on a network hiccup.
cmd_update_check() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || print_error "Not a git checkout -- can't check for updates. Re-clone from https://github.com/itsomidho/wp-local-dev."

    git fetch origin --quiet || print_error "git fetch failed -- check network connectivity."

    remote_rev="$(git rev-parse '@{u}' 2>/dev/null)" || print_error "Current branch has no upstream configured (git branch --set-upstream-to=origin/<branch>)."
    current_version="$(git describe --tags --always --dirty 2>/dev/null)" || current_version="unknown"

    # Commits reachable from upstream but not HEAD -- not a plain
    # local-rev-vs-remote-rev equality check, which would wrongly call a
    # checkout that's ahead of (or diverged from) origin "update available"
    # too. This is also the exact question `wpdev update`'s `pull --ff-only`
    # answers by actually pulling -- this just asks it without doing it.
    behind="$(git rev-list --count "HEAD..${remote_rev}")"

    if [ "$behind" -eq 0 ]; then
        echo "Up to date (${current_version})."
        exit 0
    fi

    latest_version="$(git describe --tags --always "$remote_rev" 2>/dev/null)" || latest_version="$remote_rev"
    echo "Update available: ${latest_version} (currently ${current_version}, ${behind} commit(s) behind)."
    exit 2
}
cmd_status() {
    docker compose ps
    echo ""
    print_header "=== Sites ==="

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        echo "No sites configured yet. Run: wpdev add"
        return
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi

    # `cmd && var=1` here would abort this whole command under `set -e` if
    # the container is transiently unreachable — a status dashboard must
    # never die on the thing it's trying to report as down.
    mysql_up=0
    if docker compose exec -T mysql true </dev/null >/dev/null 2>&1; then mysql_up=1; fi

    # One shared MySQL server for every site, so its version is the same on
    # every row -- fetched once here rather than once per site in the loop.
    mysql_version="n/a"
    if [ "$mysql_up" -eq 1 ] && [ -n "${DB_ROOT_PASSWORD:-}" ]; then
        mysql_version="$(docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -N -e "SELECT VERSION();" </dev/null 2>/dev/null | tr -d '[:space:]')"
        [ -z "$mysql_version" ] && mysql_version="n/a"
    fi

    printf "%-28s %-6s %-9s %-9s %-6s %-10s %s\n" "DOMAIN" "PHP" "WP" "MYSQL" "HTTP" "DATABASE" "CACHE"
    for domain in $domains; do
        site_name="${domain%.test}"
        site_name="${site_name//./-}"
        config="sites/${site_name}/wp-config.php"
        # || true: set -e gotcha -- cat on a missing .php-version (any site
        # that predates multi-PHP support) exits nonzero even with stderr
        # silenced, and this bare assignment isn't exempt the way
        # `cmd1 && cmd2` is. Confirmed live: without this, ONE site missing
        # the marker file silently killed status reporting for every site,
        # not just itself, since it died mid-loop.
        php_version="$(cat "sites/${site_name}/.php-version" 2>/dev/null)" || true
        [ -z "$php_version" ] && php_version="$DEFAULT_PHP_VERSION"
        php_svc="$(php_slug "$php_version")"

        http_code="$(site_http_code "$domain")"

        db_status="n/a"
        if [ -f "$config" ] && [ "$mysql_up" -eq 1 ] && [ -n "${DB_ROOT_PASSWORD:-}" ]; then
            db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
            if docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "USE \`${db_name}\`;" </dev/null >/dev/null 2>&1; then
                db_status="OK"
            else
                db_status="FAIL"
            fi
        elif [ "$mysql_up" -ne 1 ]; then
            db_status="down"
        fi

        php_reachable=0
        if [ -f "$config" ] && docker compose exec -T "$php_svc" true </dev/null >/dev/null 2>&1; then
            php_reachable=1
        fi

        cache_status="n/a"
        if [ "$php_reachable" -eq 1 ]; then
            cache_status="$(docker compose exec -T "$php_svc" wp redis status --path="/var/www/${site_name}" --allow-root </dev/null 2>/dev/null | grep "^Status:" | awk '{print $2}')"
            [ -z "$cache_status" ] && cache_status="off"
        fi

        wp_version="n/a"
        if [ "$php_reachable" -eq 1 ]; then
            wp_version="$(docker compose exec -T "$php_svc" wp core version --path="/var/www/${site_name}" --allow-root </dev/null 2>/dev/null)"
            [ -z "$wp_version" ] && wp_version="n/a"
        fi

        printf "%-28s %-6s %-9s %-9s %-6s %-10s %s\n" "$domain" "$php_version" "$wp_version" "$mysql_version" "$http_code" "$db_status" "$cache_status"
    done
}

cmd_doctor() {
    warnings=0
    fails=0

    print_header "=== Stack ==="

    if docker info >/dev/null 2>&1; then
        print_info "Docker daemon is reachable"
    else
        print_fail "Docker daemon is not reachable — is Docker running?"
        fails=$((fails + 1))
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
        if [ -n "${DB_ROOT_PASSWORD:-}" ]; then
            print_info ".env exists, DB_ROOT_PASSWORD is set"
        else
            print_fail ".env exists but DB_ROOT_PASSWORD is empty"
            fails=$((fails + 1))
        fi
    else
        print_warning ".env doesn't exist yet — created automatically on next 'wpdev add', or copy .env.example yourself"
        warnings=$((warnings + 1))
    fi

    expected_containers="wp-mysql wp-redis wp-mailpit wp-nginx wp-adminer wp-portainer wp-api wp-dashboard"
    for v in $SUPPORTED_PHP_VERSIONS; do
        expected_containers="$expected_containers wp-$(php_slug "$v")"
    done
    for c in $expected_containers; do
        # || true: docker inspect exits nonzero for a container that doesn't
        # exist at all (e.g. adminer/portainer, which `wpdev add` never
        # starts) -- a bare assignment like this one is NOT exempt from
        # set -e the way `cmd1 && cmd2` is, so without this the whole
        # script aborts right here instead of reaching the `-z "$state"`
        # branch below that's meant to handle exactly this case.
        state="$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null)" || true
        if [ "$state" = "running" ]; then
            print_info "${c} is running"
        elif [ -z "$state" ]; then
            print_warning "${c} doesn't exist yet — run: wpdev up"
            warnings=$((warnings + 1))
        else
            print_fail "${c} exists but isn't running (state: ${state}) — check: docker logs ${c}"
            fails=$((fails + 1))
        fi
    done

    orphans="$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep '^wp-' | grep -vFx -f <(echo "$expected_containers" | tr ' ' '\n') || true)"
    if [ -n "$orphans" ]; then
        print_warning "Orphaned wp-* containers not in the current stack (leftover from a renamed/removed service):"
        echo "$orphans" | sed 's/^/    /'
        echo "    Remove with: docker rm -f <name>"
        warnings=$((warnings + 1))
    else
        print_info "No orphaned containers"
    fi

    leftovers="$(recreate_leftovers)"
    if [ -n "$leftovers" ]; then
        print_warning "Containers left behind by an interrupted recreate (compose's <id>_<name> temporaries):"
        echo "$leftovers" | sed 's/^/    /'
        echo "    Remove with: docker rm -f $(echo "$leftovers" | awk '{print $1}' | tr '\n' ' ')(wpdev up removes never-started ones itself)"
        warnings=$((warnings + 1))
    fi

    if command -v mkcert >/dev/null 2>&1; then
        # || true: same set -e gotcha as elsewhere -- mkcert -CAROOT failing
        # (unlikely, but possible if mkcert is installed yet not fully
        # functional) shouldn't silently abort the rest of doctor's checks.
        caroot="$(mkcert -CAROOT 2>/dev/null)" || true
        if [ -f "${caroot}/rootCA.pem" ]; then
            print_info "mkcert local CA exists (${caroot})"
        else
            print_warning "mkcert is installed but no local CA found — run: wpdev install-mkcert"
            warnings=$((warnings + 1))
        fi
    else
        print_warning "mkcert isn't installed — run: wpdev install-mkcert"
        warnings=$((warnings + 1))
    fi

    if [ -d docker ]; then
        print_warning "Stray docker/ directory at the repo root (unused, likely leftover from a past mistake) — remove with: sudo rm -rf docker/"
        warnings=$((warnings + 1))
    fi

    du_sites="$(du -sh sites 2>/dev/null | cut -f1)"
    [ -n "$du_sites" ] && echo "  Disk: sites/ = ${du_sites:-0}"

    echo ""
    print_header "=== Host environment ==="

    helper="$(stale_creds_helper)"
    if [ -n "$helper" ]; then
        print_fail "~/.docker/config.json asks for 'docker-credential-${helper}', which isn't installed — image pulls fail before reaching the registry. 'wpdev up' repairs this for you, or drop the \"credsStore\" line from ${DOCKER_CONFIG_JSON}"
        fails=$((fails + 1))
    else
        print_info "Docker credential config is usable"
    fi

    dead_proxy="$(unreachable_build_proxy)"
    if [ -n "$dead_proxy" ]; then
        print_fail "Build proxy ${dead_proxy} is configured but not accepting connections — image builds inherit it as HTTP_PROXY and will fail rather than connect directly. Start it, or unset HTTP_PROXY/HTTPS_PROXY."
        fails=$((fails + 1))
    else
        print_info "No dead build proxy in the way"
    fi

    reg_proxy="$(daemon_missing_registry_proxy)"
    if [ -n "$reg_proxy" ]; then
        print_warning "Builds use proxy ${reg_proxy}, but the Docker daemon has none — so image pulls (every FROM) go direct. On a network that throttles Docker Hub that shows up as very slow pulls and \"connection reset by peer\". Add a \"proxies\" block to /etc/docker/daemon.json to route pulls through it too."
        warnings=$((warnings + 1))
    fi

    # Asked in this order deliberately: a container with no outbound route
    # at all would also fail every DNS check, and reporting that as a
    # resolver problem sends you off to fix the wrong thing.
    case "$(container_reachability)" in
        offline)
            print_fail "Containers have no outbound connectivity — a bridge-network container can't reach its own gateway. Not a DNS problem: look at the host firewall, or a VPN client enforcing tunnel-all against 172.16.0.0/12."
            if pgrep -x vpnagentd >/dev/null 2>&1; then
                echo "    Cisco Secure Client (vpnagentd) is running — disconnect it and re-run this to confirm."
            fi
            fails=$((fails + 1))
            ;;
        dns)
            tunnel_dns="$(vpn_dns_unreachable_from_containers)"
            if [ -n "$tunnel_dns" ]; then
                print_fail "Host DNS is ${tunnel_dns} — a VPN resolver containers can't route to, so builds and in-container downloads time out while 'docker pull' still works. 'wpdev up' repairs this automatically, or run it now: wpdev fix-dns"
            else
                print_fail "Containers can reach the network but can't resolve names — check 'resolvectl status' and /etc/docker/daemon.json's \"dns\""
            fi
            fails=$((fails + 1))
            ;;
        *)
            print_info "Containers can resolve names and reach the network"
            ;;
    esac

    echo ""
    print_header "=== Sites ==="

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        echo "No sites configured yet. Run: wpdev add"
    else
        if [ -f .env ]; then
            set -a
            # shellcheck disable=SC1091
            source .env
            set +a
        fi
        mysql_up=0
        if docker compose exec -T mysql true </dev/null >/dev/null 2>&1; then mysql_up=1; fi

        for domain in $domains; do
            site_name="${domain%.test}"
            site_name="${site_name//./-}"
            config="sites/${site_name}/wp-config.php"

            echo "${domain}:"

            if grep -q "[[:space:]]${domain}$" /etc/hosts 2>/dev/null || grep -q "[[:space:]]${domain}[[:space:]]" /etc/hosts 2>/dev/null; then
                print_info "  /etc/hosts entry present"
            else
                print_warning "  Missing /etc/hosts entry — run: wpdev hosts"
                warnings=$((warnings + 1))
            fi

            if [ -f "nginx/ssl/certs/${domain}.pem" ] && [ -f "nginx/ssl/private/${domain}-key.pem" ]; then
                problem="$(cert_problem "$domain")"
                if [ -z "$problem" ]; then
                    print_info "  SSL certificate present"
                else
                    print_warning "  SSL certificate ${problem} — run: wpdev cert ${site_name}"
                    warnings=$((warnings + 1))
                fi
            else
                print_fail "  Missing SSL certificate — run: wpdev add (skips steps that already exist)"
                fails=$((fails + 1))
            fi

            if [ ! -f "$config" ]; then
                print_fail "  No wp-config.php (checked ${config})"
                fails=$((fails + 1))
                continue
            fi

            if [ "$mysql_up" -ne 1 ]; then
                print_warning "  Can't check database — MySQL isn't running"
                warnings=$((warnings + 1))
                continue
            fi

            db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
            # COUNT(*) alone can't tell "schema doesn't exist" from "schema
            # exists but is empty" — both return 0. Check existence first
            # (this is exactly the class of bug that caused the wp-lab
            # incident: a wp-config.php pointing at a database that silently
            # isn't there).
            db_exists="$(docker compose exec -T mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" -N -e "SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name='${db_name}';" </dev/null 2>/dev/null | tr -d '[:space:]')"
            if [ "$db_exists" != "1" ]; then
                print_fail "  Database '${db_name}' (from wp-config.php) doesn't exist"
                fails=$((fails + 1))
            else
                table_count="$(docker compose exec -T mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${db_name}';" </dev/null 2>/dev/null | tr -d '[:space:]')"
                if [ "${table_count:-0}" -eq 0 ]; then
                    print_warning "  Database '${db_name}' exists but has 0 tables — looks unprovisioned or broken"
                    warnings=$((warnings + 1))
                else
                    print_info "  Database '${db_name}' OK (${table_count} tables)"
                fi
            fi
        done
    fi

    echo ""
    if [ "$fails" -eq 0 ] && [ "$warnings" -eq 0 ]; then
        print_info "Everything checks out."
    else
        print_header "=== Summary ==="
        [ "$fails" -gt 0 ] && print_fail "${fails} thing(s) need fixing"
        [ "$warnings" -gt 0 ] && print_warning "${warnings} thing(s) worth a look"
    fi
}

