# ---------------------------------------------------------------------------
# Host environment
# ---------------------------------------------------------------------------
#
# Two host-level misconfigurations that have nothing to do with this repo but
# present as "the stack is broken", both with error messages that point
# nowhere near their cause. Detected here so they get named instead of
# guessed at; see cmd_doctor (reports them) and cmd_up (repairs the first).

DOCKER_CONFIG_JSON="${DOCKER_CONFIG:-$HOME/.docker}/config.json"

# Echoes the credential helper ~/.docker/config.json asks for when that
# helper isn't actually installed; silent when the config is fine.
#
# The usual culprit is a "credsStore": "desktop" left behind by a Docker
# Desktop that's since been removed, which makes every pull die with
#   error getting credentials - err: exec: "docker-credential-desktop":
#   executable file not found in $PATH
# before it even reaches the registry -- so `wpdev up` fails on the very
# first image with a message naming neither Docker Desktop nor this file.
stale_creds_helper() {
    [ -f "$DOCKER_CONFIG_JSON" ] || return 0
    helper="$(sed -n 's/.*"credsStore"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DOCKER_CONFIG_JSON" | head -1)"
    [ -n "$helper" ] || return 0
    command -v "docker-credential-${helper}" >/dev/null 2>&1 || echo "$helper"
}

# Drops the dead credsStore key, keeping a timestamped backup. Only ever
# called on a config stale_creds_helper has already condemned: a helper that
# isn't on PATH can't be a preference worth preserving, it's just a config
# that can no longer work. Needs a JSON-aware editor -- deleting the line
# with sed would leave a trailing comma behind and turn a broken-but-valid
# config into an unparseable one -- so with neither python3 nor jq around we
# print the one-line manual edit rather than risk that.
repair_stale_creds_helper() {
    if ! command -v python3 >/dev/null 2>&1 && ! command -v jq >/dev/null 2>&1; then
        return 1
    fi
    backup="${DOCKER_CONFIG_JSON}.bak-$(date +%Y%m%d%H%M%S)"
    cp "$DOCKER_CONFIG_JSON" "$backup" || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$DOCKER_CONFIG_JSON" <<'PY' || { cp "$backup" "$DOCKER_CONFIG_JSON"; return 1; }
import json, sys
p = sys.argv[1]
with open(p) as f:
    d = json.load(f)
d.pop("credsStore", None)
with open(p, "w") as f:
    json.dump(d, f, indent="\t")
    f.write("\n")
PY
    else
        jq 'del(.credsStore)' "$backup" > "$DOCKER_CONFIG_JSON" || { cp "$backup" "$DOCKER_CONFIG_JSON"; return 1; }
    fi
    echo "$backup"
}

# Echoes "<ip> via <iface>" when the host's resolver is one containers can't
# reach; silent otherwise.
#
# With a corporate VPN connected (Cisco AnyConnect's cscotun0, WireGuard,
# plain tun0), systemd-resolved's uplink is typically a private address
# routed *through the tunnel*. Docker copies that address into every
# container's /etc/resolv.conf, but packets from a bridge network never
# enter the tunnel, so every lookup inside a container times out. `docker
# pull` keeps working the whole time -- the daemon resolves on the host --
# which is what makes this one so confusing: images download fine and then
# the build dies on "Temporary failure resolving 'deb.debian.org'", and
# anything a container fetches later (composer, npm, wp plugin install)
# hangs the same way. Fix: wpdev fix-dns.
vpn_dns_unreachable_from_containers() {
    # An explicit daemon-level override means containers are handed that
    # address instead of the host's, so the tunnel doesn't come into it.
    grep -q '"dns"' /etc/docker/daemon.json 2>/dev/null && return 0
    command -v resolvectl >/dev/null 2>&1 || return 0
    dns="$(resolvectl status 2>/dev/null | sed -n 's/.*Current DNS Server:[[:space:]]*\([0-9.]\{7,\}\).*/\1/p' | head -1)"
    [ -n "$dns" ] || return 0
    iface="$(ip route get "$dns" 2>/dev/null | sed -n 's/.*[[:space:]]dev[[:space:]]\([^[:space:]]*\).*/\1/p' | head -1)"
    case "$iface" in
        tun*|*tun[0-9]*|wg*|ppp*|utun*) echo "${dns} via ${iface}" ;;
    esac
}

# Echoes the images `docker compose up` would have to BUILD because they
# don't exist yet; silent when every build target is already present.
#
# This is what separates "container DNS is broken but it doesn't matter"
# from "container DNS is broken and nothing can possibly work": starting an
# already-built stack needs no name resolution inside a container at all, so
# a tunnel-only resolver is harmless then and `up` should not get in the
# way. A missing image, on the other hand, means a build, and a build means
# apt/npm reaching out from inside a container -- guaranteed to fail, after
# several minutes of retries, on exactly the DNS that's broken.
#
# Compose names a build target it has no explicit `image:` for after
# <project>-<service>, which is what's reconstructed here. Needs python3 to
# read compose's own resolved config; without it this stays silent and the
# caller falls back to warning rather than guessing.
#
# Only the services `up` will actually start (wanted_services): a PHP
# version no site uses isn't built until a site needs it.
pending_image_builds() {
    command -v python3 >/dev/null 2>&1 || return 0
    docker compose config --format json 2>/dev/null | python3 -c '
import json, subprocess, sys
try:
    c = json.load(sys.stdin)
except Exception:
    sys.exit(0)
project = c.get("name") or ""
wanted = set(sys.argv[1:])
for name, svc in sorted(c.get("services", {}).items()):
    if "build" not in svc or (wanted and name not in wanted):
        continue
    image = svc.get("image") or (f"{project}-{name}" if project else None)
    if not image:
        continue
    if subprocess.run(["docker", "image", "inspect", image],
                      stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        print(image)
' $(wanted_services 2>/dev/null) 2>/dev/null
}

# Echoes "<url>" when a build-time proxy is configured but nothing is
# accepting connections at it; silent when there's no proxy or it answers.
#
# Every image build inherits HTTP_PROXY (docker-compose.yml passes it as a
# build arg, from .env or the environment), and apt and npm obey it
# absolutely: with the proxy down they don't fall back to a direct
# connection, they fail. The failure surfaces several minutes in as
# "Connection refused [IP: 127.0.0.1 10808]" buried in apt output, which
# reads like a mirror problem rather than a local one. Cheap to rule out up
# front, and a local proxy (xray, v2ray, an SSH tunnel) not running yet is
# an ordinary morning.
unreachable_build_proxy() {
    proxy="${HTTP_PROXY:-${http_proxy:-}}"
    if [ -z "$proxy" ] && [ -f .env ]; then
        proxy="$(sed -n 's/^[[:space:]]*HTTP_PROXY=//p' .env | head -1)"
    fi
    [ -n "$proxy" ] || return 0

    # http://host:port/ -> host, port. Only host:port forms are checked; a
    # proxy named without a port isn't something to guess a default for.
    hostport="${proxy#*://}"
    hostport="${hostport%%/*}"
    hostport="${hostport##*@}"
    case "$hostport" in
        *:*) phost="${hostport%:*}"; pport="${hostport##*:}" ;;
        *) return 0 ;;
    esac
    case "$pport" in ''|*[!0-9]*) return 0 ;; esac

    # bash's own /dev/tcp, so this needs neither nc nor curl installed.
    if ! timeout 3 bash -c "exec 3<>/dev/tcp/${phost}/${pport}" 2>/dev/null; then
        echo "$proxy"
    fi
}

# Echoes the build proxy when one is configured and reachable but the Docker
# DAEMON has no proxy of its own; silent otherwise.
#
# Worth telling apart from a build-time proxy problem, because they cover
# different traffic and only one of them is visible in .env. Image pulls --
# every `FROM`, every `docker pull` -- are done by dockerd, which does not
# read HTTP_PROXY from your shell or from a build arg; it needs a "proxies"
# block in /etc/docker/daemon.json. On a network that throttles or resets
# Docker Hub, the result is builds whose apt and npm steps fly through the
# proxy while the base-image pulls ahead of them crawl at kilobytes a second
# and die on "connection reset by peer" from the registry CDN.
#
# Not repaired automatically: sending every registry pull on the machine
# through a personal proxy is a policy choice, not a broken setting, and
# plenty of people set HTTP_PROXY for builds alone on purpose.
daemon_missing_registry_proxy() {
    grep -q '"proxies"' /etc/docker/daemon.json 2>/dev/null && return 0
    docker info 2>/dev/null | grep -qi "HTTP Proxy" && return 0
    proxy="${HTTP_PROXY:-${http_proxy:-}}"
    if [ -z "$proxy" ] && [ -f .env ]; then
        proxy="$(sed -n 's/^[[:space:]]*HTTP_PROXY=//p' .env | head -1)"
    fi
    [ -n "$proxy" ] || return 0
    # Only when it actually answers -- a dead proxy is unreachable_build_proxy's
    # story, and reporting both about the same URL would just be noise.
    [ -z "$(unreachable_build_proxy)" ] && echo "$proxy"
}

# Echoes a one-line verdict on what a bridge-network container can actually
# reach: "" when DNS resolves, "dns" when the gateway answers but names
# don't, "offline" when it can't even reach its own default gateway.
#
# Worth distinguishing, because the third case is not a DNS problem and the
# DNS advice is actively misleading there. A container with no route to its
# gateway has no outbound connectivity at all -- every lookup, every apt
# fetch, every composer download fails identically -- and the cause is a
# host firewall or a VPN client enforcing tunnel-all against traffic whose
# source isn't the tunnel address (Cisco Secure Client's vpnagentd does
# exactly this). No amount of resolver configuration fixes that.
container_reachability() {
    image=""
    for img in redis:alpine nginx:alpine alpine:latest; do
        if docker image inspect "$img" >/dev/null 2>&1; then image="$img"; break; fi
    done
    if [ -z "$image" ]; then
        image="alpine:latest"
        docker pull -q "$image" >/dev/null 2>&1 || return 0
    fi
    # Retried, because the first second of a container's life can lose a
    # lookup: docker0 is down while nothing uses it, and a VPN client that
    # watches interfaces (Cisco Secure Client does) rewrites its routes and
    # firewall filters the moment this container brings it back up.
    docker run --rm --entrypoint sh "$image" -c '
        for _ in 1 2 3; do
            nslookup deb.debian.org >/dev/null 2>&1 && exit 0
            sleep 1
        done
        gw="$(ip route | awk "/^default/ {print \$3; exit}")"
        [ -n "$gw" ] && ping -c 1 -W 2 "$gw" >/dev/null 2>&1 && exit 2
        exit 3
    ' >/dev/null 2>&1
    case "$?" in
        0) ;;
        2) echo "dns" ;;
        *) echo "offline" ;;
    esac
}

# Echoes "network subnet device" for each Docker bridge network whose subnet
# the host routes somewhere other than its own bridge, one per line; nothing
# when every bridge owns its route.
#
# This is the usual reason for container_reachability's "offline", and it
# has a fix that doesn't involve disconnecting. Cisco Secure Client pushes
# routes for the private ranges (172.16.0.0/12 among them) and adds a copy of
# every connected bridge's /16 pointing at cscotun0. Same prefix, same
# metric, and inserted first, so the kernel picks the tunnel: the host's
# replies to containers go into the VPN and vanish. Nothing on the Docker
# side can outrank that route, and the client puts it back if it's deleted,
# so the fix is to move the bridges to a range the VPN doesn't claim.
#
# Asked of `ip route get`, not read off the routing table, because the
# kernel's choice is the only thing that matters, and it needs no container
# and no sudo.
hijacked_bridge_routes() {
    docker network ls -q --filter driver=bridge 2>/dev/null | while read -r id; do
        # '|'-separated: the bridge-name option is empty on most networks,
        # and whitespace splitting would shift every field after it.
        info="$(docker network inspect -f '{{.Name}}|{{index .Options "com.docker.network.bridge.name"}}|{{range .IPAM.Config}}{{.Subnet}}|{{.Gateway}}{{end}}' "$id" 2>/dev/null)" || continue
        IFS='|' read -r name iface subnet gateway <<<"$info"
        # Networks without the option are named br-<first 12 of the id>.
        case "$iface" in
            ""|"<no value>") iface="br-${id:0:12}" ;;
        esac
        case "$gateway" in
            *.*.*.*) ;;
            *) continue ;;   # IPv6-only or no IPAM config
        esac
        # Probe the first container address, not the gateway: the gateway
        # is a local address and always resolves to the host itself.
        last="${gateway##*.}"
        [ "$last" -lt 254 ] || continue
        probe="${gateway%.*}.$((last + 1))"
        dev="$(ip -4 route get "$probe" 2>/dev/null | grep -o 'dev [^ ]*' | head -1 | cut -d' ' -f2)"
        if [ -n "$dev" ] && [ "$dev" != "$iface" ]; then
            echo "$name $subnet $dev"
        fi
    done
}

# Where fix_vpn_network moves Docker's bridges: docker0 gets the first /24,
# and every network compose (or anything else) creates comes out of the
# second /16. 100.64.0.0/10 is the carrier-grade NAT range -- not private
# address space, so corporate VPNs don't claim it, and nothing on a home or
# office LAN uses it either.
VPN_SAFE_BIP="100.64.0.1/24"
VPN_SAFE_GATEWAY="100.64.0.1"
VPN_SAFE_POOL="100.65.0.0/16"
VPN_SAFE_RANGE="100.64.0.0/10"

# Echoes what already routes into VPN_SAFE_RANGE more specifically than the
# default route (Tailscale, say, which lives in the same range); nothing
# when it's free to use.
vpn_safe_range_taken() {
    for probe in 100.64.0.2 100.65.0.2; do
        ip -4 route list match "$probe" 2>/dev/null | grep -v '^default'
    done | head -1
}

# Moves every Docker bridge network out of the ranges a VPN has taken over
# (see hijacked_bridge_routes) and into VPN_SAFE_RANGE. Mode "auto" is how
# `wpdev up` calls it: it only asks first if other projects' containers are
# running, since restarting dockerd stops them. Mode "manual" is
# `wpdev fix-vpn-network`, which always asks.
#
# It's done once, not every time the VPN connects: the new ranges work with
# the VPN on or off, so after this the problem simply doesn't come back.
fix_vpn_network() {
    mode="${1:-manual}"

    hijacked="$(hijacked_bridge_routes)"
    if [ -z "$hijacked" ]; then
        [ "$mode" = "manual" ] && print_info "Nothing to repair: no VPN is routing Docker's networks away from them."
        return 0
    fi
    tunnel="$(echo "$hijacked" | awk '{print $3; exit}')"

    taken="$(vpn_safe_range_taken)"
    if [ -n "$taken" ]; then
        print_fail "${tunnel} is routing Docker's networks away from them, but the usual escape, ${VPN_SAFE_RANGE}, is in use too: ${taken}"
        echo "  Pick a free range by hand: \"bip\" and \"default-address-pools\" in /etc/docker/daemon.json."
        return 1
    fi

    foreign="$(foreign_running_containers)"

    print_warning "Your VPN (${tunnel}) is routing Docker's networks into its tunnel, so containers can't reach the internet."
    if [ "$mode" = "manual" ] || [ -n "$foreign" ]; then
        echo "This will, with sudo:"
        echo "  1. stop this stack"
        echo "  2. move Docker's networks to ${VPN_SAFE_RANGE}, which the VPN leaves alone"
        echo "     (in /etc/docker/daemon.json, backed up first)"
        echo "  3. restart docker"
        echo "  4. remove the old networks, so they're recreated on the new range"
        echo "It's a one-time change: afterwards containers work with the VPN on or off."
        if [ -n "$foreign" ]; then
            echo ""
            print_warning "Restarting docker will stop these containers, which aren't part of this stack:"
            echo "$foreign" | sed 's/^/    /'
        fi
        echo ""
        if [ ! -t 0 ]; then
            print_fail "Needs confirmation but there's no terminal to ask on. Run 'wpdev fix-vpn-network' interactively, or set WPDEV_SKIP_DNS_FIX=1 to skip."
            return 1
        fi
        read -r -p "Proceed? [y/N] " confirm
        case "$confirm" in [yY]*) ;; *) echo "Aborted."; return 1 ;; esac
    else
        echo "Moving Docker's networks to ${VPN_SAFE_RANGE}, which the VPN leaves alone (one-time, needs sudo)..."
    fi

    if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
        print_fail "Needs sudo, with no cached credentials and no terminal to prompt on. Run 'wpdev fix-vpn-network' interactively first, or set WPDEV_SKIP_DNS_FIX=1."
        return 1
    fi
    sudo -v || return 1

    # Our network can only be removed once nothing is attached to it.
    docker compose down >/dev/null 2>&1 || true
    print_info "Stopped this stack"

    old_gateway="$(ip -4 -o addr show docker0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"

    sudo install -d /etc/docker || return 1
    [ -f /etc/docker/daemon.json ] && { sudo cp /etc/docker/daemon.json "/etc/docker/daemon.json.bak-$(date +%Y%m%d%H%M%S)" || return 1; }
    # Merged, not overwritten -- proxies, mirrors and log limits survive.
    # "dns" follows docker0 only when fix-dns pointed it there; a resolver
    # someone chose by hand is left alone.
    dns_moved="$(sudo python3 - "$VPN_SAFE_BIP" "$VPN_SAFE_POOL" "$old_gateway" "$VPN_SAFE_GATEWAY" <<'PY'
import json, os, sys
bip, pool, old_gw, new_gw = sys.argv[1:]
p = "/etc/docker/daemon.json"
d = {}
if os.path.exists(p):
    with open(p) as f:
        d = json.load(f)
d["bip"] = bip
d["default-address-pools"] = [{"base": pool, "size": 24}]
moved = bool(old_gw) and d.get("dns") == [old_gw]
if moved:
    d["dns"] = [new_gw]
with open(p, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
print("yes" if moved else "")
PY
)" || return 1
    print_info "Set \"bip\": \"${VPN_SAFE_BIP}\" and \"default-address-pools\" base ${VPN_SAFE_POOL} in /etc/docker/daemon.json"

    if [ -n "$dns_moved" ]; then
        # The resolver containers use was on the old docker0 address; keep
        # it with docker0 (see fix_container_dns).
        printf '[Resolve]\nDNSStubListenerExtra=%s\n' "$VPN_SAFE_GATEWAY" | sudo tee /etc/systemd/resolved.conf.d/docker.conf >/dev/null || return 1
        print_info "Container DNS now on ${VPN_SAFE_GATEWAY} (daemon.json and /etc/systemd/resolved.conf.d/docker.conf)"
        if command -v ufw >/dev/null 2>&1 && sudo ufw status 2>/dev/null | grep -q "^Status: active"; then
            sudo ufw allow from "$VPN_SAFE_RANGE" to "$VPN_SAFE_GATEWAY" port 53 proto udp >/dev/null
            sudo ufw allow from "$VPN_SAFE_RANGE" to "$VPN_SAFE_GATEWAY" port 53 proto tcp >/dev/null
            print_info "Opened port 53 from ${VPN_SAFE_RANGE} to ${VPN_SAFE_GATEWAY} (ufw)"
        fi
    fi

    sudo systemctl restart docker || return 1
    for _ in $(seq 1 30); do
        docker info >/dev/null 2>&1 && break
        sleep 1
    done
    [ -n "$dns_moved" ] && { sudo systemctl restart systemd-resolved || return 1; }
    print_info "Restarted docker"

    # A network keeps the subnet it was created with, so the old ones have to
    # go; whoever uses them creates them again, on the new range, at their
    # next `up`. One that's still in use (a container with a restart policy
    # came back on it) is left, and named.
    stuck=""
    for name in $(echo "$hijacked" | awk '{print $1}'); do
        [ "$name" = "bridge" ] && continue   # docker0: moved by "bip" instead
        docker network rm "$name" >/dev/null 2>&1 || stuck="${stuck} ${name}"
    done
    print_info "Removed the old networks"

    case "$(container_reachability)" in
        "")
            print_info "Containers can reach the internet again"
            ;;
        *)
            print_fail "Docker's networks moved, but a container still can't reach the internet — run 'wpdev doctor' to see what's left."
            return 1
            ;;
    esac
    if [ -n "$stuck" ]; then
        print_warning "These networks are still in use, so they stayed on the old range:${stuck}"
        echo "  In the project that owns each one, run 'docker compose down' and then 'docker compose up -d'."
    fi
    return 0
}

cmd_fix_vpn_network() { fix_vpn_network manual; }

# Make container DNS work when the host's resolver lives behind a VPN
# tunnel (see vpn_dns_unreachable_from_containers for the diagnosis).
#
# systemd-resolved is told to listen on docker0's gateway in addition to
# 127.0.0.53, and the daemon is told to hand containers that address.
# Containers then ask the host, and the host forwards over the tunnel the
# way everything else on the machine does -- so this holds whether or not
# the VPN happens to be connected, which is why it's a one-time repair and
# not something to toggle per session.
#
# Called two ways: `wpdev up` runs it automatically on any machine with the
# problem (mode "auto"), and `wpdev fix-dns` runs it on demand (mode
# "manual", which lists the changes and waits for a yes first). The repair
# itself is identical; only the consent differs. Returns nonzero if it
# couldn't finish, so `up` can stop rather than march into a doomed build.
#
# Needs root. That's consistent with the rest of this script -- `wpdev add`
# already appends to /etc/hosts with sudo mid-provision, and install-mkcert
# installs packages -- so it prompts for a password where sudo would, and
# gives up with instructions where it can't (no TTY and no cached
# credentials, i.e. CI).
#
# Set WPDEV_SKIP_DNS_FIX=1 to suppress the automatic repair entirely, for a
# machine whose container DNS is managed some other way.
# Echoes the names of running containers that aren't part of this stack,
# one per line. Anything that restarts dockerd stops them too, so they get
# named before it happens.
#
# Asked as "running containers that aren't ours" rather than by matching a
# project label against a hardcoded name -- the compose project name follows
# the directory, so anyone who clones this somewhere else would silently have
# every container of their own treated as ours. --no-trunc so these ids are
# comparable with the full ones `docker compose ps -q` returns.
foreign_running_containers() {
    ours="$(docker compose ps -q 2>/dev/null)" || true
    foreign=""
    for cid in $(docker ps -q --no-trunc 2>/dev/null); do
        case " $(echo $ours) " in
            *" ${cid} "*) ;;
            *) foreign="${foreign}$(docker inspect -f '{{.Name}}' "$cid" 2>/dev/null | sed 's|^/||')
" ;;
        esac
    done
    echo "$foreign" | grep -v '^$' || true
}

fix_container_dns() {
    mode="${1:-manual}"

    if ! command -v resolvectl >/dev/null 2>&1; then
        print_fail "This repair is systemd-resolved specific and resolvectl isn't here. Point /etc/docker/daemon.json's \"dns\" at a resolver your containers can reach."
        return 1
    fi

    gateway="$(ip -4 -o addr show docker0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
    if [ -z "$gateway" ]; then
        print_fail "No docker0 interface — is Docker running?"
        return 1
    fi

    tunnel_dns="$(vpn_dns_unreachable_from_containers)"
    if [ -z "$tunnel_dns" ]; then
        [ "$mode" = "manual" ] && print_info "Nothing to repair: container DNS already works (or /etc/docker/daemon.json already sets \"dns\")."
        return 0
    fi

    # The one genuinely destructive part: `dns` isn't among the options
    # dockerd re-reads on SIGHUP, so the daemon has to restart, and that
    # stops every running container -- including ones belonging to other
    # projects entirely. Ours are fair game (this `up` is about to recreate
    # them anyway); somebody else's are not, so those get an explicit yes
    # even in auto mode.
    foreign="$(foreign_running_containers)"

    if [ "$mode" = "manual" ] || [ -n "$foreign" ]; then
        print_warning "Host DNS is ${tunnel_dns}, which containers can't reach."
        echo "This will, with sudo:"
        echo "  1. have systemd-resolved listen on ${gateway} as well as 127.0.0.53"
        echo "  2. set \"dns\": [\"${gateway}\"] in /etc/docker/daemon.json (backed up first)"
        echo "  3. allow port 53 from 172.16.0.0/12 to ${gateway}, if ufw is active"
        echo "  4. restart systemd-resolved and docker"
        if [ -n "$foreign" ]; then
            echo ""
            print_warning "Restarting docker will stop these containers, which aren't part of this stack:"
            echo "$foreign" | sed 's/^/    /'
        fi
        echo ""
        if [ ! -t 0 ]; then
            print_fail "Needs confirmation but there's no terminal to ask on. Run 'wpdev fix-dns' interactively, or set WPDEV_SKIP_DNS_FIX=1 to skip."
            return 1
        fi
        read -r -p "Proceed? [y/N] " confirm
        case "$confirm" in [yY]*) ;; *) echo "Aborted."; return 1 ;; esac
    else
        print_warning "Host DNS is ${tunnel_dns} — not reachable from inside a container. Repairing (needs sudo)..."
    fi

    if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
        print_fail "Needs sudo, with no cached credentials and no terminal to prompt on. Run 'wpdev fix-dns' interactively first, or set WPDEV_SKIP_DNS_FIX=1."
        return 1
    fi

    sudo install -d /etc/systemd/resolved.conf.d || return 1
    printf '[Resolve]\nDNSStubListenerExtra=%s\n' "$gateway" | sudo tee /etc/systemd/resolved.conf.d/docker.conf >/dev/null || return 1
    print_info "Wrote /etc/systemd/resolved.conf.d/docker.conf"

    sudo install -d /etc/docker || return 1
    if [ -f /etc/docker/daemon.json ]; then
        sudo cp /etc/docker/daemon.json "/etc/docker/daemon.json.bak-$(date +%Y%m%d%H%M%S)" || return 1
        # Merged, not overwritten: daemon.json routinely carries unrelated
        # settings (registry mirrors, log limits, proxies) that have to
        # survive this.
        sudo python3 - "$gateway" <<'PY' || return 1
import json, sys
p = "/etc/docker/daemon.json"
with open(p) as f:
    d = json.load(f)
d["dns"] = [sys.argv[1]]
with open(p, "w") as f:
    json.dump(d, f, indent=2)
    f.write("\n")
PY
    else
        printf '{\n  "dns": ["%s"]\n}\n' "$gateway" | sudo tee /etc/docker/daemon.json >/dev/null || return 1
    fi
    print_info "Set \"dns\": [\"${gateway}\"] in /etc/docker/daemon.json"

    # ufw defaults to deny-incoming, and these queries arrive at the host on
    # the bridge gateway. Every docker bridge sits inside 172.16.0.0/12
    # (docker0 plus whatever subnets compose allocates), so one pair of
    # rules covers the networks that exist now and any added later.
    # After fix-vpn-network the bridges live in VPN_SAFE_RANGE instead.
    bridges="172.16.0.0/12"
    [ "$gateway" = "$VPN_SAFE_GATEWAY" ] && bridges="$VPN_SAFE_RANGE"
    if command -v ufw >/dev/null 2>&1 && sudo ufw status 2>/dev/null | grep -q "^Status: active"; then
        sudo ufw allow from "$bridges" to "$gateway" port 53 proto udp >/dev/null
        sudo ufw allow from "$bridges" to "$gateway" port 53 proto tcp >/dev/null
        print_info "Opened port 53 from ${bridges} to ${gateway} (ufw)"
    fi

    sudo systemctl restart systemd-resolved || return 1
    sudo systemctl restart docker || return 1
    print_info "Restarted systemd-resolved and docker"

    # The daemon needs a moment to accept connections again; without this
    # wait the probe below -- and, in auto mode, the `docker compose up`
    # right after it -- can race the restart and fail on a closed socket.
    for _ in $(seq 1 30); do
        docker info >/dev/null 2>&1 && break
        sleep 1
    done

    if ss -lnu 2>/dev/null | grep -q "${gateway}:53"; then
        print_info "systemd-resolved is listening on ${gateway}:53"
    else
        print_warning "systemd-resolved doesn't appear to be listening on ${gateway}:53 — check: resolvectl status"
    fi

    case "$(container_reachability)" in
        "")
            print_info "Container DNS works"
            return 0
            ;;
        offline)
            # The resolver config is now correct and irrelevant: nothing
            # outbound works from a bridge network, so say that plainly
            # instead of sending someone back to look at DNS again.
            print_fail "Containers have no outbound connectivity at all — a bridge-network container can't even reach its own gateway, so this isn't a DNS problem and the change just made won't help on its own."
            echo "  Likely a host firewall or a VPN client enforcing tunnel-all against traffic sourced from 172.16.0.0/12."
            if pgrep -x vpnagentd >/dev/null 2>&1; then
                echo "  Cisco Secure Client (vpnagentd) is running — the quickest way to confirm is to disconnect it and re-run 'wpdev doctor'."
            fi
            echo "  Check: sudo ufw status verbose; sudo iptables -t filter -L -n -v"
            return 1
            ;;
        *)
            print_fail "Container DNS still failing, though the gateway is reachable. Check 'sudo ufw status' and 'resolvectl status', then re-run 'wpdev doctor'."
            return 1
            ;;
    esac
}

cmd_fix_dns() { fix_container_dns manual; }

# ---------------------------------------------------------------------------
# Stack lifecycle
# ---------------------------------------------------------------------------

# Sets (or updates) one KEY=value line in .env, in place. Used by cmd_up to
# keep a handful of host-specific, auto-detected values in sync -- these are
# real host facts (this directory's path, this user's uid/gid, the Docker
# socket's gid), not preferences, so autodetecting and overwriting on every
# `wpdev up` is correct, not just convenient: a value hardcoded once in
# .env.example would be right on exactly one machine and silently wrong
# (wrong uid, wrong docker gid) on every other one, CI included.
set_env_var() {
    key="$1"
    value="$2"
    if grep -q "^${key}=" .env; then
        sed -i "s|^${key}=.*|${key}=${value}|" .env
    else
        echo "${key}=${value}" >> .env
    fi
}

# What the dashboard shows as its own version -- nearest tag plus
# commits-since-and-hash (git describe), not a hand-maintained version file
# that drifts the moment someone forgets to bump it. `--always` falls back
# to a bare short hash if this checkout has no tags reachable at all;
# `unknown` only if git itself fails (e.g. .git missing from a tarball
# install). The dashboard reads it when its container starts, so this runs
# before every `compose up` that should show a new version: `up`, and both
# of `update`'s paths.
sync_app_version() {
    local app_version
    [ -f .env ] || return 0
    app_version="$(git -C "${SCRIPT_DIR}" describe --tags --always --dirty 2>/dev/null)" || app_version="unknown"
    set_env_var APP_VERSION "$app_version"
}

cmd_up() {
    require_stack_services
    # Host config that would otherwise fail mid-pull or mid-build with a
    # message pointing nowhere near its cause. The credential one is
    # repaired in place (no sudo, nothing lost -- see
    # repair_stale_creds_helper); the DNS one needs root and a daemon
    # restart, so it's reported and left to an explicit `wpdev fix-dns`
    # rather than done behind your back halfway through bringing the
    # stack up.
    helper="$(stale_creds_helper)"
    if [ -n "$helper" ]; then
        print_warning "~/.docker/config.json wants credential helper 'docker-credential-${helper}', which isn't installed — every image pull would fail before reaching the registry."
        if backup="$(repair_stale_creds_helper)"; then
            print_info "Removed the dead \"credsStore\": \"${helper}\" (backup: ${backup})"
        else
            print_error "Couldn't edit it automatically (needs python3 or jq). Remove the \"credsStore\" line from ${DOCKER_CONFIG_JSON} by hand, then re-run."
        fi
    fi

    # Repaired here, not merely reported: a resolver containers can't reach
    # makes every image build fail (apt and npm run inside a container) and
    # bakes the dead address into the /etc/resolv.conf of every container
    # this `up` is about to create. Reporting it would just hand back a
    # 150-second build failure whose real cause has scrolled off the top of
    # a 70-step log. `up` is the right moment for the repair too: the daemon
    # restart it needs is cheapest before the stack is running, and `up` is
    # the command people actually run.
    # Before the DNS work, because a dead proxy breaks builds regardless of
    # how well DNS resolves, and it's a one-connect check.
    dead_proxy="$(unreachable_build_proxy)"
    if [ -n "$dead_proxy" ] && [ -n "$(pending_image_builds)" ]; then
        print_warning "A build proxy is configured (${dead_proxy}) but nothing is listening there."
        echo "  Every build inherits it as HTTP_PROXY, and apt and npm won't fall back to a direct connection — they'll fail several minutes in."
        print_error "Start the proxy, or unset HTTP_PROXY/HTTPS_PROXY (shell environment and .env) to build directly, then re-run."
    fi

    # Before the DNS repair: this one moves docker0, and the DNS repair
    # points containers at docker0's address, so it has to see the new one.
    # Not refused on failure -- the stack still serves sites with no
    # outbound access; only what containers fetch (plugins, composer) breaks.
    if [ -z "${WPDEV_SKIP_DNS_FIX:-}" ] && [ -n "$(hijacked_bridge_routes)" ]; then
        if ! fix_vpn_network auto; then
            print_warning "Continuing without it: sites will load, but plugin installs, updates and composer inside containers will fail while the VPN is connected. Run 'wpdev fix-vpn-network' to try again."
        fi
    fi

    if [ -z "${WPDEV_SKIP_DNS_FIX:-}" ]; then
        if [ -n "$(vpn_dns_unreachable_from_containers)" ]; then
            # Config-only check, so it's cheap enough to run every time --
            # and worth acting on even with nothing to build, because every
            # container this `up` creates would otherwise bake the dead
            # resolver into its own /etc/resolv.conf.
            pending="$(pending_image_builds)"
            if [ -n "$pending" ]; then
                echo "These images still need building, and every build fetches packages from inside a container:"
                echo "$pending" | sed 's/^/    /'
            fi
            if ! fix_container_dns auto; then
                print_error "Couldn't repair container DNS — builds and in-container downloads would fail. Fix it and re-run, or set WPDEV_SKIP_DNS_FIX=1 to proceed anyway."
            fi
        else
            # The resolver is configured correctly, which is not the same as
            # containers being able to use it: a host firewall or a VPN
            # enforcing tunnel-all can still drop everything they send. That
            # takes an actual container to detect, so it's only paid for when
            # something needs building -- a build is what needs container
            # networking, and a plain `up` with every image present doesn't
            # deserve the extra few seconds.
            pending="$(pending_image_builds)"
            if [ -n "$pending" ]; then
                case "$(container_reachability)" in
                    offline)
                        # Warned about, not refused. Every build here uses
                        # `network: host`, so a build is immune to this --
                        # it resolves and fetches in the host's namespace,
                        # not a bridge. Blocking would be the wrong call
                        # twice over: it stops work that would have
                        # succeeded, and the stack it refuses to start is
                        # perfectly usable for serving sites locally, since
                        # nginx, php and mysql only ever talk to each other.
                        print_warning "Containers have no outbound connectivity — a bridge-network container can't reach its own gateway."
                        echo "  Builds are unaffected (they use the host network namespace), and the stack will serve sites fine."
                        echo "  What won't work is anything a running container fetches: wp plugin install, composer, plugin updates from wp-admin."
                        echo "  Not a DNS problem: a host firewall, or a VPN enforcing tunnel-all against 172.16.0.0/12, is dropping it."
                        if pgrep -x vpnagentd >/dev/null 2>&1; then
                            echo "  Cisco Secure Client (vpnagentd) is running — its chains sit above ufw's in INPUT, so no local Docker or ufw setting overrides them. Disconnecting is the quickest confirmation."
                        fi
                        ;;
                    dns)
                        print_warning "Containers can reach the network but can't resolve names. Builds are unaffected (host network namespace), but anything a running container fetches will fail. Check 'resolvectl status' and /etc/docker/daemon.json's \"dns\"."
                        ;;
                esac
            fi
        fi
    fi

    # Group-writable so www-data (PHP-FPM, inside every phpXX container) can
    # create its own top-level dirs here too. A fresh git checkout gets
    # ./sites at whatever mode the checkout's umask produced, so this can't
    # just be committed once.
    chmod g+w sites 2>/dev/null || true

    # wp-cli's download cache used to land here (www-data's home is
    # /var/www); it lives in the wp_cli_cache volume now. Only a cache, so
    # the old copy just goes.
    rm -rf sites/.wp-cli 2>/dev/null || true

    # Auto-detected values the `api` service (docker-compose.yml) needs --
    # see that file's comments for why each one matters. Keyed off real
    # facts about THIS machine (SCRIPT_DIR, `id -u`/`id -g`, the Docker
    # socket's actual gid), not $PWD or a guess, so this is correct
    # regardless of where `wpdev up` is invoked from and self-heals if any
    # of them ever change (this directory moves, docker.sock's gid differs
    # after a Docker reinstall, etc.).
    if [ -f .env ]; then
        set_env_var PROJECT_DIR "${SCRIPT_DIR}"
        set_env_var API_UID "$(id -u)"
        set_env_var API_GID "$(id -g)"
        docker_gid="$(stat -c '%g' /var/run/docker.sock 2>/dev/null)" || true
        [ -n "$docker_gid" ] && set_env_var DOCKER_GID "$docker_gid"

        sync_app_version

        # This desktop session's D-Bus socket, for `wpdev open` from the
        # api (the dashboard's "Open in file manager"); empty on a machine
        # without one (headless, CI, macOS). Host only: in the api the
        # path doesn't exist, and that's no reason to clear it.
        if [ -z "${WPDEV_IN_API:-}" ]; then
            if [ -S "/run/user/$(id -u)/bus" ]; then
                set_env_var DESKTOP_BUS "/run/user/$(id -u)/bus"
            elif grep -q '^DESKTOP_BUS=' .env; then
                set_env_var DESKTOP_BUS ""
            fi
        fi

        # Share the host's (browser-trusted) mkcert CA with the api
        # container, so sites created from the dashboard get trusted certs
        # too -- otherwise it issues them from a private CA of its own.
        # Only fills an empty value, never overrides one you set; and never
        # from inside the api, where `mkcert -CAROOT` is the container's own
        # /mkcert-ca, not a host path. (#10)
        if [ -z "${WPDEV_IN_API:-}" ] && [ -z "$(sed -n 's/^MKCERT_CAROOT=//p' .env | tail -1)" ]; then
            host_caroot="$(mkcert_caroot)"
            if [ -n "$host_caroot" ]; then
                if grep -q '^#[[:space:]]*MKCERT_CAROOT=' .env; then
                    sed -i "0,/^#[[:space:]]*MKCERT_CAROOT=.*/s||MKCERT_CAROOT=${host_caroot}|" .env
                else
                    set_env_var MKCERT_CAROOT "$host_caroot"
                fi
                print_info "Set MKCERT_CAROOT=${host_caroot} in .env, so the dashboard issues browser-trusted certs"
            fi
        fi
    fi

    # Only ones that never started ("created"): a renamed container that's
    # still running or stopping belongs to a recreate in progress right now.
    stale="$(recreate_leftovers | awk '$2 == "created" {print $1}')"
    if [ -n "$stale" ]; then
        # shellcheck disable=SC2086
        docker rm $stale >/dev/null
        print_info "Removed container(s) left by an interrupted recreate: $(echo $stale)"
    fi

    retire_services
    require_wanted_services
    # Compose's own implicit build in `up` hits the same --allow refusal.
    [ -z "$(pending_image_builds)" ] || compose_build $(wanted_services)
    docker compose up -d $(wanted_services)
    upgrade_vhosts
    sync_off_pages
    stop_unused_php
    if [ -n "${WPDEV_IN_API:-}" ] && api_is_stale; then
        recreate_api_detached "up -d"
    fi
    echo "Containers started. Give MySQL 30 seconds to initialize if this is the first run."
    update_notice || true
}

# Containers of services this project no longer has (Portainer, removed
# in favour of the dashboard's Docker page). Compose doesn't remove a
# service's container just because the service left docker-compose.yml --
# it would keep running, and doctor would report it as an orphan. Only a
# container carrying this project's compose label is touched. Its image
# goes too, unless something else still uses it (no --force, so Docker
# refuses then) -- once the service is gone from docker-compose.yml, the
# Docker page no longer counts that image as this project's. Its data
# volume is left alone (the Docker page shows it as unused, to delete if
# you want). Entries are service=image.
RETIRED_SERVICES="portainer=portainer/portainer-ce:latest"
retire_services() {
    local entry svc image c project
    project="$(compose_project)"
    for entry in $RETIRED_SERVICES; do
        svc="${entry%%=*}"
        image="${entry#*=}"
        c="wp-${svc}"
        [ "$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$c" 2>/dev/null)" = "$project" ] || continue
        docker rm -f "$c" >/dev/null 2>&1 || continue
        print_info "Removed ${c} (${svc} is no longer part of wp-local-dev)"
        if docker rmi "$image" >/dev/null 2>&1; then
            print_info "Removed its image ${image}"
        fi
    done
    return 0
}

# Run from the dashboard, these commands execute inside the api container
# itself (docker-compose.yml sets WPDEV_IN_API there), and any compose
# command that stops or recreates wp-api kills the very process running it.
# Found live: `up` after a `git pull` changed APP_VERSION in .env, which
# wp-api loads via env_file, so compose recreated it -- the old container
# was SIGKILLed mid-recreate and the replacement was left "Created" under a
# hash-prefixed name, never started. So from in there, every service but
# api is named explicitly, and api itself is recreated by a detached helper
# container instead (recreate_api_detached). Empty output outside the api
# means "all services".
#
# Fails closed: inside the api, an empty list would make every caller fall
# back to "all services" -- api included -- so it's an error instead. And
# since callers use it unquoted inside $(...), where a failure can't stop
# them under set -e, they must call require_stack_services first.
stack_services() {
    [ -n "${WPDEV_IN_API:-}" ] || return 0
    docker compose config --services 2>/dev/null | grep -vx api || true
}
require_stack_services() {
    [ -n "${WPDEV_IN_API:-}" ] || return 0
    [ -n "$(stack_services)" ] || print_error "Couldn't list the compose services (docker compose config failed), so this can't safely leave the api container out. Run it on the host instead."
}

# PHP on demand: a container per supported version exists in
# docker-compose.yml, but only the versions some site uses run. These are
# the pieces `up`, `update`, `restart`, `remove` and doctor share.

# PHP versions that some site that's on uses -- its PHP_VERSION, or the
# default for a site saved without one. A site switched off (`wpdev off`)
# doesn't count, so its version's container stops once no other site needs
# it. Sorted, one per line; empty with no sites.
php_versions_in_use() {
    local name v
    for name in $(site_names); do
        site_is_off "$name" && continue
        v="$(site_get "$name" PHP_VERSION)"
        echo "${v:-$DEFAULT_PHP_VERSION}"
    done | sort -uV
}

php_services_in_use() {
    local v
    for v in $(php_versions_in_use); do php_slug "$v"; done
}

# What `up`/`update`/`restart` act on: every non-PHP service (minus the
# api when run from inside it, see stack_services) plus only the PHP
# versions in use. Never empty, so it's always an explicit list -- unlike
# stack_services' "empty means all", which would start every PHP version.
wanted_services() {
    local core
    core="$(docker compose config --services 2>/dev/null | grep -vxE 'php[0-9]+' || true)"
    [ -n "${WPDEV_IN_API:-}" ] && core="$(echo "$core" | grep -vx api || true)"
    [ -n "$core" ] || return 1
    echo $core $(php_services_in_use)
}
require_wanted_services() {
    # Inside the api, the same fail-closed check (and message) as every
    # other stack command: an unreadable service list must never fall back
    # to anything that could include the api itself.
    require_stack_services
    wanted_services >/dev/null || print_error "Couldn't list the compose services (docker compose config failed)."
}

# Removes the container of every PHP version no site uses any more (the
# image stays, so a later site on that version starts in seconds). PHP-FPM
# keeps no state of its own, so there's nothing to lose.
stop_unused_php() {
    local v svc in_use
    in_use=" $(php_services_in_use | tr '\n' ' ') "
    for v in $SUPPORTED_PHP_VERSIONS; do
        svc="$(php_slug "$v")"
        case "$in_use" in *" ${svc} "*) continue ;; esac
        docker inspect "wp-${svc}" >/dev/null 2>&1 || continue
        docker compose rm -sf "$svc" >/dev/null 2>&1 && print_info "Stopped wp-${svc} (no site that's on uses PHP ${v})"
    done
    return 0
}

# Starts one PHP version's container, building its image first if this is
# its first use -- which takes a few minutes, so say so up front.
ensure_php_running() {
    local svc="$1" image
    [ "$(docker inspect -f '{{.State.Running}}' "wp-${svc}" 2>/dev/null)" = "true" ] && return 0
    image="$(compose_project)-${svc}"
    if ! docker image inspect "$image" >/dev/null 2>&1; then
        print_info "Building the ${svc} image (first site on this PHP version; takes a few minutes)..."
        compose_build "$svc"
    fi
    docker compose up -d "$svc" >/dev/null
}

# True when wp-api's compose config hash differs from the running
# container's, i.e. a host `up` would recreate it.
api_is_stale() {
    local want have
    want="$(docker compose config --hash api 2>/dev/null | awk '{print $2}')"
    have="$(docker inspect wp-api --format '{{index .Config.Labels "com.docker.compose.config-hash"}}' 2>/dev/null)"
    [ -n "$want" ] && [ "$want" != "$have" ]
}

# The one thing the api can't do to itself -- recreate wp-api -- handed to
# a short-lived container that isn't wp-api, so it survives the recreate.
# It runs the api's own image (docker CLI + compose already in it) as this
# same unprivileged user with the socket's group, against the same project
# directory, so it's the same compose project and anything it writes is
# owned by you. The short sleep lets this request's response reach the
# dashboard first; the dashboard then reconnects on its own poll. It
# writes its own output to logs/api-updater.log (--rm discards the
# container, and anything following it from in here dies with wp-api).
# Not named wp-*: doctor would report it as an orphan while it runs. (#13)
recreate_api_detached() {
    local compose_args="$1" img sock_gid
    img="$(docker inspect -f '{{.Config.Image}}' wp-api 2>/dev/null)" || true
    sock_gid="$(stat -c '%g' /var/run/docker.sock 2>/dev/null)" || true
    if [ -z "$img" ] || [ -z "$sock_gid" ] || ! docker run -d --rm --name wpdev-api-updater \
        --user "$(id -u):$(id -g)" --group-add "$sock_gid" -e HOME=/tmp \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "${SCRIPT_DIR}:${SCRIPT_DIR}" -w "${SCRIPT_DIR}" \
        --entrypoint sh "$img" -c \
        "sleep 3; { echo \"[\$(date -Is)] docker compose ${compose_args} api\"; docker compose ${compose_args} api; echo \"[\$(date -Is)] exit \$?\"; } >>logs/api-updater.log 2>&1" \
        >/dev/null 2>"logs/api-updater.start.log"; then
        print_warning "Couldn't start the helper that applies changes to the api itself (see logs/api-updater.start.log). Run ./wpdev up on the host to apply them."
        return 0
    fi
    [ -s logs/api-updater.start.log ] || rm -f logs/api-updater.start.log
    print_info "The api restarts itself in a few seconds to apply its own changes — the dashboard reconnects on its own (log: logs/api-updater.log)."
}

cmd_down() {
    require_stack_services
    # A share outlives nothing it depends on: its tunnel would just fail.
    cmd_share --all-off >/dev/null 2>&1 || true
    if [ -n "${WPDEV_IN_API:-}" ]; then
        # `down` takes no service list; stop+rm is its per-service form.
        # api stays up so the dashboard can still bring the stack back.
        docker compose stop $(stack_services)
        docker compose rm -f $(stack_services)
    else
        docker compose down
    fi
}
# No arguments: the whole stack (minus the api when run from it). With
# service names: just those, validated against the compose file so a typo
# is an error rather than a silent no-op. Asked from inside the api to
# restart the api itself, the restart is handed to the same detached
# helper `up`/`update` use -- doing it in-process would kill the request
# that asked for it.
cmd_restart() {
    if [ $# -eq 0 ]; then
        require_wanted_services
        docker compose restart $(wanted_services)
        return
    fi

    local known svc others=() api=""
    known="$(docker compose config --services 2>/dev/null)" || print_error "Couldn't list the compose services (docker compose config failed)."
    for svc in "$@"; do
        printf '%s\n' "$known" | grep -qx -- "$svc" || print_error "Unknown service '${svc}'. Services: $(echo $known)"
        if [ "$svc" = "api" ] && [ -n "${WPDEV_IN_API:-}" ]; then api=1; else others+=("$svc"); fi
    done

    if [ ${#others[@]} -gt 0 ]; then
        docker compose restart "${others[@]}"
    fi
    if [ -n "$api" ]; then
        recreate_api_detached "restart"
    fi
}

# Pull the latest wp-local-dev, then rebuild + fully recreate every
# container. The rebuild picks up Dockerfile changes (anything baked into
# the image, like php/crontab); --force-recreate is there because a plain
# `up -d` only restarts a container whose *compose service config* changed
# -- it has no way to know a bind-mounted file's *content* changed (e.g.
# nginx.conf, php/xdebug.ini), so without this, a pulled config fix can
# silently sit on disk unapplied until something else happens to restart
# that container. Discovered the hard way this session with exactly that
# class of bug (a stale bind mount after an in-place file edit).
cmd_update() {
    require_stack_services
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || print_error "Not a git checkout -- can't update. Re-clone from https://github.com/itsomidho/wp-local-dev."

    if [ -n "$(git status --porcelain)" ]; then
        print_error "You have uncommitted changes -- commit or stash them first, then run 'wpdev update' again."
    fi

    print_info "Fetching origin..."
    git fetch origin

    local_rev="$(git rev-parse HEAD)"
    if ! remote_rev="$(git rev-parse '@{u}' 2>/dev/null)"; then
        # install.sh clones with --depth 1, which is single-branch too:
        # remote.origin.fetch covers main alone, so no other branch has a
        # remote-tracking ref for @{u} to resolve -- not even one `git push
        # -u` has already written tracking config for. Git's own wording for
        # this is "no upstream configured", which sends you to
        # --set-upstream-to, and that doesn't help: the upstream is set, the
        # remote-tracking ref is what's missing.
        cur_branch="$(git rev-parse --abbrev-ref HEAD)"
        if ! git config --get-all remote.origin.fetch | grep -q 'refs/heads/\*'; then
            print_error "On branch '${cur_branch}', but this is a single-branch clone that only tracks main, so there's nothing here to update from. Either switch back: git checkout main && wpdev update — or widen the clone: git remote set-branches origin '*' && git fetch origin"
        fi
        print_error "Current branch has no upstream configured (git branch --set-upstream-to=origin/<branch>)."
    fi

    if [ "$local_rev" = "$remote_rev" ]; then
        print_info "Already up to date -- checking the images were built from this code..."
        rebuild_stale_images
        return
    fi

    # --ff-only: never auto-merge or rewrite local commits. If history has
    # diverged, this fails loudly instead of guessing what you want.
    if ! git pull --ff-only; then
        print_error "Can't fast-forward -- your branch has local commits origin doesn't have. Resolve manually (e.g. git rebase origin/main), then run 'wpdev update' again."
    fi

    echo
    echo "Updated:"
    git log --oneline "${local_rev}..HEAD"
    echo

    print_info "Rebuilding images and recreating containers to apply changes..."
    require_wanted_services
    if [ -n "${WPDEV_IN_API:-}" ]; then
        # Building api's image from inside it is safe; only recreating
        # wp-api isn't (see recreate_api_detached).
        compose_build $(wanted_services) api
    else
        compose_build $(wanted_services)
    fi
    retire_services
    sync_app_version
    docker compose up -d --force-recreate $(wanted_services)
    upgrade_vhosts
    sync_off_pages
    stop_unused_php
    # Always, not just when api_is_stale: the pull may have changed api's
    # code, which only a rebuild picks up -- its config hash can't show it.
    [ -n "${WPDEV_IN_API:-}" ] && recreate_api_detached "up -d --force-recreate"
    print_info "Update complete."
}

# The "already up to date" half of cmd_update. A pull that succeeded
# followed by a build that didn't (network, DNS, Ctrl-C -- set -e stops
# update right there) leaves new code on disk and old images running, and
# nothing else ever rebuilds them: `up` only builds images that don't exist
# yet, and a second `update` used to stop at "Already up to date". So build
# everything again -- a no-op from cache when the images are current -- and
# let a plain `up -d` recreate only the containers whose image changed.
rebuild_stale_images() {
    local api_image api_before=""
    require_wanted_services
    if [ -n "${WPDEV_IN_API:-}" ]; then
        # Building api's image from inside it is safe; only recreating
        # wp-api isn't, so compare image IDs and hand that off if needed.
        api_image="$(docker inspect -f '{{.Config.Image}}' wp-api 2>/dev/null)" || true
        api_before="$(docker inspect -f '{{.Image}}' wp-api 2>/dev/null)" || true
        compose_build $(wanted_services) api
    else
        compose_build $(wanted_services)
    fi
    retire_services
    sync_app_version
    docker compose up -d $(wanted_services)
    upgrade_vhosts
    sync_off_pages
    stop_unused_php
    if [ -n "$api_before" ] && { [ "$(docker image inspect -f '{{.Id}}' "$api_image" 2>/dev/null)" != "$api_before" ] || api_is_stale; }; then
        recreate_api_detached "up -d"
    fi
    print_info "Images are current."
}

# Read-only counterpart to cmd_update -- fetches and reports whether
# there's anything to pull, without touching the working tree or any
# container. Exit code is the signal a caller (the dashboard, via the api
# service) actually needs: 0 up to date, 2 update available, 1 a real
# error (no git checkout, no upstream, fetch failed) -- distinct from 0/2
# so neither can be mistaken for the other on a network hiccup.
# The last update check's answer (KEY=value, as --porcelain prints it), so
# `up` and `status` can mention an update without fetching every time.
UPDATE_CHECK_CACHE=".wpdev/update-check"
UPDATE_NOTICE_EVERY=$((24 * 3600))

# KEY=value lines describing this checkout against origin, then one
# CHANGE=<title> per incoming change (newest first, at most 50): a merged
# pull request's title, or a plain commit's subject. Expects a fresh fetch.
update_check_porcelain() {
    local remote_rev="$1" behind ahead current current_tag latest_tag dirty branch
    current="$(git describe --tags --always --dirty 2>/dev/null)" || current="unknown"
    current_tag="$(git describe --tags --abbrev=0 2>/dev/null)" || current_tag=""
    # From origin's tag list rather than local tags: install.sh's clone is
    # shallow and may not have fetched them.
    latest_tag="$(git ls-remote --tags --refs origin 'v*' 2>/dev/null | sed 's#.*refs/tags/##' | sort -V | tail -n1)"
    behind="$(git rev-list --count "HEAD..${remote_rev}")"
    ahead="$(git rev-list --count "${remote_rev}..HEAD")"
    dirty="$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
    echo "CURRENT=${current}"
    echo "CURRENT_TAG=${current_tag}"
    echo "LATEST_TAG=${latest_tag}"
    echo "BEHIND=${behind}"
    echo "AHEAD=${ahead}"
    echo "DIRTY=${dirty}"
    echo "BRANCH=${branch}"
    echo "REMOTE=$(git remote get-url origin 2>/dev/null)"
    echo "CHECKED_AT=$(date +%s)"
    # --first-parent: one line per merged pull request, whose title is the
    # first line of the merge's body ("Merge pull request #42 from …" is
    # its subject). %x1f separates the two.
    git log --first-parent --format='%s%x1f%b%x1e' -n 50 "HEAD..${remote_rev}" 2>/dev/null \
        | awk 'BEGIN { RS = "\036"; FS = "\037" }
            NF {
                subject = $1; sub(/^\n+/, "", subject)
                body = $2; sub(/^\n+/, "", body); split(body, lines, "\n")
                title = subject
                if (subject ~ /^Merge pull request #[0-9]+/ && lines[1] != "") {
                    match(subject, /#[0-9]+/)
                    title = lines[1] " (" substr(subject, RSTART, RLENGTH) ")"
                }
                if (title != "") print "CHANGE=" title
            }'
}

cmd_update_check() {
    local porcelain=0 a remote_rev out behind latest current
    for a in "$@"; do
        case "$a" in
            --porcelain) porcelain=1 ;;
            *) print_error "Unknown option: ${a}" ;;
        esac
    done
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || print_error "Not a git checkout -- can't check for updates. Re-clone from https://github.com/itsomidho/wp-local-dev."

    git fetch origin --quiet || print_error "git fetch failed -- check network connectivity."

    remote_rev="$(git rev-parse '@{u}' 2>/dev/null)" || print_error "Current branch has no upstream configured (git branch --set-upstream-to=origin/<branch>)."

    out="$(update_check_porcelain "$remote_rev")"
    mkdir -p "$(dirname "$UPDATE_CHECK_CACHE")"
    printf '%s\n' "$out" > "$UPDATE_CHECK_CACHE"

    # Commits reachable from upstream but not HEAD -- not a plain
    # local-rev-vs-remote-rev equality check, which would wrongly call a
    # checkout that's ahead of (or diverged from) origin "update available"
    # too. This is also the exact question `wpdev update`'s `pull --ff-only`
    # answers by actually pulling -- this just asks it without doing it.
    behind="$(sed -n 's/^BEHIND=//p' <<<"$out")"
    if [ "$porcelain" -eq 1 ]; then
        echo "$out"
    elif [ "$behind" -eq 0 ]; then
        echo "Up to date ($(sed -n 's/^CURRENT=//p' <<<"$out"))."
    else
        current="$(sed -n 's/^CURRENT=//p' <<<"$out")"
        latest="$(sed -n 's/^LATEST_TAG=//p' <<<"$out")"
        latest="$(git describe --tags --always "$remote_rev" 2>/dev/null || echo "${latest:-$remote_rev}")"
        echo "Update available: ${latest} (currently ${current}, ${behind} commit(s) behind)."
        sed -n 's/^CHANGE=/  - /p' <<<"$out" | head -n 10
        [ "$(grep -c '^CHANGE=' <<<"$out")" -le 10 ] || echo "  …"
        echo "Run: wpdev update"
    fi
    [ "$behind" -eq 0 ] && exit 0
    exit 2
}

# One line after `up` / `status` when origin has something newer, from the
# cached check -- refreshed (quietly, 15s at most) once it's a day old.
# WPDEV_UPDATE_CHECK=off in .env (or the environment) turns it off.
update_notice() {
    local checked now behind latest
    [ -z "${WPDEV_IN_API:-}" ] || return 0
    [ "${WPDEV_UPDATE_CHECK:-$(grep -s '^WPDEV_UPDATE_CHECK=' .env | cut -d= -f2-)}" != "off" ] || return 0
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    now="$(date +%s)"
    # `|| true`: no cache yet (a fresh clone) makes sed fail, and under
    # set -e that would end `up` itself.
    checked="$(sed -n 's/^CHECKED_AT=//p' "$UPDATE_CHECK_CACHE" 2>/dev/null || true)"
    if [ -z "$checked" ] || [ $((now - checked)) -ge "$UPDATE_NOTICE_EVERY" ]; then
        timeout 15 "$SCRIPT_DIR/wpdev" update-check --porcelain >/dev/null 2>&1 || true
    fi
    behind="$(sed -n 's/^BEHIND=//p' "$UPDATE_CHECK_CACHE" 2>/dev/null || true)"
    [ -n "$behind" ] && [ "$behind" -gt 0 ] 2>/dev/null || return 0
    latest="$(sed -n 's/^LATEST_TAG=//p' "$UPDATE_CHECK_CACHE" 2>/dev/null || true)"
    echo ""
    echo -e "${BLUE}↑${NC} wp-local-dev has an update${latest:+ (latest release ${latest})}: ${behind} new change(s). See them with: wpdev update-check -- install with: wpdev update"
}
# 1 when MySQL answers, 2 when its container runs but the server doesn't
# answer yet (just started or restarted: the entrypoint's first seconds,
# or a first run's initialisation), 0 when the container isn't running.
# Telling 2 from 1 keeps a restart from reading as every database FAILing.
# ping succeeds even when the password is refused -- it asks only whether
# the server is up -- and over TCP, which the init-time server doesn't
# listen on.
mysql_state() {
    if ! docker compose exec -T mysql true </dev/null >/dev/null 2>&1; then
        echo 0
    elif docker compose exec -T mysql mysqladmin ping -h127.0.0.1 --silent </dev/null >/dev/null 2>&1; then
        echo 1
    else
        echo 2
    fi
}

# One row of `status`'s site table. Run once per site, in parallel (see
# cmd_status) -- each row's checks are independent, and the slow one, `wp
# redis status`, boots WordPress, so doing sites one after another made
# status take seconds per site.
status_site_row() {
    local domain="$1" mysql_up="$2" mysql_version="$3"
    local site_name config php_version php_svc http_code db_status db_name php_reachable cache_status wp_version
    site_name="$(site_name_of "$domain")"
    config="sites/${site_name}/wp-config.php"
    php_version="$(site_get "$site_name" PHP_VERSION)"
    [ -z "$php_version" ] && php_version="$DEFAULT_PHP_VERSION"
    php_svc="$(php_slug "$php_version")"

    # Switched off: nginx answers with the "this site is off" page and its
    # PHP may well be stopped, so there's nothing to probe. "off" in the
    # HTTP column is what the dashboard reads.
    if site_is_off "$site_name"; then
        http_code="off"
    else
        http_code="$(site_http_code "$domain")"
    fi

    db_status="n/a"
    if [ -f "$config" ] && [ "$mysql_up" -eq 1 ] && [ -n "${DB_ROOT_PASSWORD:-}" ]; then
        db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
        if docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "USE \`${db_name}\`;" </dev/null >/dev/null 2>&1; then
            db_status="OK"
        else
            db_status="FAIL"
        fi
    elif [ "$mysql_up" -eq 2 ]; then
        db_status="starting"
    elif [ "$mysql_up" -ne 1 ]; then
        db_status="down"
    fi

    php_reachable=0
    if [ "$http_code" != "off" ] && [ -f "$config" ] && php_exec "$php_svc" true </dev/null >/dev/null 2>&1; then
        php_reachable=1
    fi

    cache_status="n/a"
    if [ "$php_reachable" -eq 1 ]; then
        cache_status="$(php_exec "$php_svc" wp redis status --path="/var/www/${site_name}" --allow-root </dev/null 2>/dev/null | grep "^Status:" | awk '{print $2}')"
        [ -z "$cache_status" ] && cache_status="off"
    fi

    # Straight from the core's own version.php when it's where WordPress
    # keeps it -- the same answer `wp core version` gives (it reads this
    # file), without starting a container process for it. WP-CLI only for
    # a layout where it isn't.
    wp_version="n/a"
    if [ -f "sites/${site_name}/wp-includes/version.php" ]; then
        wp_version="$(sed -n "s/^\$wp_version = '\([^']*\)';.*/\1/p" "sites/${site_name}/wp-includes/version.php" | head -1)"
    fi
    if [ -z "$wp_version" ] || [ "$wp_version" = "n/a" ]; then
        wp_version="n/a"
        if [ "$php_reachable" -eq 1 ]; then
            wp_version="$(php_exec "$php_svc" wp core version --path="/var/www/${site_name}" --allow-root </dev/null 2>/dev/null)"
            [ -z "$wp_version" ] && wp_version="n/a"
        fi
    fi
    printf "%-28s %-6s %-9s %-9s %-6s %-10s %s\n" "$domain" "$php_version" "$wp_version" "$mysql_version" "$http_code" "$db_status" "$cache_status"
}

cmd_status() {
    docker compose ps
    echo ""
    print_header "=== Sites ==="

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        echo "No sites configured yet. Run: wpdev add"
        return
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi

    # `cmd && var=1` here would abort this whole command under `set -e` if
    # the container is transiently unreachable — a status dashboard must
    # never die on the thing it's trying to report as down.
    mysql_up="$(mysql_state)"

    # One shared MySQL server for every site, so its version is the same on
    # every row -- fetched once here rather than once per site in the loop.
    mysql_version="n/a"
    if [ "$mysql_up" -eq 1 ] && [ -n "${DB_ROOT_PASSWORD:-}" ]; then
        mysql_version="$(docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -N -e "SELECT VERSION();" </dev/null 2>/dev/null | tr -d '[:space:]')"
        [ -z "$mysql_version" ] && mysql_version="n/a"
    fi

    printf "%-28s %-6s %-9s %-9s %-6s %-10s %s\n" "DOMAIN" "PHP" "WP" "MYSQL" "HTTP" "DATABASE" "CACHE"
    # Rows are checked in parallel, at most 6 sites at a time, each into its
    # own file, then printed in the usual order.
    # A row whose checks died part way (set -e in its subshell) still shows
    # up, as unknowns, rather than silently dropping out of the table.
    local rows i=0 j row_domains=()
    rows="$(mktemp -d)"
    for domain in $domains; do
        row_domains+=("$domain")
        status_site_row "$domain" "$mysql_up" "$mysql_version" >"${rows}/${i}" 2>/dev/null &
        i=$((i + 1))
        if [ $((i % 6)) -eq 0 ]; then wait; fi
    done
    wait
    for ((j = 0; j < i; j++)); do
        if [ -s "${rows}/${j}" ]; then
            cat "${rows}/${j}"
        else
            printf "%-28s %-6s %-9s %-9s %-6s %-10s %s\n" "${row_domains[$j]}" "?" "?" "$mysql_version" "?" "?" "?"
        fi
    done
    rm -rf "$rows"
    update_notice || true
}

cmd_doctor() {
    warnings=0
    fails=0

    print_header "=== Stack ==="

    if docker info >/dev/null 2>&1; then
        print_info "Docker daemon is reachable"
    else
        print_fail "Docker daemon is not reachable — is Docker running?"
        fails=$((fails + 1))
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
        if [ -n "${DB_ROOT_PASSWORD:-}" ]; then
            print_info ".env exists, DB_ROOT_PASSWORD is set"
        else
            print_fail ".env exists but DB_ROOT_PASSWORD is empty"
            fails=$((fails + 1))
        fi
    else
        print_warning ".env doesn't exist yet — created automatically on next 'wpdev add', or copy .env.example yourself"
        warnings=$((warnings + 1))
    fi

    # PHP: only the versions some site uses are expected to run (see
    # php_versions_in_use); the rest are started on demand.
    expected_containers="wp-mysql wp-redis wp-mailpit wp-nginx wp-adminer wp-api wp-dashboard"
    for v in $(php_versions_in_use); do
        expected_containers="$expected_containers wp-$(php_slug "$v")"
    done
    for c in $expected_containers; do
        # || true: docker inspect exits nonzero for a container that doesn't
        # exist at all (e.g. adminer, which `wpdev add` never
        # starts) -- a bare assignment like this one is NOT exempt from
        # set -e the way `cmd1 && cmd2` is, so without this the whole
        # script aborts right here instead of reaching the `-z "$state"`
        # branch below that's meant to handle exactly this case.
        state="$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null)" || true
        if [ "$state" = "running" ]; then
            print_info "${c} is running"
        elif [ -z "$state" ]; then
            print_warning "${c} doesn't exist yet — run: wpdev up"
            warnings=$((warnings + 1))
        else
            print_fail "${c} exists but isn't running (state: ${state}) — check: docker logs ${c}"
            fails=$((fails + 1))
        fi
    done

    # Another PHP version's container isn't an orphan -- just not needed.
    known_containers="$expected_containers"
    for v in $SUPPORTED_PHP_VERSIONS; do
        known_containers="$known_containers wp-$(php_slug "$v")"
    done
    orphans="$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep '^wp-' | grep -vFx -f <(echo "$known_containers" | tr ' ' '\n') || true)"
    if [ -n "$orphans" ]; then
        print_warning "Orphaned wp-* containers not in the current stack (leftover from a renamed/removed service):"
        echo "$orphans" | sed 's/^/    /'
        echo "    Remove with: docker rm -f <name>"
        warnings=$((warnings + 1))
    else
        print_info "No orphaned containers"
    fi

    idle_php=""
    for v in $SUPPORTED_PHP_VERSIONS; do
        case " $expected_containers " in *" wp-$(php_slug "$v") "*) continue ;; esac
        docker inspect "wp-$(php_slug "$v")" >/dev/null 2>&1 && idle_php="${idle_php} ${v}"
    done
    if [ -n "$idle_php" ]; then
        idle_php="$(echo $idle_php | sed 's/ /, /g')"
        case "$idle_php" in
            *,*) print_warning "PHP ${idle_php} are running, but no site uses them — 'wpdev up' stops them" ;;
            *) print_warning "PHP ${idle_php} is running, but no site uses it — 'wpdev up' stops it" ;;
        esac
        warnings=$((warnings + 1))
    fi
    print_info "PHP in use: $(php_versions_in_use | tr '\n' ' ' | sed 's/ $//; s/^$/none (no sites yet)/')"

    for v in $SUPPORTED_PHP_VERSIONS; do
        svc="$(php_slug "$v")"
        [ "$(docker inspect -f '{{.State.Status}}' "wp-${svc}" 2>/dev/null)" = "running" ] || continue
        if ! php_runs_as_you "$svc"; then
            print_warning "wp-${svc} runs PHP as a different user than you ($(id -u)) — files WordPress writes won't be yours. Run: wpdev up"
            warnings=$((warnings + 1))
        fi
    done

    leftovers="$(recreate_leftovers)"
    if [ -n "$leftovers" ]; then
        print_warning "Containers left behind by an interrupted recreate (compose's <id>_<name> temporaries):"
        echo "$leftovers" | sed 's/^/    /'
        echo "    Remove with: docker rm -f $(echo "$leftovers" | awk '{print $1}' | tr '\n' ' ')(wpdev up removes never-started ones itself)"
        warnings=$((warnings + 1))
    fi

    if command -v mkcert >/dev/null 2>&1; then
        # || true: same set -e gotcha as elsewhere -- mkcert -CAROOT failing
        # (unlikely, but possible if mkcert is installed yet not fully
        # functional) shouldn't silently abort the rest of doctor's checks.
        caroot="$(mkcert -CAROOT 2>/dev/null)" || true
        if [ -f "${caroot}/rootCA.pem" ]; then
            print_info "mkcert local CA exists (${caroot})"
        else
            print_warning "mkcert is installed but no local CA found — run: wpdev install-mkcert"
            warnings=$((warnings + 1))
        fi
    else
        print_warning "mkcert isn't installed — run: wpdev install-mkcert"
        warnings=$((warnings + 1))
    fi

    if [ -d docker ]; then
        print_warning "Stray docker/ directory at the repo root (unused, likely leftover from a past mistake) — remove with: sudo rm -rf docker/"
        warnings=$((warnings + 1))
    fi

    du_sites="$(du -sh sites 2>/dev/null | cut -f1)"
    [ -n "$du_sites" ] && echo "  Disk: sites/ = ${du_sites:-0}"

    echo ""
    print_header "=== Host environment ==="

    helper="$(stale_creds_helper)"
    if [ -n "$helper" ]; then
        print_fail "~/.docker/config.json asks for 'docker-credential-${helper}', which isn't installed — image pulls fail before reaching the registry. 'wpdev up' repairs this for you, or drop the \"credsStore\" line from ${DOCKER_CONFIG_JSON}"
        fails=$((fails + 1))
    else
        print_info "Docker credential config is usable"
    fi

    dead_proxy="$(unreachable_build_proxy)"
    if [ -n "$dead_proxy" ]; then
        print_fail "Build proxy ${dead_proxy} is configured but not accepting connections — image builds inherit it as HTTP_PROXY and will fail rather than connect directly. Start it, or unset HTTP_PROXY/HTTPS_PROXY."
        fails=$((fails + 1))
    else
        print_info "No dead build proxy in the way"
    fi

    reg_proxy="$(daemon_missing_registry_proxy)"
    if [ -n "$reg_proxy" ]; then
        print_warning "Builds use proxy ${reg_proxy}, but the Docker daemon has none — so image pulls (every FROM) go direct. On a network that throttles Docker Hub that shows up as very slow pulls and \"connection reset by peer\". Add a \"proxies\" block to /etc/docker/daemon.json to route pulls through it too."
        warnings=$((warnings + 1))
    fi

    # Asked in this order deliberately: a container with no outbound route
    # at all would also fail every DNS check, and reporting that as a
    # resolver problem sends you off to fix the wrong thing.
    case "$(container_reachability)" in
        offline)
            hijacked="$(hijacked_bridge_routes)"
            if [ -n "$hijacked" ]; then
                tunnel="$(echo "$hijacked" | awk '{print $3; exit}')"
                print_fail "Containers have no outbound connectivity — the host routes Docker's bridge subnets into ${tunnel}, so replies to containers go into the VPN instead of the bridge. Not a DNS problem."
                echo "$hijacked" | while read -r name subnet dev; do
                    echo "    ${name} (${subnet}) → ${dev}"
                done
                echo "    Fix it (one-time, needs sudo): wpdev fix-vpn-network — 'wpdev up' also does this for you."
            else
                print_fail "Containers have no outbound connectivity — a bridge-network container can't reach its own gateway. Not a DNS problem: look at the host firewall, or a VPN client enforcing tunnel-all against 172.16.0.0/12."
                if pgrep -x vpnagentd >/dev/null 2>&1; then
                    echo "    Cisco Secure Client (vpnagentd) is running — disconnect it and re-run this to confirm."
                fi
            fi
            fails=$((fails + 1))
            ;;
        dns)
            tunnel_dns="$(vpn_dns_unreachable_from_containers)"
            if [ -n "$tunnel_dns" ]; then
                print_fail "Host DNS is ${tunnel_dns} — a VPN resolver containers can't route to, so builds and in-container downloads time out while 'docker pull' still works. 'wpdev up' repairs this automatically, or run it now: wpdev fix-dns"
            else
                print_fail "Containers can reach the network but can't resolve names — check 'resolvectl status' and /etc/docker/daemon.json's \"dns\""
            fi
            fails=$((fails + 1))
            ;;
        *)
            print_info "Containers can resolve names and reach the network"
            ;;
    esac

    echo ""
    print_header "=== Sites ==="

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        echo "No sites configured yet. Run: wpdev add"
    else
        if [ -f .env ]; then
            set -a
            # shellcheck disable=SC1091
            source .env
            set +a
        fi
        mysql_up="$(mysql_state)"

        for domain in $domains; do
            site_name="$(site_name_of "$domain")"
            config="sites/${site_name}/wp-config.php"

            echo "${domain}:"

            if site_is_off "$site_name"; then
                print_info "  Switched off ($(off_description "$site_name")) — wpdev on ${site_name}"
            fi

            if grep -q "[[:space:]]${domain}$" /etc/hosts 2>/dev/null || grep -q "[[:space:]]${domain}[[:space:]]" /etc/hosts 2>/dev/null; then
                print_info "  /etc/hosts entry present"
            else
                print_warning "  Missing /etc/hosts entry — run: wpdev hosts"
                warnings=$((warnings + 1))
            fi

            if [ -d "sites/${site_name}" ]; then
                foreign="$(foreign_files "$site_name" | wc -l)"
                if [ "$foreign" -eq 0 ]; then
                    print_info "  Files are all yours and writable"
                else
                    [ "$foreign" -ge 1000 ] && foreign="1000+"
                    print_warning "  ${foreign} path(s) under sites/${site_name} aren't owned by you or aren't writable — wp-admin updates and your editor can fail. Run: wpdev fix-perms ${site_name}"
                    warnings=$((warnings + 1))
                fi
            fi

            if [ -f "nginx/ssl/certs/${domain}.pem" ] && [ -f "nginx/ssl/private/${domain}-key.pem" ]; then
                problem="$(cert_problem "$domain")"
                if [ -z "$problem" ]; then
                    print_info "  SSL certificate present"
                else
                    print_warning "  SSL certificate ${problem} — run: wpdev cert ${site_name}"
                    warnings=$((warnings + 1))
                fi
            else
                print_fail "  Missing SSL certificate — run: wpdev add --domain=${domain} --repair"
                fails=$((fails + 1))
            fi

            admin="$(site_admin_domain "$site_name")"
            if [ -n "$admin" ]; then
                admin_ok=1
                problem="$(cert_problem "$admin")"
                if [ -n "$problem" ]; then
                    print_warning "  Admin domain ${admin}: SSL certificate ${problem} — run: wpdev cert ${site_name}"
                    warnings=$((warnings + 1)); admin_ok=0
                fi
                if ! in_hosts_file "$admin"; then
                    print_warning "  Admin domain ${admin}: missing /etc/hosts entry — run: wpdev hosts"
                    warnings=$((warnings + 1)); admin_ok=0
                fi
                if [ -z "$(admin_domain_plugin_path "$site_name")" ] && [ -f "$config" ] \
                    && ! grep -rqs "WP_ADMIN_DOMAIN" "sites/${site_name}/wp-content/mu-plugins" "$config" "sites/${site_name}/.env"; then
                    print_warning "  Admin domain ${admin}: nothing rewrites wp-admin's URLs to it (no WP_ADMIN_DOMAIN code, and wpdev's mu-plugin is missing) — run: wpdev admin-domain ${site_name} on"
                    warnings=$((warnings + 1)); admin_ok=0
                fi
                if [ "$admin_ok" = 1 ]; then
                    print_info "  Admin domain ${admin} set up"
                fi
            fi

            if [ ! -f "$config" ]; then
                print_fail "  No wp-config.php (checked ${config})"
                fails=$((fails + 1))
                continue
            fi

            if [ "$mysql_up" -eq 2 ]; then
                print_warning "  Can't check database — MySQL is still starting; run doctor again in a few seconds"
                warnings=$((warnings + 1))
                continue
            fi
            if [ "$mysql_up" -ne 1 ]; then
                print_warning "  Can't check database — MySQL isn't running"
                warnings=$((warnings + 1))
                continue
            fi

            db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
            # COUNT(*) alone can't tell "schema doesn't exist" from "schema
            # exists but is empty" — both return 0. Check existence first
            # (this is exactly the class of bug that caused the wp-lab
            # incident: a wp-config.php pointing at a database that silently
            # isn't there).
            db_exists="$(docker compose exec -T mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" -N -e "SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name='${db_name}';" </dev/null 2>/dev/null | tr -d '[:space:]')"
            if [ "$db_exists" != "1" ]; then
                print_fail "  Database '${db_name}' (from wp-config.php) doesn't exist"
                fails=$((fails + 1))
            else
                table_count="$(docker compose exec -T mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${db_name}';" </dev/null 2>/dev/null | tr -d '[:space:]')"
                if [ "${table_count:-0}" -eq 0 ]; then
                    print_warning "  Database '${db_name}' exists but has 0 tables — looks unprovisioned or broken"
                    warnings=$((warnings + 1))
                else
                    print_info "  Database '${db_name}' OK (${table_count} tables)"
                fi
            fi
        done
    fi

    echo ""
    if [ "$fails" -eq 0 ] && [ "$warnings" -eq 0 ]; then
        print_info "Everything checks out."
    else
        print_header "=== Summary ==="
        [ "$fails" -gt 0 ] && print_fail "${fails} thing(s) need fixing"
        [ "$warnings" -gt 0 ] && print_warning "${warnings} thing(s) worth a look"
    fi
}

cmd_logs() {
    local service="" tail="all" arg
    for arg in "$@"; do
        case "$arg" in
            --tail=*) tail="${arg#--tail=}" ;;
            *) service="$arg" ;;
        esac
    done
    case "$tail" in
        all|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]) ;;
        *) print_error "Invalid --tail value '${tail}' (a number, or all)" ;;
    esac
    # exec, so a SIGTERM to wpdev (the api does that when the dashboard
    # closes its log view) reaches the follower itself -- without it bash
    # exits and leaves `docker compose logs -f` running forever.
    if [ -n "$service" ]; then
        exec docker compose logs -f --tail="$tail" "$service"
    else
        exec docker compose logs -f --tail="$tail"
    fi
}

# ---------------------------------------------------------------------------
# Docker resources (the dashboard's Docker page): stats, images, volumes and
# container details, for this project only -- never another project's
# images or volumes, so nothing here can delete something unrelated.
# Everything reads Docker's own output; --json emits one JSON object per
# line (built with Docker's own --format templates, so no jq needed).
# ---------------------------------------------------------------------------

compose_project() {
    local name
    name="$(docker compose config 2>/dev/null | sed -n 's/^name: //p' | head -1)"
    [ -n "$name" ] || name="${COMPOSE_PROJECT_NAME:-$(basename "$SCRIPT_DIR")}"
    echo "$name"
}

human_bytes() {
    awk -v b="$1" 'BEGIN { split("B KB MB GB TB", u); i = 1; while (b >= 1000 && i < 5) { b /= 1000; i++ } printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i] }'
}

cmd_stats() {
    local ids
    ids="$(docker compose ps -q 2>/dev/null)"
    [ -n "$ids" ] || print_error "No containers running. Start the stack with: wpdev up"
    if [ "${1:-}" = "--json" ]; then
        # shellcheck disable=SC2086
        docker stats --no-stream --format '{{json .}}' $ids
    else
        # shellcheck disable=SC2086
        docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}\t{{.PIDs}}' $ids
    fi
}

# Image IDs that belong to this project: what docker-compose.yml runs
# (pulled or built), anything compose built for it (they carry its project
# label, including old builds left dangling by a rebuild), and dangling
# leftovers of the images it pulls (an old mysql:8.0 after a re-pull).
project_image_ids() {
    local project ref repo id repos
    project="$(compose_project)"
    {
        docker images -q --filter "label=com.docker.compose.project=${project}"
        # Asked for separately: newer Docker leaves untagged images out of
        # a plain `docker images`, even with a label filter.
        docker images -q --filter dangling=true --filter "label=com.docker.compose.project=${project}"
        for ref in $(docker compose config --images 2>/dev/null); do
            docker images -q "$ref"
        done
        repos=" $(docker compose config --images 2>/dev/null | sed -E 's/:[^:/]+$//' | tr '\n' ' ') "
        for id in $(docker images -q --filter dangling=true); do
            repo="$(docker image inspect --format '{{range .RepoDigests}}{{.}} {{end}}' "$id" 2>/dev/null | awk '{print $1}' | sed 's/@.*//')"
            [ -n "$repo" ] && case "$repos" in *" ${repo} "*) echo "$id" ;; esac
        done
    } | sort -u
}

# Disk used by all images, in bytes, from `docker system df`.
images_disk_bytes() {
    docker system df --format '{{.Type}} {{.Size}}' 2>/dev/null | awk '$1 == "Images" {
        v = $2; n = v + 0; u = v; sub(/^[0-9.]+/, "", u)
        m = (u == "kB" || u == "KB") ? 1e3 : (u == "MB") ? 1e6 : (u == "GB") ? 1e9 : (u == "TB") ? 1e12 : 1
        printf "%d\n", n * m }'
}

cmd_images() {
    case "${1:-}" in
        rm)
            local id="${2:-}"
            [ -n "$id" ] || print_error "Usage: wpdev images rm <image-id>"
            local full
            full="$(docker image inspect --format '{{.Id}}' "$id" 2>/dev/null)" || print_error "No image '${id}'."
            project_image_ids | while read -r own; do
                [ "$(docker image inspect --format '{{.Id}}' "$own")" = "$full" ] && echo yes
            done | grep -q yes || print_error "Image '${id}' isn't one of this project's — wpdev only removes its own."
            # No --force: Docker refuses an image a container still uses,
            # which is exactly the protection wanted here.
            docker rmi "$full"
            print_info "Removed image ${id}."
            return
            ;;
        prune)
            # Freed space is measured, not summed: images share layers, so
            # adding up their sizes overstates what removing them frees.
            local before after id removed=0
            before="$(images_disk_bytes)"
            for id in $(project_image_ids); do
                [ "$(docker image inspect --format '{{len .RepoTags}}' "$id" 2>/dev/null)" = "0" ] || continue
                docker ps -aq --filter "ancestor=${id}" | grep -q . && continue
                if docker rmi "$id" >/dev/null 2>&1; then
                    removed=$((removed + 1))
                    echo "Removed $(echo "$id" | sed 's/^sha256://' | cut -c1-12)"
                fi
            done
            after="$(images_disk_bytes)"
            print_info "Removed ${removed} unused untagged image(s) of this project, freed $(human_bytes $((before > after ? before - after : 0)))."
            return
            ;;
        ""|--json) ;;
        *) print_error "Usage: wpdev images [--json] | images rm <image-id> | images prune" ;;
    esac

    local ids usage
    ids="$(project_image_ids)"
    [ -n "$ids" ] || { echo "No images for this project yet."; return; }
    # image id -> containers using it, one docker call for all of them.
    usage="$(docker ps -aq | xargs -r docker inspect --format '{{.Image}} {{slice .Name 1}}' 2>/dev/null)"

    if [ "${1:-}" = "--json" ]; then
        local line id used
        # shellcheck disable=SC2086
        docker image inspect --format '{{.Id}}|{"id":{{json .Id}},"tags":{{json .RepoTags}},"size":{{.Size}},"created":{{json .Created}}' $ids |
        while IFS='|' read -r id line; do
            used="$(echo "$usage" | awk -v i="$id" '$1 == i { print $2 }' | paste -sd, -)"
            echo "${line},\"usedBy\":\"${used}\"}"
        done
    else
        printf "%-44s %-14s %-10s %-12s %s\n" "IMAGE" "ID" "SIZE" "CREATED" "USED BY"
        local id tags size created used
        # shellcheck disable=SC2086
        docker image inspect --format '{{.Id}} {{if .RepoTags}}{{index .RepoTags 0}}{{else}}<untagged>{{end}} {{.Size}} {{slice .Created 0 10}}' $ids |
        while read -r id tags size created; do
            used="$(echo "$usage" | awk -v i="$id" '$1 == i { print $2 }' | paste -sd, -)"
            printf "%-44s %-14s %-10s %-12s %s\n" "$tags" "$(echo "$id" | sed 's/^sha256://' | cut -c1-12)" "$(human_bytes "$size")" "$created" "${used:--}"
        done
    fi
}

cmd_volumes() {
    local project
    project="$(compose_project)"
    case "${1:-}" in
        rm)
            local name="${2:-}" yes=""
            [ "${3:-}" = "--yes" ] && yes=1
            [ -n "$name" ] || print_error "Usage: wpdev volumes rm <volume> [--yes]"
            [ "$(docker volume inspect --format '{{index .Labels "com.docker.compose.project"}}' "$name" 2>/dev/null)" = "$project" ] \
                || print_error "Volume '${name}' isn't one of this project's — wpdev only removes its own."
            if docker ps -aq --filter "volume=${name}" | grep -q .; then
                print_error "Volume '${name}' is still used by: $(docker ps -a --filter "volume=${name}" --format '{{.Names}}' | paste -sd, -). Remove that container first."
            fi
            if [ -z "$yes" ]; then
                print_warning "This permanently deletes everything stored in ${name}."
                read -r -p "Type the volume name to confirm: " answer
                [ "$answer" = "$name" ] || cancelled
            fi
            docker volume rm "$name" >/dev/null
            print_info "Removed volume ${name}."
            return
            ;;
        ""|--json) ;;
        *) print_error "Usage: wpdev volumes [--json] | volumes rm <volume> [--yes]" ;;
    esac

    local names sizes
    names="$(docker volume ls -q --filter "label=com.docker.compose.project=${project}")"
    [ -n "$names" ] || { echo "No volumes for this project."; return; }
    # Sizes come from `docker system df -v`'s volume table (name, links, size).
    sizes="$(docker system df -v 2>/dev/null | awk '/^Local Volumes space usage:/ { on = 1; next } on && /^$/ && seen { exit } on && NF >= 3 && $1 != "VOLUME" { seen = 1; print $1, $NF }')"

    local name size used short created
    if [ "${1:-}" != "--json" ]; then
        printf "%-36s %-10s %s\n" "VOLUME" "SIZE" "USED BY"
    fi
    for name in $names; do
        size="$(echo "$sizes" | awk -v n="$name" '$1 == n { print $2 }')"
        used="$(docker ps -a --filter "volume=${name}" --format '{{.Names}}' | paste -sd, -)"
        if [ "${1:-}" = "--json" ]; then
            short="$(docker volume inspect --format '{{index .Labels "com.docker.compose.volume"}}' "$name")"
            created="$(docker volume inspect --format '{{.CreatedAt}}' "$name")"
            printf '{"name":"%s","volume":"%s","size":"%s","usedBy":"%s","created":"%s"}\n' "$name" "$short" "${size:-}" "$used" "$created"
        else
            printf "%-36s %-10s %s\n" "$name" "${size:-?}" "${used:--}"
        fi
    done
}

# `docker inspect` for one service's container, with any environment
# variable whose name looks like a secret masked -- the dashboard shows
# this, and a password has no business reaching a browser.
cmd_inspect() {
    local svc="${1:-}" id
    [ -n "$svc" ] || print_error "Usage: wpdev inspect <service>"
    docker compose config --services 2>/dev/null | grep -qx -- "$svc" || print_error "Unknown service '${svc}'."
    id="$(docker compose ps -aq "$svc" 2>/dev/null | head -1)"
    [ -n "$id" ] || print_error "Service '${svc}' has no container. Start it with: wpdev up"
    docker inspect "$id" | sed -E 's/^([[:space:]]*"[A-Za-z0-9_]*([Pp][Aa][Ss][Ss]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Kk][Ee][Yy]|[Ss][Aa][Ll][Tt]|[Aa][Uu][Tt][Hh]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee])[A-Za-z0-9_]*=)[^"]*"/\1********"/'
}

cmd_shell() {
    case "$1" in
        php)
            version="${2:-$DEFAULT_PHP_VERSION}"
            case " $SUPPORTED_PHP_VERSIONS " in
                *" $version "*) ;;
                *) print_error "Unknown PHP version '${version}'. Supported: $SUPPORTED_PHP_VERSIONS" ;;
            esac
            # Started if no site uses this version yet (the next `wpdev up`
            # stops it again). As www-data (= you, see php/entrypoint.sh), so
            # a composer install or a file you create in here is yours on the
            # host. For root: docker exec -it wp-phpXX sh
            ensure_php_running "$(php_slug "$version")"
            docker exec -it -u www-data -w /var/www "wp-$(php_slug "$version")" sh
            ;;
        db) docker exec -it wp-mysql bash ;;
        nginx) docker exec -it wp-nginx sh ;;
        redis) docker exec -it wp-redis redis-cli ;;
        *)
            print_warning "Usage: wpdev shell php [version]|db|nginx|redis"
            echo "  wpdev shell php          # default version ($DEFAULT_PHP_VERSION)"
            echo "  wpdev shell php 8.4      # a specific version"
            exit 1
            ;;
    esac
}

cmd_db() {
    site="$1"

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    if [ -z "$site" ]; then
        docker exec -it wp-mysql mysql -uroot -p"$DB_ROOT_PASSWORD"
        return
    fi

    db_pass="$(site_get "$site" DB_PASSWORD)"
    if [ -z "$db_pass" ]; then
        print_warning "No saved DB credentials for '${site}' (checked DB_PASSWORD in $(site_config_file "$site"))."
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi

    db_slug="${site//-/_}"
    db_slug="${db_slug:0:28}"
    db_name="wp_${db_slug}"
    db_user="wp_${db_slug}"

    docker exec -it wp-mysql mysql -u"${db_user}" -p"${db_pass}" "${db_name}"
}

cmd_adminer() {
    site="$1"

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    port="${ADMINER_PORT:-39002}"
    # Server is prefilled by the ADMINER_DEFAULT_SERVER env var on the
    # container itself (docker-compose.yml) — this image doesn't take it as
    # a URL param. username/db here do work as URL params.
    url="http://localhost:${port}/?username=root"
    login_hint="root / \$DB_ROOT_PASSWORD from .env"

    if [ -n "$site" ]; then
        config="sites/${site}/wp-config.php"
        if [ ! -f "$config" ]; then
            print_warning "No wp-config.php for '${site}' (checked ${config})."
            echo "Known sites: $(site_names | tr '\n' ' ')"
            return 1
        fi

        # Read the real DB_NAME/DB_USER out of wp-config.php rather than
        # guessing wp_<slug> — sites not provisioned by `wpdev add` (like
        # ones set up before this tool existed) don't follow that naming.
        db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
        db_user="$(grep "DB_USER" "$config" | sed -E "s/.*DB_USER',[[:space:]]*'([^']*)'.*/\1/")"
        url="http://localhost:${port}/?username=${db_user}&db=${db_name}"

        if [ "$db_user" = "root" ]; then
            login_hint="root / \$DB_ROOT_PASSWORD from .env"
        elif [ -n "$(site_get "$site" DB_PASSWORD)" ]; then
            login_hint="${db_user} / $(site_get "$site" DB_PASSWORD)"
        else
            login_hint="${db_user} / (see DB_PASSWORD in ${config})"
        fi
    fi

    echo "Opening ${url}"
    # A site's DB password is its own user's, not root's -- the form above
    # is prefilled with root, so point at the per-site form instead. On the
    # Login line, since that's the one the dashboard shows.
    [ -z "$site" ] && login_hint="${login_hint} (a site's DB password goes with its own user: wpdev adminer <site>)"
    echo "Login: ${login_hint}"

    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
    elif command -v open >/dev/null 2>&1; then
        open "$url" >/dev/null 2>&1 &
    else
        print_warning "No browser opener found (xdg-open/open) — open the URL above manually."
    fi
}

