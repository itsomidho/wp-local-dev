# ---------------------------------------------------------------------------
# Stack lifecycle
# ---------------------------------------------------------------------------

# Sets (or updates) one KEY=value line in .env, in place. Used by cmd_up to
# keep a handful of host-specific, auto-detected values in sync -- these are
# real host facts (this directory's path, this user's uid/gid, the Docker
# socket's gid), not preferences, so autodetecting and overwriting on every
# `wpdev up` is correct, not just convenient: a value hardcoded once in
# .env.example would be right on exactly one machine and silently wrong
# (wrong uid, wrong docker gid) on every other one, CI included.
set_env_var() {
    key="$1"
    value="$2"
    if grep -q "^${key}=" .env; then
        sed -i "s|^${key}=.*|${key}=${value}|" .env
    else
        echo "${key}=${value}" >> .env
    fi
}

cmd_up() {
    # Group-writable so www-data (PHP-FPM, inside every phpXX container) can
    # create its own top-level dirs here too -- e.g. wp-cli's cache dir
    # (/var/www/.wp-cli), which it otherwise warns about (non-fatal, just
    # slower repeat downloads) every time a plugin install runs as www-data
    # instead of root. A fresh git checkout gets ./sites at whatever mode
    # the checkout's umask produced, so this can't just be committed once.
    chmod g+w sites 2>/dev/null || true

    # Auto-detected values the `api` service (docker-compose.yml) needs --
    # see that file's comments for why each one matters. Keyed off real
    # facts about THIS machine (SCRIPT_DIR, `id -u`/`id -g`, the Docker
    # socket's actual gid), not $PWD or a guess, so this is correct
    # regardless of where `wpdev up` is invoked from and self-heals if any
    # of them ever change (this directory moves, docker.sock's gid differs
    # after a Docker reinstall, etc.).
    if [ -f .env ]; then
        set_env_var PROJECT_DIR "${SCRIPT_DIR}"
        set_env_var API_UID "$(id -u)"
        set_env_var API_GID "$(id -g)"
        docker_gid="$(stat -c '%g' /var/run/docker.sock 2>/dev/null)" || true
        [ -n "$docker_gid" ] && set_env_var DOCKER_GID "$docker_gid"

        # What the dashboard shows as its own version -- nearest tag plus
        # commits-since-and-hash (git describe), not a hand-maintained
        # version file that drifts the moment someone forgets to bump it.
        # `--always` falls back to a bare short hash if this checkout has
        # no tags reachable at all; `|| echo unknown` only fires if git
        # itself fails outright (e.g. .git missing from a tarball install).
        app_version="$(git -C "${SCRIPT_DIR}" describe --tags --always --dirty 2>/dev/null)" || app_version="unknown"
        set_env_var APP_VERSION "$app_version"
    fi

    docker compose up -d
    echo "Containers started. Give MySQL 30 seconds to initialize if this is the first run."
}

cmd_down() { docker compose down; }
cmd_restart() { docker compose restart; }

# Pull the latest wp-local-dev, then rebuild + fully recreate every
# container. The rebuild picks up Dockerfile changes (anything baked into
# the image, like php/crontab); --force-recreate is there because a plain
# `up -d` only restarts a container whose *compose service config* changed
# -- it has no way to know a bind-mounted file's *content* changed (e.g.
# nginx.conf, php/xdebug.ini), so without this, a pulled config fix can
# silently sit on disk unapplied until something else happens to restart
# that container. Discovered the hard way this session with exactly that
# class of bug (a stale bind mount after an in-place file edit).
cmd_update() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || print_error "Not a git checkout -- can't update. Re-clone from https://github.com/itsomidho/wp-local-dev."

    if [ -n "$(git status --porcelain)" ]; then
        print_error "You have uncommitted changes -- commit or stash them first, then run 'wpdev update' again."
    fi

    print_info "Fetching origin..."
    git fetch origin

    local_rev="$(git rev-parse HEAD)"
    remote_rev="$(git rev-parse '@{u}' 2>/dev/null)" || print_error "Current branch has no upstream configured (git branch --set-upstream-to=origin/<branch>)."

    if [ "$local_rev" = "$remote_rev" ]; then
        print_info "Already up to date."
        return
    fi

    # --ff-only: never auto-merge or rewrite local commits. If history has
    # diverged, this fails loudly instead of guessing what you want.
    if ! git pull --ff-only; then
        print_error "Can't fast-forward -- your branch has local commits origin doesn't have. Resolve manually (e.g. git rebase origin/main), then run 'wpdev update' again."
    fi

    echo
    echo "Updated:"
    git log --oneline "${local_rev}..HEAD"
    echo

    print_info "Rebuilding images and recreating containers to apply changes..."
    docker compose build
    docker compose up -d --force-recreate
    print_info "Update complete."
}

# Read-only counterpart to cmd_update -- fetches and reports whether
# there's anything to pull, without touching the working tree or any
# container. Exit code is the signal a caller (the dashboard, via the api
# service) actually needs: 0 up to date, 2 update available, 1 a real
# error (no git checkout, no upstream, fetch failed) -- distinct from 0/2
# so neither can be mistaken for the other on a network hiccup.
cmd_update_check() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || print_error "Not a git checkout -- can't check for updates. Re-clone from https://github.com/itsomidho/wp-local-dev."

    git fetch origin --quiet || print_error "git fetch failed -- check network connectivity."

    remote_rev="$(git rev-parse '@{u}' 2>/dev/null)" || print_error "Current branch has no upstream configured (git branch --set-upstream-to=origin/<branch>)."
    current_version="$(git describe --tags --always --dirty 2>/dev/null)" || current_version="unknown"

    # Commits reachable from upstream but not HEAD -- not a plain
    # local-rev-vs-remote-rev equality check, which would wrongly call a
    # checkout that's ahead of (or diverged from) origin "update available"
    # too. This is also the exact question `wpdev update`'s `pull --ff-only`
    # answers by actually pulling -- this just asks it without doing it.
    behind="$(git rev-list --count "HEAD..${remote_rev}")"

    if [ "$behind" -eq 0 ]; then
        echo "Up to date (${current_version})."
        exit 0
    fi

    latest_version="$(git describe --tags --always "$remote_rev" 2>/dev/null)" || latest_version="$remote_rev"
    echo "Update available: ${latest_version} (currently ${current_version}, ${behind} commit(s) behind)."
    exit 2
}
cmd_status() {
    docker compose ps
    echo ""
    print_header "=== Sites ==="

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        echo "No sites configured yet. Run: wpdev add"
        return
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi

    # `cmd && var=1` here would abort this whole command under `set -e` if
    # the container is transiently unreachable — a status dashboard must
    # never die on the thing it's trying to report as down.
    mysql_up=0
    if docker compose exec -T mysql true </dev/null >/dev/null 2>&1; then mysql_up=1; fi

    # One shared MySQL server for every site, so its version is the same on
    # every row -- fetched once here rather than once per site in the loop.
    mysql_version="n/a"
    if [ "$mysql_up" -eq 1 ] && [ -n "${DB_ROOT_PASSWORD:-}" ]; then
        mysql_version="$(docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -N -e "SELECT VERSION();" </dev/null 2>/dev/null | tr -d '[:space:]')"
        [ -z "$mysql_version" ] && mysql_version="n/a"
    fi

    printf "%-28s %-6s %-9s %-9s %-6s %-10s %s\n" "DOMAIN" "PHP" "WP" "MYSQL" "HTTP" "DATABASE" "CACHE"
    for domain in $domains; do
        site_name="${domain%.test}"
        site_name="${site_name//./-}"
        config="sites/${site_name}/wp-config.php"
        # || true: set -e gotcha -- cat on a missing .php-version (any site
        # that predates multi-PHP support) exits nonzero even with stderr
        # silenced, and this bare assignment isn't exempt the way
        # `cmd1 && cmd2` is. Confirmed live: without this, ONE site missing
        # the marker file silently killed status reporting for every site,
        # not just itself, since it died mid-loop.
        php_version="$(cat "sites/${site_name}/.php-version" 2>/dev/null)" || true
        [ -z "$php_version" ] && php_version="$DEFAULT_PHP_VERSION"
        php_svc="$(php_slug "$php_version")"

        # --noproxy/--resolve: check the site regardless of a shell-level
        # http_proxy (which would otherwise silently misroute this to some
        # unrelated proxy) or missing /etc/hosts entries. `|| true`: a
        # connection failure must show as "down" for this one row, not
        # abort the whole dashboard under `set -e`.
        http_code="$(curl -sk --noproxy '*' --max-time 3 --resolve "${domain}:443:127.0.0.1" \
            -o /dev/null -w "%{http_code}" "https://${domain}/" 2>/dev/null || true)"
        [ -z "$http_code" ] && http_code="down"

        db_status="n/a"
        if [ -f "$config" ] && [ "$mysql_up" -eq 1 ] && [ -n "${DB_ROOT_PASSWORD:-}" ]; then
            db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
            if docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "USE \`${db_name}\`;" </dev/null >/dev/null 2>&1; then
                db_status="OK"
            else
                db_status="FAIL"
            fi
        elif [ "$mysql_up" -ne 1 ]; then
            db_status="down"
        fi

        php_reachable=0
        if [ -f "$config" ] && docker compose exec -T "$php_svc" true </dev/null >/dev/null 2>&1; then
            php_reachable=1
        fi

        cache_status="n/a"
        if [ "$php_reachable" -eq 1 ]; then
            cache_status="$(docker compose exec -T "$php_svc" wp redis status --path="/var/www/${site_name}" --allow-root </dev/null 2>/dev/null | grep "^Status:" | awk '{print $2}')"
            [ -z "$cache_status" ] && cache_status="off"
        fi

        wp_version="n/a"
        if [ "$php_reachable" -eq 1 ]; then
            wp_version="$(docker compose exec -T "$php_svc" wp core version --path="/var/www/${site_name}" --allow-root </dev/null 2>/dev/null)"
            [ -z "$wp_version" ] && wp_version="n/a"
        fi

        printf "%-28s %-6s %-9s %-9s %-6s %-10s %s\n" "$domain" "$php_version" "$wp_version" "$mysql_version" "$http_code" "$db_status" "$cache_status"
    done
}

cmd_doctor() {
    warnings=0
    fails=0

    print_header "=== Stack ==="

    if docker info >/dev/null 2>&1; then
        print_info "Docker daemon is reachable"
    else
        print_fail "Docker daemon is not reachable — is Docker running?"
        fails=$((fails + 1))
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
        if [ -n "${DB_ROOT_PASSWORD:-}" ]; then
            print_info ".env exists, DB_ROOT_PASSWORD is set"
        else
            print_fail ".env exists but DB_ROOT_PASSWORD is empty"
            fails=$((fails + 1))
        fi
    else
        print_warning ".env doesn't exist yet — created automatically on next 'wpdev add', or copy .env.example yourself"
        warnings=$((warnings + 1))
    fi

    expected_containers="wp-mysql wp-redis wp-mailpit wp-nginx wp-adminer wp-portainer wp-api wp-dashboard"
    for v in $SUPPORTED_PHP_VERSIONS; do
        expected_containers="$expected_containers wp-$(php_slug "$v")"
    done
    for c in $expected_containers; do
        # || true: docker inspect exits nonzero for a container that doesn't
        # exist at all (e.g. adminer/portainer, which `wpdev add` never
        # starts) -- a bare assignment like this one is NOT exempt from
        # set -e the way `cmd1 && cmd2` is, so without this the whole
        # script aborts right here instead of reaching the `-z "$state"`
        # branch below that's meant to handle exactly this case.
        state="$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null)" || true
        if [ "$state" = "running" ]; then
            print_info "${c} is running"
        elif [ -z "$state" ]; then
            print_warning "${c} doesn't exist yet — run: wpdev up"
            warnings=$((warnings + 1))
        else
            print_fail "${c} exists but isn't running (state: ${state}) — check: docker logs ${c}"
            fails=$((fails + 1))
        fi
    done

    orphans="$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep '^wp-' | grep -vFx -f <(echo "$expected_containers" | tr ' ' '\n') || true)"
    if [ -n "$orphans" ]; then
        print_warning "Orphaned wp-* containers not in the current stack (leftover from a renamed/removed service):"
        echo "$orphans" | sed 's/^/    /'
        echo "    Remove with: docker rm -f <name>"
        warnings=$((warnings + 1))
    else
        print_info "No orphaned containers"
    fi

    if command -v mkcert >/dev/null 2>&1; then
        # || true: same set -e gotcha as elsewhere -- mkcert -CAROOT failing
        # (unlikely, but possible if mkcert is installed yet not fully
        # functional) shouldn't silently abort the rest of doctor's checks.
        caroot="$(mkcert -CAROOT 2>/dev/null)" || true
        if [ -f "${caroot}/rootCA.pem" ]; then
            print_info "mkcert local CA exists (${caroot})"
        else
            print_warning "mkcert is installed but no local CA found — run: wpdev install-mkcert"
            warnings=$((warnings + 1))
        fi
    else
        print_warning "mkcert isn't installed — run: wpdev install-mkcert"
        warnings=$((warnings + 1))
    fi

    if [ -d docker ]; then
        print_warning "Stray docker/ directory at the repo root (unused, likely leftover from a past mistake) — remove with: sudo rm -rf docker/"
        warnings=$((warnings + 1))
    fi

    du_sites="$(du -sh sites 2>/dev/null | cut -f1)"
    [ -n "$du_sites" ] && echo "  Disk: sites/ = ${du_sites:-0}"

    echo ""
    print_header "=== Sites ==="

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        echo "No sites configured yet. Run: wpdev add"
    else
        if [ -f .env ]; then
            set -a
            # shellcheck disable=SC1091
            source .env
            set +a
        fi
        mysql_up=0
        if docker compose exec -T mysql true </dev/null >/dev/null 2>&1; then mysql_up=1; fi

        for domain in $domains; do
            site_name="${domain%.test}"
            site_name="${site_name//./-}"
            config="sites/${site_name}/wp-config.php"

            echo "${domain}:"

            if grep -q "[[:space:]]${domain}$" /etc/hosts 2>/dev/null || grep -q "[[:space:]]${domain}[[:space:]]" /etc/hosts 2>/dev/null; then
                print_info "  /etc/hosts entry present"
            else
                print_warning "  Missing /etc/hosts entry — run: wpdev hosts"
                warnings=$((warnings + 1))
            fi

            if [ -f "nginx/ssl/certs/${domain}.pem" ] && [ -f "nginx/ssl/private/${domain}-key.pem" ]; then
                print_info "  SSL certificate present"
            else
                print_fail "  Missing SSL certificate — run: wpdev add (skips steps that already exist)"
                fails=$((fails + 1))
            fi

            if [ ! -f "$config" ]; then
                print_fail "  No wp-config.php (checked ${config})"
                fails=$((fails + 1))
                continue
            fi

            if [ "$mysql_up" -ne 1 ]; then
                print_warning "  Can't check database — MySQL isn't running"
                warnings=$((warnings + 1))
                continue
            fi

            db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
            # COUNT(*) alone can't tell "schema doesn't exist" from "schema
            # exists but is empty" — both return 0. Check existence first
            # (this is exactly the class of bug that caused the wp-lab
            # incident: a wp-config.php pointing at a database that silently
            # isn't there).
            db_exists="$(docker compose exec -T mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" -N -e "SELECT COUNT(*) FROM information_schema.schemata WHERE schema_name='${db_name}';" </dev/null 2>/dev/null | tr -d '[:space:]')"
            if [ "$db_exists" != "1" ]; then
                print_fail "  Database '${db_name}' (from wp-config.php) doesn't exist"
                fails=$((fails + 1))
            else
                table_count="$(docker compose exec -T mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${db_name}';" </dev/null 2>/dev/null | tr -d '[:space:]')"
                if [ "${table_count:-0}" -eq 0 ]; then
                    print_warning "  Database '${db_name}' exists but has 0 tables — looks unprovisioned or broken"
                    warnings=$((warnings + 1))
                else
                    print_info "  Database '${db_name}' OK (${table_count} tables)"
                fi
            fi
        done
    fi

    echo ""
    if [ "$fails" -eq 0 ] && [ "$warnings" -eq 0 ]; then
        print_info "Everything checks out."
    else
        print_header "=== Summary ==="
        [ "$fails" -gt 0 ] && print_fail "${fails} thing(s) need fixing"
        [ "$warnings" -gt 0 ] && print_warning "${warnings} thing(s) worth a look"
    fi
}

cmd_logs() {
    if [ -n "$1" ]; then
        docker compose logs -f "$1"
    else
        docker compose logs -f
    fi
}

cmd_shell() {
    case "$1" in
        php)
            version="${2:-$DEFAULT_PHP_VERSION}"
            case " $SUPPORTED_PHP_VERSIONS " in
                *" $version "*) ;;
                *) print_error "Unknown PHP version '${version}'. Supported: $SUPPORTED_PHP_VERSIONS" ;;
            esac
            docker exec -it "wp-$(php_slug "$version")" sh
            ;;
        db) docker exec -it wp-mysql bash ;;
        nginx) docker exec -it wp-nginx sh ;;
        redis) docker exec -it wp-redis redis-cli ;;
        *)
            print_warning "Usage: wpdev shell php [version]|db|nginx|redis"
            echo "  wpdev shell php          # default version ($DEFAULT_PHP_VERSION)"
            echo "  wpdev shell php 8.4      # a specific version"
            exit 1
            ;;
    esac
}

