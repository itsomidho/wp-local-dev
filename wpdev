#!/bin/bash

# Single entrypoint for this WordPress Docker dev environment.
#
# Stack lifecycle:
#   wpdev up | down | restart | status | logs [service]
#   wpdev doctor              Proactive health check — CA trust, orphan containers, per-site DB sanity
#   wpdev fix-dns             Repair container DNS when the host resolver is behind a VPN tunnel (sudo);
#                             `wpdev up` already does this automatically when it detects the problem
#   wpdev fix-vpn-network     Move Docker's networks out of the ranges a VPN routes into its tunnel (sudo);
#                             `wpdev up` already does this automatically when it detects the problem
#   wpdev shell php[ version]|db|nginx|redis
#   wpdev db [name]           Open a MySQL prompt (root, or scoped to one site's DB)
#   wpdev adminer [name]      Open Adminer in the browser (root, or deep-linked to one site's DB)
#   wpdev mailpit             Open Mailpit in the browser (every site's outgoing mail, caught)
#   wpdev dashboard           Open the web dashboard in the browser (GUI for everything above)
#   wpdev reload-nginx
#   wpdev backup
#   wpdev install-mkcert
#   wpdev clean | clean-all
#
# Sites:
#   wpdev add                 Provision a new site end-to-end (interactive prompt for domain),
#                             or non-interactively: wpdev add --domain=<domain> [--php=<version>] [--wp-version=<version>]
#   wpdev remove <name> [--yes]  Delete a site: WP files, DB, Nginx config, SSL cert, logs
#   wpdev clone <src> <new> [--yes]  Duplicate a site (files + DB) under a new domain, URLs re-pointed
#   wpdev snapshot <site> [label]   Save a files+DB snapshot of a site
#   wpdev snapshots <site>    List saved snapshots for a site
#   wpdev restore <site> [snap-id] [--yes]  Restore a site from a snapshot (defaults to the latest)
#   wpdev db-export <site> [file]   Dump just that site's database (default: backups/<site>_<time>.sql.gz)
#                                   (--tables=a,b: only those tables)
#   wpdev db-tables <site>          That site's tables: name, rows, bytes (tab-separated)
#   wpdev db-backup <site>...       Back up those sites' databases now (--all: every site;
#                                   --due: those whose schedule says it's time)
#   wpdev db-backups <site>         List its backups; "schedule <6h|1d|off> [--keep=N]"
#                                   sets automatic ones, "rm <file>" removes one
#   wpdev debug <site> [on|off]     WordPress debug settings (WP_DEBUG and friends);
#                                   "set <KEY> true|false" for one of them
#   wpdev debug-log <site>          The end of its debug.log (--lines=N, --follow); "clear"
#   wpdev share <site> on|off       Show it to other devices: on your network, and with
#                                   --public anywhere (--for=1h, --password=X, --admin)
#   wpdev db-import <site> <file>   Replace that site's database from a .sql or .sql.gz dump
#                                   (--tables=a,b: only those, keeping the rest;
#                                    --rewrite-urls: re-point the dump's URLs to this site)
#   wpdev off <site>... | --all     Switch a site off to save resources: it shows a "this site
#                                   is off" page, its WP-Cron stops, and its PHP container stops
#                                   when no site that's on needs that version. Nothing is deleted.
#   wpdev on <site>... | --all      Switch it back on (a few seconds)
#   wpdev auto-off <site> [3d|12h|never|default]  Switch it off by itself after that long
#                                   without a visit (default: AUTO_OFF_AFTER in .env);
#                                   "--due" switches off whichever sites are past it
#   wpdev list                List configured site domains
#   wpdev hosts               Print /etc/hosts entries needed for all sites
#   wpdev check-domain <domain>  Whether <domain> is free for a new site (and why not)
#   wpdev update-tlds         Refresh the list of real top-level domains add refuses
#   wpdev creds <name>        Show a site's admin/DB credentials
#   wpdev open <name> [--editor=nvim]  Open a site's folder in the file manager, or in Neovim
#   wpdev cert <name>         Reissue a site's HTTPS certificate from the current mkcert CA
#   wpdev fix-perms <name>    Give a site's files back to you (owner + write); --all for every site
#   wpdev media-proxy <name> [url|on|off]  Load uploads missing locally from production
#   wpdev admin-domain <name> [domain|on|off]  Move the site's wp-admin to a separate domain
#   wpdev wp <name> <args...> Run any WP-CLI command against a site, e.g.:
#                               wpdev wp mysite plugin list
#
# `add` prompts for a domain and a PHP version (default 8.2; see
# SUPPORTED_PHP_VERSIONS below — one docker-compose service per version,
# php81/php82/php83/php84, so each site genuinely runs its own PHP), then
# does the whole thing:
#   1. Ensure MySQL + the chosen PHP version + Redis are up
#   2. Create the Nginx vhost config in nginx/sites/, pointed at that PHP version
#   3. Download WordPress into sites/<name>, save PHP_VERSION in config/sites/<name>.env
#   4. Create a dedicated database + user for the site
#   5. Generate wp-config.php via WP-CLI (includes Redis object cache config)
#   6. Generate an SSL certificate with mkcert
#   7. Run `wp core install` via WP-CLI — no browser installer, no Adminer step
#   8. Install + activate the redis-cache plugin, enable the object cache
#   9. Reload Nginx, offer to add the /etc/hosts entry
#
# Safe to re-run on an existing site (`--repair` when non-interactive):
# every step is skipped if its output already exists — including the PHP
# version prompt itself, once PHP_VERSION is saved.

set -e

# Every image here builds with `network: host`. Compose 2.x builds via
# `buildx bake` by default, which refuses that unless --allow=network.host
# is passed -- and Compose doesn't pass it, even with the entitlement
# declared in docker-compose.yml. Its own builder doesn't have that check.
# (Compose 5 ignores this variable, always bakes, and honors the declared
# entitlement instead -- hence both.) (#24)
export COMPOSE_BAKE="${COMPOSE_BAKE:-false}"

# Every image build goes through here, never a bare `docker compose build`.
# Compose 5.6 + buildx 0.38 still refuse the build even with the entitlement
# declared ("additional privileges requested: pass --allow=network.host"):
# Compose copies it into the bake target but never passes --allow. So ask
# Compose for its bake definition and hand that to buildx ourselves, with
# the grant. Compose versions without --print just build the old way.
compose_build() {
    local def
    if def="$(docker compose build --print "$@" 2>/dev/null)" && [ -n "$def" ]; then
        printf '%s\n' "$def" | docker buildx bake -f - --allow=network.host
    else
        docker compose build "$@"
    fi
}

# readlink -f resolves the ~/.local/bin symlink to the real file first —
# ${BASH_SOURCE[0]} alone would point at the symlink's own directory, not
# this project, when invoked as the bare `wpdev` command.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$SCRIPT_DIR"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# One docker-compose service per version (php81/php82/php83/php84) — see
# docker-compose.yml. Sites pick a version at `wpdev add` time; it's saved as
# PHP_VERSION in config/sites/<name>.env. DEFAULT_PHP_VERSION is what a site
# gets if it predates multi-PHP support (none saved) or the prompt is left
# blank.
SUPPORTED_PHP_VERSIONS="7.4 8.0 8.1 8.2 8.3 8.4 8.5"
DEFAULT_PHP_VERSION="8.2"

print_info() { echo -e "${GREEN}✓${NC} $1"; }
print_step() { echo -e "${GREEN}[STEP]${NC} $1"; }
print_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
print_header() { echo -e "${BLUE}$1${NC}"; }
print_error() { echo -e "${RED}✗${NC} $1"; exit 1; }
# A declined confirmation is not success: exit non-zero so a script (or
# CI piping answers in) can tell "cancelled" from "done". Exiting 0 here
# once hid a real provisioning failure behind a shifted piped answer.
cancelled() { echo "Cancelled."; exit 1; }

# ---------------------------------------------------------------------------
# Per-site settings
# ---------------------------------------------------------------------------
# Everything wpdev remembers about a site lives in config/sites/<name>.env,
# one KEY=value per line -- never inside sites/<name>/, which is the
# project's own folder (often its own git repo, with its own .env). It's
# not a shell file: the helpers below read and write it and it's never
# sourced, so values are literal (no quoting). Mode 600, since it holds
# the site's passwords. Keys:
#   PHP_VERSION           e.g. 8.2 (none saved = DEFAULT_PHP_VERSION)
#   DB_PASSWORD           the site's MySQL user's password
#   ADMIN_PASSWORD        wp-admin's "admin" password, as `add` installed it
#   PRODUCTION_URL        `wpdev media-proxy`
#   ADMIN_DOMAIN          `wpdev admin-domain` (kept after `off`)
#   CACHE                 "on" while `wpdev cache` is on
#   CACHE_TTL             e.g. 5m or 1h (default 60m)
#   CACHE_BYPASS_COOKIES  space-separated cookie names (trailing * = prefix)
#   CACHE_BYPASS_PATHS    space-separated URL paths (trailing * = prefix)
#   SITE_STATE            "off" while `wpdev off` has it switched off (none = on)
#   OFF_SINCE / OFF_BY    when it was switched off, and by whom: "you" or "auto-off"
#   LAST_ON               when `wpdev on` last switched it on (epoch) -- auto-off's
#                         clock starts there when nobody has visited since
#   AUTO_OFF              `wpdev auto-off`: idle time before it switches itself
#                         off (e.g. 3d), or "never"; none = AUTO_OFF_AFTER in .env
#   AUTO_OFF_SET          when `wpdev auto-off <site>` last changed it (epoch): its
#                         clock starts no earlier, so a new limit never applies
#                         retroactively
SITE_CONFIG_DIR="config/sites"
site_config_file() { echo "${SITE_CONFIG_DIR}/$1.env"; }

# site_get <site-name> <KEY>: its value, or nothing.
site_get() {
    local f
    f="$(site_config_file "$1")"
    [ -f "$f" ] && sed -n "s/^$2=//p" "$f" | tail -1
    return 0
}

# Rewrites <site-name>'s file without <KEY>, then appends "<KEY>=<value>"
# unless no value is given -- via a temp file in the same directory, so a
# reader never sees it half-written.
site_write() {
    local f tmp
    f="$(site_config_file "$1")"
    mkdir -p "$SITE_CONFIG_DIR"
    tmp="$(mktemp "${f}.XXXXXX")"
    chmod 600 "$tmp"
    if [ -f "$f" ]; then
        grep -v "^$2=" "$f" >> "$tmp" || true
    else
        printf '# wpdev settings for %s -- see "Per-site settings" in the README.\n' "$1" >> "$tmp"
    fi
    [ "$#" -ge 3 ] && printf '%s=%s\n' "$2" "$3" >> "$tmp"
    mv -f "$tmp" "$f"
}

# site_set <site-name> <KEY> <value>
site_set() { site_write "$1" "$2" "$3"; }

# site_unset <site-name> <KEY>
site_unset() {
    [ -f "$(site_config_file "$1")" ] || return 0
    site_write "$1" "$2"
}

# Sites from before config/sites/ kept these as dotfiles in sites/<name>/.
# Moves each over -- a value the config already has wins, since restoring
# an old snapshot can bring stale dotfiles back -- and deletes the file only
# once its value is saved.
migrate_site_config() {
    local site="$1" pair file key value
    for pair in .php-version:PHP_VERSION .db-password:DB_PASSWORD .admin-password:ADMIN_PASSWORD \
        .production-url:PRODUCTION_URL .admin-domain:ADMIN_DOMAIN .cache:CACHE .cache-ttl:CACHE_TTL \
        .cache-bypass-cookies:CACHE_BYPASS_COOKIES .cache-bypass-paths:CACHE_BYPASS_PATHS; do
        file="sites/${site}/${pair%%:*}"
        key="${pair#*:}"
        [ -f "$file" ] || continue
        if [ -z "$(site_get "$site" "$key")" ]; then
            case "$key" in
                CACHE) value="on" ;;
                # One entry per line, # comments -> one space-separated line.
                CACHE_BYPASS_*)
                    value="$(grep -v '^[[:space:]]*#' "$file" | tr -s '[:space:]' ' ' || true)"
                    value="$(echo "$value" | sed 's/^ *//; s/ *$//')"
                    ;;
                *) value="$(head -1 "$file" | tr -d '\r')" ;;
            esac
            if [ -n "$value" ]; then
                site_set "$site" "$key" "$value" || continue
            fi
        fi
        rm -f "$file" 2>/dev/null || true
    done
}

migrate_site_configs() {
    local d
    for d in sites/*/; do
        [ -d "$d" ] || continue
        d="${d%/}"
        d="${d#sites/}"
        [ "$d" = "html" ] && continue
        migrate_site_config "$d"
    done
}

# The host port nginx publishes 443 on (NGINX_HTTPS_PORT in .env). Read
# from the file first, so the api container -- which only got .env's
# values as of its own last recreate -- still agrees with the host.
nginx_https_port() {
    local p=""
    [ -f .env ] && p="$(sed -n 's/^NGINX_HTTPS_PORT=//p' .env | tail -1 | tr -d '"\r'"'"' ')"
    [ -z "$p" ] && p="${NGINX_HTTPS_PORT:-}"
    echo "${p:-443}"
}

# A site's real base URL: https://<domain>, plus :<port> only when nginx
# isn't on 443. Every URL wpdev writes into WordPress (WP_HOME/WP_SITEURL,
# install --url, clone's search-replace) or prints goes through this --
# hard-coding the bare domain made WordPress redirect every request on a
# non-default port to :443, where nothing listens. (#5)
site_url() {
    local p
    p="$(nginx_https_port)"
    if [ "$p" = "443" ]; then echo "https://$1"; else echo "https://$1:$p"; fi
}

# HTTP status of https://<domain><path>, "down" (nothing answered) or
# "timeout" (no answer within 10s). --connect-to keeps the URL (so Host
# and SNI) exactly what a browser sends while choosing where to actually
# connect: the host's published port, or -- inside the api container,
# whose loopback isn't nginx at all -- nginx's own :443 on the compose
# network (#6). --noproxy: a shell-level http_proxy would
# otherwise misroute it; no /etc/hosts entry needed either way. A page
# that's merely slow (a real site's uncached front page can take seconds)
# is "timeout", not "down" -- those are different problems, and a 3s limit
# once reported a working site as down. The `|| rc=$?`: a failed probe
# must report, not abort the caller under set -e.
# wpdev's own requests carry this User-Agent, so auto-off doesn't count
# them as visits (see site_last_visit).
WPDEV_PROBE_UA="wpdev-probe"
site_http_code() {
    local domain="$1" path="${2:-/}" port target code rc=0
    port="$(nginx_https_port)"
    if [ -n "${WPDEV_IN_API:-}" ]; then target="nginx:443"; else target="127.0.0.1:${port}"; fi
    code="$(curl -sk -A "$WPDEV_PROBE_UA" --noproxy '*' --connect-timeout 3 --max-time 10 --connect-to "${domain}:${port}:${target}" \
        -o /dev/null -w "%{http_code}" "https://${domain}:${port}${path}" 2>/dev/null)" || rc=$?
    if [ "$rc" -eq 28 ] && [ "${code:-000}" = "000" ]; then
        code="timeout"
    elif [ -z "$code" ] || [ "$code" = "000" ]; then
        code="down"
    fi
    echo "$code"
}

# The mkcert CA new certs are issued from (and browsers are expected to
# trust), or nothing if mkcert or its CA is missing. Inside the api
# container this is whatever MKCERT_CAROOT mounted at $CAROOT.
mkcert_caroot() {
    command -v mkcert >/dev/null 2>&1 || return 0
    local d
    d="$(mkcert -CAROOT 2>/dev/null)" || true
    [ -n "$d" ] && [ -f "${d}/rootCA.pem" ] && echo "$d"
    return 0
}

# Why a site's certificate needs reissuing, or nothing if it's fine. Order
# matters: an expired cert also fails `openssl verify`, which would
# otherwise be misreported as "wrong CA" (hence -no_check_time there).
cert_problem() {
    local cert="nginx/ssl/certs/$1.pem" caroot
    [ -f "$cert" ] || { echo "is missing"; return 0; }
    command -v openssl >/dev/null 2>&1 || return 0
    if ! openssl x509 -checkend 0 -noout -in "$cert" >/dev/null 2>&1; then
        echo "has expired"; return 0
    fi
    caroot="$(mkcert_caroot)"
    if [ -n "$caroot" ] && ! openssl verify -no_check_time -CAfile "${caroot}/rootCA.pem" "$cert" >/dev/null 2>&1; then
        echo "wasn't issued by the current mkcert CA (${caroot}), so browsers that trust that CA won't trust it"
        return 0
    fi
    if ! openssl x509 -checkend $((30 * 86400)) -noout -in "$cert" >/dev/null 2>&1; then
        echo "expires within 30 days"
    fi
    return 0
}

# Containers a compose recreate left behind when it was interrupted
# mid-way: compose renames the old container to <12-hex>_<name> while it
# swaps in the new one, so a run killed at the wrong moment leaves one of
# these, never started, that nothing else reports. (#12) Prints
# "<name> <state>" lines.
recreate_leftovers() {
    docker ps -a --format '{{.Names}} {{.State}}' 2>/dev/null | grep -E '^[0-9a-f]{12}_wp-' || true
}

# Commands in a php container run as www-data, which php/entrypoint.sh
# renumbers to your own uid -- so whatever wp-cli writes is owned by you,
# exactly like what PHP-FPM writes for wp-admin. (Not root, docker compose
# exec's default: root-owned files were read-only to both you and
# WordPress.) php_exec_root is for the few steps that must handle files a
# pre-#20 site left owned by root. (#20)
php_exec() {
    local svc="$1"; shift
    docker compose exec -T -u www-data "$svc" "$@"
}
php_exec_root() {
    local svc="$1"; shift
    docker compose exec -T "$svc" "$@"
}

# True when the php container's www-data really is you -- i.e. it was
# started with php/entrypoint.sh's uid mapping. Containers started before
# that (an older checkout) still run as uid 33.
php_runs_as_you() {
    [ "$(docker compose exec -T "$1" id -u www-data </dev/null 2>/dev/null | tr -d '\r')" = "$(id -u)" ]
}

# Hand a whole site to you: owner = your uid/gid (www-data inside the
# container), and owner-writable. Root, since that's the point -- fixing
# files someone else owns. chown -R doesn't follow symlinks.
fix_site_ownership() {
    local svc="$1" site="$2"
    php_runs_as_you "$svc" || return 1
    php_exec_root "$svc" sh -c 'chown -R www-data:www-data "/var/www/$1" && chmod -R u+rwX "/var/www/$1"' sh "$site" </dev/null >/dev/null 2>&1
}

# Paths under sites/<site> that aren't yours, or that you can't write.
# Capped: it's for "is there a problem", not an inventory.
# Files inside .git only count when they aren't yours: git makes its
# objects read-only on purpose, so the write check would always fire.
foreign_files() {
    find "sites/$1" \( ! -user "$(id -u)" -o \( ! -perm -u+w ! -path '*/.git/*' \) \) -print 2>/dev/null | head -n "${2:-1000}" || true
}
print_fail() { echo -e "${RED}✗${NC} $1"; }

