case "${1:-help}" in
    up) cmd_up ;;
    down) cmd_down ;;
    restart) cmd_restart ;;
    update) cmd_update ;;
    update-check) cmd_update_check ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    fix-dns) cmd_fix_dns ;;
    logs) cmd_logs "$2" ;;
    shell) cmd_shell "$2" ;;
    db) cmd_db "$2" ;;
    adminer) cmd_adminer "$2" ;;
    portainer) cmd_portainer ;;
    mailpit) cmd_mailpit ;;
    dashboard) cmd_dashboard ;;
    reload-nginx) cmd_reload_nginx ;;
    cache) cmd_cache "$2" "$3" ;;
    cache-purge) cmd_cache_purge ;;
    backup) cmd_backup ;;
    restore-all) shift; cmd_restore_all "$@" ;;
    install-mkcert) cmd_install_mkcert ;;
    clean) cmd_clean ;;
    clean-all) shift; cmd_clean_all "$@" ;;
    uninstall) cmd_uninstall ;;
    add) shift; cmd_add "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    clone) shift; cmd_clone "$@" ;;
    snapshot) cmd_snapshot "$2" "$3" ;;
    snapshots) cmd_snapshots "$2" ;;
    restore) shift; cmd_restore "$@" ;;
    db-export) cmd_db_export "$2" "$3" ;;
    db-import) shift; cmd_db_import "$@" ;;
    list) cmd_list ;;
    hosts) cmd_hosts ;;
    creds) cmd_creds "$2" ;;
    cert) cmd_cert "$2" ;;
    wp) shift; cmd_wp "$@" ;;
    help|-h|--help) show_help ;;
    *)
        print_warning "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
