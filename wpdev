# ---------------------------------------------------------------------------
# Production media proxy
# ---------------------------------------------------------------------------
# A local copy usually has the database but not the (huge) uploads folder.
# With the proxy on, nginx serves /wp-content/uploads/ from disk as usual,
# and only a file that's missing locally is streamed from the same path on
# production. WordPress isn't involved: no plugin, no wp-config.php
# constant, and media URLs stay the site's own (same-origin), so the
# browser never talks to production -- however this machine resolves it.
# Nothing is stored on disk: no proxy_cache, just a pass-through.
#
# nginx must NOT resolve production through the containers' usual DNS:
# that's systemd-resolved on the docker bridge (see fix-dns), which answers
# from the host's /etc/hosts -- e.g. production pinned to an internal
# address for wp-admin. So the proxy gets its own resolver: the real
# upstream servers.
MEDIA_PROXY_URI="/wp-content/uploads"

media_proxy_conf() { echo "nginx/sites/media-proxy/$1.conf"; }

# IPv4 upstream DNS servers that don't consult /etc/hosts: what
# systemd-resolved forwards to, else a non-loopback /etc/resolv.conf, else
# a public resolver. (Inside the api container neither file has them, so
# it falls back -- `wpdev media-proxy <site> on` on the host re-renders.)
media_proxy_resolvers() {
    local f ns
    for f in /run/systemd/resolve/resolv.conf /etc/resolv.conf; do
        ns="$(awk '$1 == "nameserver" && $2 ~ /^[0-9.]+$/ && $2 !~ /^127\./ {print $2}' "$f" 2>/dev/null | head -3 | tr '\n' ' ')"
        [ -n "$ns" ] && { echo "${ns% }"; return 0; }
    done
    echo "1.1.1.1 8.8.8.8"
}

# Writes the location blocks for <domain> falling back to <production-url>
# (scheme://host[:port][/path], already validated).
render_media_proxy() {
    local domain="$1" prod="$2" scheme rest hostport conf
    scheme="${prod%%://*}"
    rest="${prod#*://}"
    hostport="${rest%%/*}"
    conf="$(media_proxy_conf "$domain")"
    mkdir -p "$(dirname "$conf")"
    cat > "$conf" <<CONF
# Managed by \`wpdev media-proxy\` for ${domain} -- re-run it rather than
# editing this file. Uploads missing locally are streamed from
# ${prod}${MEDIA_PROXY_URI}/..., resolved via real DNS (not /etc/hosts).
location ^~ ${MEDIA_PROXY_URI}/ {
    # ^~ skips the vhost's regex locations, so repeat the two that matter
    # for uploads: never run PHP, and long browser caching.
    location ~* \.php\$ {
        deny all;
    }
    expires max;
    log_not_found off;
    access_log off;
    try_files \$uri @wpdev_production_media;
}

location @wpdev_production_media {
    # Real upstream DNS, not the containers' default, which answers from
    # the host's /etc/hosts. proxy_pass has a variable, so nginx resolves
    # per request and still starts when production is unreachable.
    resolver $(media_proxy_resolvers) valid=300s ipv6=off;
    resolver_timeout 5s;
    # \$request_uri is the original, still percent-encoded path + query.
    proxy_pass ${prod}\$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host "${hostport}";
    proxy_ssl_server_name on;
    proxy_ssl_name "${hostport%%:*}";
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;

    # Nothing local goes to production: not your session, not auth.
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_hide_header Set-Cookie;

    # A production redirect stays on this site instead of sending the
    # browser to production directly.
    proxy_redirect ${prod}/ /;

    # Production's own HSTS/Alt-Svc would apply to this .test host, and its
    # security headers would duplicate the ones this vhost already adds.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header Alt-Svc;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-XSS-Protection;
    proxy_hide_header Referrer-Policy;

    access_log off;
}
CONF
}

# Vhosts generated before the media proxy / admin domain existed lack
# their include lines; add them in front of the main location so a
# regenerated vhost and an old one end up identical.
ensure_vhost_includes() {
    local vhost="nginx/sites/$1.conf"
    if ! grep -q 'sites/media-proxy/' "$vhost"; then
        awk -v d="$1" '
            !done && /^    location \/ \{/ {
                print "    # Production media proxy (`wpdev media-proxy`)."
                print "    include /etc/nginx/sites/media-proxy/" d ".con[f];"
                print ""
                done = 1
            }
            { print }
        ' "$vhost" > "${vhost}.new" && mv "${vhost}.new" "$vhost"
    fi
    if ! grep -q 'sites/admin-domain/frontend/' "$vhost"; then
        awk -v d="$1" '
            !done && /^    location \/ \{/ {
                print "    # Admin domain (`wpdev admin-domain`)."
                print "    include /etc/nginx/sites/admin-domain/frontend/" d ".con[f];"
                print ""
                done = 1
            }
            { print }
        ' "$vhost" > "${vhost}.new" && mv "${vhost}.new" "$vhost"
    fi
    if ! grep -q 'sites/off/' "$vhost"; then
        awk -v d="$1" '
            !done && /^    location \/ \{/ {
                print "    # Switched off (`wpdev off`)."
                print "    include /etc/nginx/sites/off/" d ".con[f];"
                print ""
                done = 1
            }
            { print }
        ' "$vhost" > "${vhost}.new" && mv "${vhost}.new" "$vhost"
    fi
}

# Vhosts from before the debug-log rule: add it in front of the hidden-files
# block, where the templates have it, so an old vhost and a regenerated
# one match. Returns 0 when any vhost changed.
ensure_vhost_log_block() {
    local vhost changed=1
    for vhost in nginx/sites/*.conf; do
        [ -f "$vhost" ] || continue
        grep -q '# Hide hidden version control' "$vhost" || continue
        grep -q '# Log files (wp-content/debug.log' "$vhost" && continue
        awk '
            !done && /^    # Hide hidden version control/ {
                print "    # Log files (wp-content/debug.log and its rotated .1) aren'"'"'t for the web."
                print "    location ~* \\.log(\\.\\d+)?$ {"
                print "        deny all;"
                print "    }"
                print ""
                done = 1
            }
            { print }
        ' "$vhost" > "${vhost}.new" && cat "${vhost}.new" > "$vhost" && rm -f "${vhost}.new"
        changed=0
    done
    return "$changed"
}

# After the stack is up: bring vhosts from older versions up to date, and
# reload nginx when that changed one.
upgrade_vhosts() {
    ensure_vhost_log_block || return 0
    if docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1; then
        print_info "Vhosts now refuse debug.log over the web"
    else
        print_warning "Added the debug.log rule to the vhosts, but nginx -t failed -- run: wpdev reload-nginx"
    fi
}

reload_nginx_or_fail() {
    if ! docker exec wp-nginx nginx -t >/dev/null 2>&1; then
        return 1
    fi
    docker exec wp-nginx nginx -s reload >/dev/null 2>&1 || return 1
    # -s reload only signals the master; give it a moment to start workers
    # on the new config, so the very next request sees the change.
    sleep 1
}

cmd_media_proxy() {
    arg="$1"
    mode="$2"
    if [ -z "$arg" ]; then
        print_warning "Usage: wpdev media-proxy <site-name> [<production-url>|on|off]"
        echo "  wpdev media-proxy mysite https://example.com/blog   # uploads missing locally come from example.com/blog"
        echo "  wpdev media-proxy mysite on                         # same, with the URL from last time"
        echo "  wpdev media-proxy mysite off                        # missing uploads are 404s again"
        echo "  wpdev media-proxy mysite                            # show the current state"
        return 1
    fi
    resolve_site "$arg"
    [ -f "nginx/sites/${domain}.conf" ] || print_error "No such site: ${site_name} (checked nginx/sites/${domain}.conf)"
    conf="$(media_proxy_conf "$domain")"
    local_url="$(site_url "$domain")${MEDIA_PROXY_URI}"

    case "$mode" in
        "")
            # Formats the dashboard parses too -- keep them stable.
            if [ -f "$conf" ]; then
                print_info "On: ${local_url}/…  →  $(site_get "$site_name" PRODUCTION_URL)${MEDIA_PROXY_URI}/…"
            elif [ -n "$(site_get "$site_name" PRODUCTION_URL)" ]; then
                print_info "Off (last production URL: $(site_get "$site_name" PRODUCTION_URL))"
            else
                print_info "Off"
            fi
            return 0
            ;;
        off)
            rm -f "$conf"
            reload_nginx_or_fail || print_warning "nginx didn't reload (is it running?) — takes effect on its next start: wpdev up"
            print_info "Media proxy off for ${domain}: uploads missing locally are 404s again."
            return 0
            ;;
        on)
            prod="$(site_get "$site_name" PRODUCTION_URL)"
            [ -n "$prod" ] || print_error "No production URL known for ${site_name}. Give it once: wpdev media-proxy ${site_name} https://your-production-site"
            ;;
        *)
            prod="$mode"
            ;;
    esac

    prod="${prod%/}"
    # Becomes part of an nginx config, so only a plain URL gets through.
    [[ "$prod" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/%-]*)?$ ]] \
        || print_error "Not a usable production URL: '${prod}' (expected e.g. https://example.com or https://example.com/blog)"

    site_set "$site_name" PRODUCTION_URL "$prod"
    render_media_proxy "$domain" "$prod"
    ensure_vhost_includes "$domain"
    if ! reload_nginx_or_fail; then
        rm -f "$conf"
        reload_nginx_or_fail || true
        print_error "nginx rejected the proxy config, so it was removed again. Check: docker exec wp-nginx nginx -t"
    fi
    print_info "Media proxy on: ${local_url}/…  →  ${prod}${MEDIA_PROXY_URI}/… (only files missing locally)"
    if php_exec "$(site_php_service "$site_name")" wp config has WP_PRODUCTION_DOMAIN \
        --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
        print_warning "wp-config.php defines WP_PRODUCTION_DOMAIN: if a plugin (e.g. wp-local-development-tools) uses it to rewrite media URLs to production, the browser still goes to production. Deactivate that plugin to use the proxy."
    fi
}

# ---------------------------------------------------------------------------
# Admin domain
# ---------------------------------------------------------------------------
# Production setups often serve wp-admin on its own domain: a reverse proxy
# answers admin.example.com and forwards to the public site with the site's
# Host plus X-Forwarded-Host: admin.example.com, and something in the
# project (e.g. a mu-plugin reading a WP_ADMIN_DOMAIN setting) rewrites
# admin/login/asset URLs to the admin domain when that header is present.
#
# This mirrors that locally, in three parts:
# - a server block for the admin domain in the same nginx, forwarding to
#   the site's own vhost. Only admin paths go through; everything else is
#   a 404, apart from post previews and ?rest_route= REST calls;
# - on the site domain, wp-admin and wp-login.php redirect to the admin
#   domain (except admin-ajax.php/admin-post.php, which public pages use);
# - the URL rewriting: the project's own code when it has some (it defines
#   WP_ADMIN_DOMAIN), else wpdev's mu-plugin, wordpress/mu-plugins/
#   wpdev-admin-domain.php, installed into the site.
#
# The server blocks live in nginx/sites/admin-domain/, loaded by an include
# in nginx/sites/default.conf (not nginx/sites/*.conf, where every file is
# a site to wpdev); the redirects in nginx/sites/admin-domain/frontend/,
# included by the site's vhost.
admin_domain_conf() { echo "nginx/sites/admin-domain/$1.conf"; }
admin_domain_frontend_conf() { echo "nginx/sites/admin-domain/frontend/$1.conf"; }
ADMIN_DOMAIN_PLUGIN="wpdev-admin-domain.php"
ADMIN_DOMAIN_PLUGIN_MARK="wpdev:managed admin-domain"

# wpdev's mu-plugin in <site-name>, if installed, under any mu-plugins dir.
admin_domain_plugin_path() {
    find "sites/$1" -maxdepth 5 -path "*mu-plugins/${ADMIN_DOMAIN_PLUGIN}" -type f 2>/dev/null \
        | while read -r f; do grep -q "$ADMIN_DOMAIN_PLUGIN_MARK" "$f" && echo "$f"; done | head -1
}

remove_admin_domain_plugin() {
    local f
    f="$(admin_domain_plugin_path "$1")"
    [ -n "$f" ] && rm -f "$f" && echo "$f"
    return 0
}

# The admin domain currently served for <site-name>, or nothing.
site_admin_domain() {
    local conf
    conf="$(admin_domain_conf "$(site_domain_of "$1")")"
    [ -f "$conf" ] && sed -n 's/^# admin-domain: //p' "$conf" | head -1
    return 0
}

# Every admin domain being served, one per line.
admin_domains() {
    local conf
    for conf in nginx/sites/admin-domain/*.conf; do
        [ -e "$conf" ] || continue
        sed -n 's/^# admin-domain: //p' "$conf" | head -1
    done
}

# Whether <admin-domain> is served for a site other than <site-domain>.
admin_domain_in_use() {
    grep -l "^# admin-domain: $1$" nginx/sites/admin-domain/*.conf 2>/dev/null | grep -qvx "$(admin_domain_conf "$2")"
}

# Whether <domain> is a plain hostname: lowercase letters, digits and
# hyphens, in dot-separated labels. It ends up in nginx configs, the hosts
# file and a certificate, and WordPress itself refuses an underscore
# (admin@my_site.test isn't a valid email address), so anything else would
# fail halfway through provisioning.
valid_domain() {
    [[ "$1" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]
}

# Every top-level domain in the public DNS root (refresh: wpdev update-tlds).
TLD_LIST="data/iana-tlds.txt"

# Longest site name (the domain minus its suffix) a new site may have: it
# becomes the database and MySQL user names, wp_<name>, and MySQL caps a
# user name at 32 characters. Longer, and the name would be cut to fit, so
# two long names starting alike would share one database.
SITE_NAME_MAX=28

# Whether <domain> is under a public top-level domain. home.arpa is in the
# root zone, but reserved for exactly this kind of private use.
is_real_domain() {
    case "$1" in *.home.arpa) return 1 ;; esac
    grep -qx "${1##*.}" "$TLD_LIST" 2>/dev/null
}

# Why <domain> can't be given to a new local site, or nothing if it can:
# - malformed, or too long: over SITE_NAME_MAX for its name, or over DNS's
#   own limits (63 characters a label, 253 in all)
# - already a site (or would share another site's sites/<name>)
# - on a real top-level domain: the hosts entry would hide the real site
#   of that name from this machine
# - already some site's admin domain
# - already pointed somewhere other than this machine by /etc/hosts, i.e.
#   in use for something else (the hosts line would just fight it)
new_domain_problem() {
    local domain="$1" tld="${1##*.}" name existing ip
    if ! valid_domain "$domain"; then
        if valid_domain "${domain//_/-}"; then
            echo "only letters, digits, hyphens and dots (try ${domain//_/-})"
        else
            echo "only letters, digits, hyphens and dots"
        fi
        return 0
    fi
    name="$(site_name_of "$domain")"
    if [ "${#name}" -gt "$SITE_NAME_MAX" ]; then
        echo "its name, ${name}, is ${#name} characters; ${SITE_NAME_MAX} at most (it becomes the database name)"
        return 0
    fi
    if [ "${#domain}" -gt 253 ] || [[ ".${domain}." =~ \.[^.]{64,}\. ]]; then
        echo "too long for DNS: 63 characters at most between dots, 253 in all"
        return 0
    fi
    if [ -f "nginx/sites/${domain}.conf" ]; then
        echo "it's already a site"
        return 0
    fi
    existing="$(site_domain_of "$name")"
    if [ -f "nginx/sites/${existing}.conf" ]; then
        echo "its site name, ${name}, already belongs to ${existing}"
        return 0
    fi
    if is_real_domain "$domain"; then
        echo "it's a real domain (.${tld} is a public top-level domain), and this machine would stop reaching the real ${domain}. Use a local suffix such as .test"
        return 0
    fi
    if admin_domains | grep -qx "$domain"; then
        echo "it's already a site's admin domain"
        return 0
    fi
    # The first address /etc/hosts gives it, comments aside.
    ip="$(awk -v d="$domain" '$1 !~ /^#/ { for (i = 2; i <= NF; i++) { if ($i ~ /^#/) break; if ($i == d) { print $1; exit } } }' /etc/hosts 2>/dev/null)"
    case "$ip" in
        ""|127.*|::1) ;;
        *) echo "/etc/hosts already points it at ${ip}, so something else uses it"; return 0 ;;
    esac
}

in_hosts_file() {
    grep -q "[[:space:]]$1$" /etc/hosts 2>/dev/null || grep -q "[[:space:]]$1[[:space:]]" /etc/hosts 2>/dev/null
}

# Runs a sh script as root against the host's /etc/hosts, mounted at
# /hosts, with $D set to <domain>. For the api container (the dashboard):
# it runs unprivileged and sees the host file read-only, so it can't
# write it directly. It does hold the Docker socket, though, which is
# already root on the host, so a throwaway container makes the edit.
# nginx:alpine because the stack already has it. Edits go through > and
# >> only, never sed -i or mv: those swap the file's inode, which a
# single-file bind mount (ours and wp-api's) can't follow.
host_hosts_edit() {
    docker run --rm --network none --user 0 --entrypoint sh -e D="$1" \
        -v /etc/hosts:/hosts nginx:alpine -c "$2" </dev/null >/dev/null 2>&1
}

# Makes sure <domain> resolves to this machine. From the dashboard it's
# added outright: nobody's there to ask, and a site that doesn't resolve
# is useless (through a system proxy it even shows up as a TLS error, so
# it looks like a broken certificate). From the CLI it's asked first,
# unless <ask> is 0 (--domain/--yes), which only prints the command:
# there may be no one to answer, and an open stdin that never sends EOF
# (a backgrounded shell, a service) would block forever after the work
# is done.
ensure_hosts_entry() {
    local domain="$1" ask="${2:-1}" answer=""
    if in_hosts_file "$domain"; then
        print_info "${domain} already in /etc/hosts"
        return 0
    fi
    if [ -n "${WPDEV_IN_API:-}" ]; then
        if host_hosts_edit "$domain" '[ -z "$(tail -c1 /hosts)" ] || echo >> /hosts; printf "127.0.0.1    %s\n" "$D" >> /hosts'; then
            print_info "Added ${domain} to /etc/hosts"
            return 0
        fi
        print_warning "Couldn't add ${domain} to /etc/hosts"
    elif [ "$ask" -eq 1 ]; then
        # || true: by now the work is done; EOF on this trailing prompt
        # (scripted use) must not take set -e down with it. EOF leaves
        # answer empty, i.e. "n".
        read -p "Add '127.0.0.1 ${domain}' to /etc/hosts now? (y/n): " answer || true
        if [[ "$answer" =~ ^[Yy]$ ]] && echo "127.0.0.1    ${domain}" | sudo tee -a /etc/hosts >/dev/null; then
            print_info "Added ${domain} to /etc/hosts"
            return 0
        fi
    fi
    echo "  Remember: echo '127.0.0.1    ${domain}' | sudo tee -a /etc/hosts"
}

# Drops the entry ensure_hosts_entry would have written for <domain>. Only
# that exact form -- a line the user wrote themselves (extra names, an
# IPv6 address) is theirs to remove.
remove_hosts_entry() {
    local domain="$1" pattern
    pattern="^127\.0\.0\.1[[:space:]]+$(printf '%s' "$domain" | sed 's/\./\\./g')[[:space:]]*$"
    grep -Eq "$pattern" /etc/hosts 2>/dev/null || return 0
    if [ -n "${WPDEV_IN_API:-}" ] \
        && host_hosts_edit "$domain" "grep -Ev '${pattern}' /hosts > /tmp/h; cat /tmp/h > /hosts"; then
        print_info "Removed ${domain} from /etc/hosts"
        return 0
    fi
    echo "  It's still in /etc/hosts — remove it if you like:"
    echo "  sudo sed -i -E '/${pattern}/d' /etc/hosts"
}

# mkcert a certificate for <domain> into nginx/ssl, replacing any existing
# one only once the new one exists.
issue_cert() {
    local domain="$1" cert key
    command -v mkcert >/dev/null 2>&1 || return 1
    mkdir -p nginx/ssl/certs nginx/ssl/private
    cert="nginx/ssl/certs/${domain}.pem"
    key="nginx/ssl/private/${domain}-key.pem"
    if ! mkcert -cert-file "${cert}.new" -key-file "${key}.new" "$domain" >/dev/null 2>&1; then
        rm -f "${cert}.new" "${key}.new"
        return 1
    fi
    mv -f "${cert}.new" "$cert"
    mv -f "${key}.new" "$key"
}

# Writes the admin-domain server blocks: <admin-domain> forwarding to
# <site-domain>'s vhost.
render_admin_domain() {
    local site_domain="$1" admin="$2" site_name port conf
    site_name="$(site_name_of "$site_domain")"
    port="$(nginx_https_port)"
    conf="$(admin_domain_conf "$site_domain")"
    mkdir -p "$(dirname "$conf")"
    cat > "$conf" <<CONF
# Managed by \`wpdev admin-domain\` for ${site_domain} -- re-run it rather
# than editing this file.
# admin-domain: ${admin}
server {
    listen 80;
    server_name ${admin};
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl;
    server_name ${admin};
    client_max_body_size 256M;

    ssl_certificate /etc/nginx/ssl/certs/${admin}.pem;
    ssl_certificate_key /etc/nginx/ssl/private/${admin}-key.pem;

    access_log /var/log/nginx/${site_name}_admin_access.log;
    error_log /var/log/nginx/${site_name}_admin_error.log;

    # Like production's reverse proxy: WordPress sees the site's own Host,
    # and X-Forwarded-Host tells the project's code the request came in
    # through the admin domain. The upstream is this same nginx.
    proxy_http_version 1.1;
    proxy_set_header Host ${site_domain};
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port ${port};
    proxy_set_header X-Forwarded-Host ${admin};
    proxy_ssl_server_name on;
    proxy_ssl_name ${site_domain};
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 600s;

    # WordPress's own redirects (login, logout, auth) stay on this domain.
    proxy_redirect $(site_url "$site_domain")/ $(site_url "$admin")/;
    proxy_redirect http://${site_domain}/ $(site_url "$admin")/;

    # Frontend requests the admin domain still answers: post previews, the
    # Customizer's preview (it tags every request with its changeset), and
    # REST calls without pretty permalinks. They need the login, which only
    # this domain has.
    set \$wpdev_admin_pass "";
    if (\$arg_preview = "true") {
        set \$wpdev_admin_pass 1;
    }
    if (\$arg_customize_changeset_uuid != "") {
        set \$wpdev_admin_pass 1;
    }
    if (\$arg_rest_route != "") {
        set \$wpdev_admin_pass 1;
    }
    error_page 418 = @wpdev_site;

    location = / {
        if (\$wpdev_admin_pass) {
            return 418;
        }
        return 301 /wp-admin/;
    }

    location = /wp-admin {
        return 301 /wp-admin/;
    }

    location /wp-admin/ {
        proxy_pass https://127.0.0.1;
    }

    location = /wp-login.php {
        proxy_pass https://127.0.0.1;
    }

    location /wp-includes/ {
        proxy_pass https://127.0.0.1;
    }

    location /wp-content/ {
        proxy_pass https://127.0.0.1;
    }

    # Only used once the project points rest_url() at the admin domain:
    # the login cookie is only sent to this host.
    location /wp-json/ {
        proxy_pass https://127.0.0.1;
    }

    location / {
        if (\$wpdev_admin_pass) {
            return 418;
        }
        return 404;
    }

    location @wpdev_site {
        proxy_pass https://127.0.0.1;
    }
}
CONF

    conf="$(admin_domain_frontend_conf "$site_domain")"
    mkdir -p "$(dirname "$conf")"
    cat > "$conf" <<CONF
# Managed by \`wpdev admin-domain\` for ${site_domain}: wp-admin and the
# login live on ${admin}, so send the browser there. 302, not 301, so
# browsers don't remember it after \`wpdev admin-domain ${site_name} off\`.
set \$wpdev_to_admin "";
if (\$uri ~ "^/(wp-admin(/.*)?|wp-login\.php)\$") {
    set \$wpdev_to_admin 1;
}
# Public pages post to these, so they stay on this domain.
if (\$uri ~ "^/wp-admin/(admin-ajax|admin-post)\.php\$") {
    set \$wpdev_to_admin "";
}
# Requests the admin domain forwards here (from this nginx itself).
set \$wpdev_from_admin "\$http_x_forwarded_host|\$remote_addr";
if (\$wpdev_from_admin = "${admin}|127.0.0.1") {
    set \$wpdev_to_admin "";
}
if (\$wpdev_to_admin) {
    return 302 $(site_url "$admin")\$request_uri;
}
CONF
}

cmd_admin_domain() {
    arg="$1"
    mode="$2"
    if [ -z "$arg" ]; then
        print_warning "Usage: wpdev admin-domain <site-name> [<domain>|on|off]"
        echo "  wpdev admin-domain mysite admin-mysite.test   # serve mysite's wp-admin on admin-mysite.test too"
        echo "  wpdev admin-domain mysite on                  # same, with the domain from last time"
        echo "  wpdev admin-domain mysite off                 # stop serving it"
        echo "  wpdev admin-domain mysite                     # show the current state"
        return 1
    fi
    resolve_site "$arg"
    [ -f "nginx/sites/${domain}.conf" ] || print_error "No such site: ${site_name} (checked nginx/sites/${domain}.conf)"
    conf="$(admin_domain_conf "$domain")"
    current="$(site_admin_domain "$site_name")"

    case "$mode" in
        "")
            # Formats the dashboard parses too -- keep them stable.
            if [ -n "$current" ]; then
                print_info "On: $(site_url "$current")  →  $(site_url "$domain")"
            elif [ -n "$(site_get "$site_name" ADMIN_DOMAIN)" ]; then
                print_info "Off (last admin domain: $(site_get "$site_name" ADMIN_DOMAIN))"
            else
                print_info "Off"
            fi
            return 0
            ;;
        off)
            rm -f "$conf" "$(admin_domain_frontend_conf "$domain")"
            reload_nginx_or_fail || print_warning "nginx didn't reload (is it running?) — takes effect on its next start: wpdev up"
            removed="$(remove_admin_domain_plugin "$site_name")"
            [ -n "$removed" ] && print_info "Removed wpdev's mu-plugin (${removed})"
            print_info "Admin domain off for ${domain}${current:+ (${current} is no longer served)}; wp-admin is on ${domain} again."
            return 0
            ;;
        on)
            admin="$(site_get "$site_name" ADMIN_DOMAIN)"
            [ -n "$admin" ] || print_error "No admin domain known for ${site_name}. Give it once: wpdev admin-domain ${site_name} admin-${site_name}.${domain##*.}"
            ;;
        *)
            admin="$mode"
            ;;
    esac

    admin="$(echo "$admin" | tr 'A-Z' 'a-z')"
    # Becomes part of an nginx config, so only a plain hostname gets through.
    valid_domain "$admin" \
        || print_error "Not a usable domain: '${admin}' (expected e.g. admin-${site_name}.test)"
    [ -f "nginx/sites/${admin}.conf" ] && print_error "${admin} is a site of its own — pick a domain no site uses."
    is_real_domain "$admin" && print_error "${admin} is a real domain (.${admin##*.} is a public top-level domain), and this machine would stop reaching it. Use a local suffix such as .test"
    other="$(grep -l "^# admin-domain: ${admin}$" nginx/sites/admin-domain/*.conf 2>/dev/null | grep -vx "$conf" | head -1)" || true
    [ -n "$other" ] && print_error "${admin} is already the admin domain of $(basename "$other" .conf)."

    docker exec wp-nginx true >/dev/null 2>&1 || print_error "nginx isn't running — start the stack first: wpdev up"

    if [ ! -f "nginx/ssl/certs/${admin}.pem" ] || [ -n "$(cert_problem "$admin")" ]; then
        issue_cert "$admin" || print_error "Couldn't issue a certificate for ${admin} — is mkcert installed? (wpdev install-mkcert)"
        print_info "Certificate issued for ${admin}"
    fi

    # A cached vhost from before admin domains existed would cache forwarded
    # requests under the site's own host; regenerate it with the rule that
    # skips them, and drop anything already cached.
    if grep -q 'fastcgi_cache ' "nginx/sites/${domain}.conf" && ! grep -q 'http_x_forwarded_host' "nginx/sites/${domain}.conf"; then
        ( cmd_cache "$site_name" on ) >/dev/null || print_error "Couldn't regenerate ${domain}'s cached vhost — run: wpdev cache ${site_name} on"
        ( cmd_cache_purge ) >/dev/null || true
        print_info "Regenerated ${domain}'s cached vhost so it never caches requests from the admin domain"
    fi

    site_set "$site_name" ADMIN_DOMAIN "$admin"
    fconf="$(admin_domain_frontend_conf "$domain")"
    for f in "$conf" "$fconf"; do
        if [ -f "$f" ]; then cp "$f" "${f}.bak"; else rm -f "${f}.bak"; fi
    done
    render_admin_domain "$domain" "$admin"
    ensure_vhost_includes "$domain"
    if ! reload_nginx_or_fail; then
        for f in "$conf" "$fconf"; do
            if [ -f "${f}.bak" ]; then mv -f "${f}.bak" "$f"; else rm -f "$f"; fi
        done
        reload_nginx_or_fail || true
        print_error "nginx rejected the admin-domain config, so it was rolled back. Check: docker exec wp-nginx nginx -t"
    fi
    rm -f "${conf}.bak" "${fconf}.bak"
    if [ -n "$current" ] && [ "$current" != "$admin" ] && ! admin_domain_in_use "$current" "$domain"; then
        rm -f "nginx/ssl/certs/${current}.pem" "nginx/ssl/private/${current}-key.pem"
        print_info "${current} is no longer served (its certificate was removed)"
    fi
    print_info "Admin domain on: $(site_url "$admin")  →  $(site_url "$domain") (wp-admin, wp-login.php, wp-includes, wp-content, wp-json, previews, Customizer)"
    print_info "${domain}/wp-admin and /wp-login.php now redirect to ${admin} (admin-ajax.php and admin-post.php stay)"

    ensure_hosts_entry "$admin" 0

    # The URL rewriting: the project's own code if it has some (it defines
    # WP_ADMIN_DOMAIN -- wpdev's plugin doesn't), else wpdev's mu-plugin.
    # wpdev's is removed first, so the check sees only the project.
    php_svc="$(site_php_service "$site_name")"
    removed="$(remove_admin_domain_plugin "$site_name")"
    info="$(php_exec "$php_svc" wp eval \
        'echo "WPDEV|", defined("WP_ADMIN_DOMAIN") ? WP_ADMIN_DOMAIN : "", "|", WPMU_PLUGIN_DIR, "\n";' \
        --path="/var/www/${site_name}" </dev/null 2>/dev/null | grep '^WPDEV|' | tail -1 | tr -d '\r')" || true
    project_domain="$(echo "$info" | cut -d'|' -f2)"
    mu_dir="$(echo "$info" | cut -d'|' -f3)"
    if [ -z "$info" ]; then
        if [ -n "$removed" ]; then
            print_warning "Removed wpdev's mu-plugin but couldn't check the site with WP-CLI to put it back — re-run once ${site_name} works: wpdev admin-domain ${site_name} on"
        else
            print_warning "Couldn't check ${site_name} with WP-CLI, so wpdev's mu-plugin wasn't installed. Re-run once it works: wpdev admin-domain ${site_name} on"
        fi
    elif [ "$project_domain" = "$admin" ]; then
        print_info "${site_name} handles ${admin} itself (WP_ADMIN_DOMAIN=${admin}), so wpdev's mu-plugin isn't installed"
    elif [ -n "$project_domain" ]; then
        print_warning "${site_name} defines WP_ADMIN_DOMAIN=${project_domain}, not ${admin}: its own admin-domain code won't kick in for ${admin}, and wpdev's mu-plugin isn't installed alongside it. Point WP_ADMIN_DOMAIN at ${admin}."
    else
        case "$mu_dir" in
            "/var/www/${site_name}"|"/var/www/${site_name}/"*) ;;
            *) print_error "${site_name}'s mu-plugins dir (${mu_dir}) isn't inside the site, so wpdev's mu-plugin can't be installed." ;;
        esac
        host_dir="sites/${site_name}${mu_dir#/var/www/${site_name}}"
        mkdir -p "$host_dir"
        sed -e "s#__WPDEV_ADMIN_DOMAIN__#${admin}#" -e "s#__WPDEV_ADMIN_ORIGIN__#$(site_url "$admin")#" \
            wordpress/mu-plugins/${ADMIN_DOMAIN_PLUGIN} > "${host_dir}/${ADMIN_DOMAIN_PLUGIN}"
        print_info "Installed wpdev's mu-plugin: ${host_dir}/${ADMIN_DOMAIN_PLUGIN} (rewrites wp-admin's URLs to ${admin}; removed by: wpdev admin-domain ${site_name} off)"
    fi
}

# Hand a site's files back to you -- for sites from before #20, or copied
# in from elsewhere (a different machine, another local tool), where files
# can be owned by root, uid 33, or have no owner write bit. Those are what
# make wp-admin fail with "Could not create directory" / "Could not create
# the upgrade-temp-backup directory", and your editor with EACCES.
cmd_fix_perms() {
    arg="$1"
    if [ -z "$arg" ]; then
        print_warning "Usage: wpdev fix-perms <site-name>|--all"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    if [ "$arg" = "--all" ]; then
        sites="$(site_names)"
    else
        resolve_site "$arg"
        [ -f "nginx/sites/${domain}.conf" ] || print_error "No such site: ${arg} (checked nginx/sites/${domain}.conf)"
        sites="$site_name"
    fi

    for site_name in $sites; do
        php_svc="$(site_php_service "$site_name")"
        docker compose up -d "$php_svc" >/dev/null 2>&1 || true
        if ! php_runs_as_you "$php_svc"; then
            print_error "${php_svc} still runs PHP as uid $(docker compose exec -T "$php_svc" id -u www-data </dev/null 2>/dev/null | tr -d '\r'), not you ($(id -u)). Run 'wpdev up' first so it restarts with the new user mapping."
        fi
        before="$(foreign_files "$site_name" 100000 | wc -l)"
        if fix_site_ownership "$php_svc" "$site_name"; then
            print_info "sites/${site_name}: ${before} path(s) handed back to you (uid $(id -u))"
        else
            print_error "Couldn't fix ownership of sites/${site_name}."
        fi
    done
}

# Reissue a site's certificate from the current mkcert CA and reload
# nginx. `add`/`clone` never replace an existing cert, so this is the way
# out for one that expired or came from a different CA -- e.g. a site
# created from the dashboard before MKCERT_CAROOT was shared with it.
# Written to temp files first: a failed mkcert leaves the old cert (and
# a working site) in place rather than half-replaced. (#11)
cmd_cert() {
    arg="$1"
    if [ -z "$arg" ]; then
        print_warning "Usage: wpdev cert <site-name>"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    resolve_site "$arg"
    [ -f "nginx/sites/${domain}.conf" ] || print_error "No such site: ${site_name} (checked nginx/sites/${domain}.conf)"
    command -v mkcert >/dev/null 2>&1 || print_error "mkcert isn't installed — run: wpdev install-mkcert"

    issue_cert "$domain" || print_error "mkcert failed — the existing certificate was left as it was."
    print_info "Certificate reissued for ${domain} (CA: $(mkcert -CAROOT 2>/dev/null))"
    admin="$(site_admin_domain "$site_name")"
    if [ -n "$admin" ]; then
        issue_cert "$admin" || print_error "mkcert failed for the admin domain ${admin} — its existing certificate was left as it was."
        print_info "Certificate reissued for the admin domain ${admin}"
    fi

    if docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1; then
        print_info "nginx reloaded — reload the page in your browser to pick it up"
    else
        print_warning "nginx didn't reload (is it running?) — the new cert takes effect on its next start: wpdev up"
    fi
}

# Opt-in nginx FastCGI full-page cache, toggled by regenerating the site's
# vhost from one of two templates (plain vs. cached) -- the same
# DOMAIN/SITE_NAME/PHP_UPSTREAM substitution cmd_add already does, just
# picking a different source template. Lets you catch cache-interaction
# bugs (stale content, logged-in users seeing anonymous pages, broken
# cache-busting on form submits) locally before a production box with
# caching turned on ever sees them.
cmd_cache() {
    arg="$1"
    mode="$2"
    if [ -z "$arg" ] || [ -z "$mode" ]; then
        print_warning "Usage: wpdev cache <site-name> <on|off>"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    case "$mode" in
        on|off) ;;
        *) print_error "Mode must be 'on' or 'off', got '${mode}'" ;;
    esac

    resolve_site "$arg"

    if [ ! -f "nginx/sites/${domain}.conf" ]; then
        print_error "No such site: ${site_name} (checked nginx/sites/${domain}.conf)"
    fi

    php_svc="$(site_php_service "$site_name")"
    if [ "$mode" = "on" ]; then
        template="nginx/sites/site.conf.cached.template"
    else
        template="nginx/sites/site.conf.template"
    fi

    sed "s/DOMAIN/$domain/g" "$template" > "nginx/sites/${domain}.conf"
    sed -i "s|/var/www/SITE_NAME|/var/www/$site_name|g" "nginx/sites/${domain}.conf"
    sed -i "s/SITE_NAME/$site_name/g" "nginx/sites/${domain}.conf"
    sed -i "s/PHP_UPSTREAM/$php_svc/g" "nginx/sites/${domain}.conf"

    if [ "$mode" = "on" ]; then
        # CACHE_TTL -- a plain duration (60m, 1h, 30s), not nginx syntax to
        # hand-tune; validated so a typo fails here with a clear message
        # instead of a cryptic nginx -t error later. Most sites have none.
        ttl="$(site_get "$site_name" CACHE_TTL)"
        [ -z "$ttl" ] && ttl="60m"
        if [[ ! "$ttl" =~ ^[0-9]+[smhdwMy]?$ ]]; then
            print_error "Invalid CACHE_TTL value '${ttl}' in $(site_config_file "$site_name") -- expected a plain duration like 60m, 1h, or 30s."
        fi

        # CACHE_BYPASS_COOKIES -- space-separated cookie names, never raw
        # regex. A trailing '*' means "starts with" (needed for
        # cookies with a dynamic suffix, e.g. WooCommerce's session cookie);
        # anything else must match that exact name. Validated against a
        # strict whitelist BEFORE it's escaped and spliced into nginx's
        # bypass regex, so the setting can't break the generated config or
        # smuggle in nginx syntax -- it only ever contains cookie names.
        bypass="comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in"
        cookie_setting="CACHE_BYPASS_COOKIES in $(site_config_file "$site_name")"
        if [ -n "$(site_get "$site_name" CACHE_BYPASS_COOKIES)" ]; then
            # One per line (not `for x in $list`, which would glob-expand a
            # trailing '*').
            while IFS= read -r line; do
                [ -z "$line" ] && continue

                name="$line"
                case "$name" in
                    *'*') name="${name%\*}" ;;
                esac
                case "$name" in
                    *[!A-Za-z0-9_.-]*|'')
                        print_error "Invalid entry in ${cookie_setting}: '${line}' -- cookie names may only contain letters, digits, '_', '-', '.', and an optional trailing '*' for a prefix match."
                        ;;
                esac
                # Only '.' needs escaping -- the whitelist above already
                # excludes every other regex-meaningful character. Doubled
                # backslash here (not a single \.) because $bypass is used
                # as a sed REPLACEMENT value below, and sed's own escape
                # handling in that position silently consumes one layer of
                # backslash -- confirmed the hard way: without this, the
                # generated nginx config had a literal unescaped '.' where
                # a cookie name like "my.cookie" should have had '\.'.
                escaped="$(echo "$name" | sed 's/\./\\\\./g')"
                bypass="${bypass}|${escaped}"
            done < <(site_get "$site_name" CACHE_BYPASS_COOKIES | tr -s ' ' '\n')
        fi

        # CACHE_BYPASS_PATHS -- space-separated URL paths, never raw regex.
        # Same trailing-'*'-means-prefix contract as the cookies, but
        # anchored (^pattern$ for exact, ^pattern for prefix)
        # rather than loose substring -- unlike cookie names, URL paths
        # routinely share prefixes (a bare substring match on /cart/ would
        # also false-positive on /shop/cart/), so this one needs real
        # anchoring to mean what it looks like it means. The baseline
        # wp-admin/xmlrpc/wp-login/wp-cron rules get the same anchoring.
        bypass_paths='^/wp-admin/|^/xmlrpc\\.php$|^/wp-login\\.php$|^/wp-cron\\.php$'
        path_setting="CACHE_BYPASS_PATHS in $(site_config_file "$site_name")"
        if [ -n "$(site_get "$site_name" CACHE_BYPASS_PATHS)" ]; then
            while IFS= read -r line; do
                [ -z "$line" ] && continue

                path="$line"
                is_prefix=0
                case "$path" in
                    *'*') path="${path%\*}"; is_prefix=1 ;;
                esac
                case "$path" in
                    *[!A-Za-z0-9/_.-]*|'')
                        print_error "Invalid entry in ${path_setting}: '${line}' -- paths may only contain letters, digits, '/', '_', '-', '.', and an optional trailing '*' for a prefix match."
                        ;;
                esac
                # Same doubled-backslash reasoning as the cookie escaping
                # above -- $bypass_paths is a sed REPLACEMENT value too.
                escaped="$(echo "$path" | sed 's/\./\\\\./g')"
                if [ "$is_prefix" -eq 1 ]; then
                    bypass_paths="${bypass_paths}|^${escaped}"
                else
                    bypass_paths="${bypass_paths}|^${escaped}\$"
                fi
            done < <(site_get "$site_name" CACHE_BYPASS_PATHS | tr -s ' ' '\n')
        fi

        sed -i "s/CACHE_TTL/$ttl/g" "nginx/sites/${domain}.conf"
        sed -i "s/CACHE_BYPASS_COOKIES/$bypass/g" "nginx/sites/${domain}.conf"
        # '#' delimiter, not '/': unlike cookie names, every path value
        # contains '/' by definition (e.g. "/cart/"), which would otherwise
        # end the sed replacement field early -- confirmed the hard way,
        # this broke outright the moment a real path was involved.
        sed -i "s#CACHE_BYPASS_PATHS#$bypass_paths#g" "nginx/sites/${domain}.conf"
    fi

    if [ "$mode" = "on" ]; then
        site_set "$site_name" CACHE on

        # nginx-helper: auto-purges this site's own cached pages on save,
        # via its "unlink files" method -- verified directly against the
        # plugin's source that this needs zero nginx-side changes, since
        # our fastcgi_cache_path (levels=1:2) and fastcgi_cache_key
        # ("$scheme$request_method$host$request_uri") already exactly
        # match what unlink_files expects (it's the plugin's own
        # documented recipe). Needs the cache directory actually shared
        # between nginx and php (see docker-compose.yml) -- PHP has no
        # other way to reach files nginx wrote.
        #
        # Best-effort, not required: the core caching feature below is
        # pure nginx config with zero WordPress dependency, and must keep
        # working even if this plugin fails to install (e.g. no network
        # reaching wordpress.org). Confirmed the hard way that an
        # unguarded failure here aborted the whole function before ever
        # reaching the nginx reload -- the vhost got regenerated on disk
        # with caching enabled, but nginx never actually reloaded to pick
        # it up, so the site silently got no caching at all.
        nh_ok=1
        if php_exec "$php_svc" wp plugin is-installed nginx-helper --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
            php_exec "$php_svc" wp plugin activate nginx-helper --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || nh_ok=0
        else
            php_exec "$php_svc" wp plugin install nginx-helper --activate --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || nh_ok=0
        fi
        if [ "$nh_ok" -eq 1 ]; then
            php_exec "$php_svc" wp config set RT_WP_NGINX_HELPER_CACHE_PATH '/var/cache/nginx/fastcgi' --type=constant --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || nh_ok=0
        fi
        if [ "$nh_ok" -eq 1 ]; then
            # Full options array, not just the two keys that matter
            # (enable_purge, purge_method) -- activating via WP-CLI never
            # populates this option at all (the plugin's own activator
            # checks current_user_can(), always false with no WP-CLI user
            # context, so its store_default_options() call never runs).
            # Values taken directly from the plugin's own
            # nginx_helper_default_settings(), not guessed.
            php_exec "$php_svc" wp option update rt_wp_nginx_helper_options '{"enable_purge":1,"cache_method":"enable_fastcgi","purge_method":"unlink_files","enable_map":0,"enable_log":0,"log_level":"INFO","log_filesize":"5","enable_stamp":0,"purge_homepage_on_edit":1,"purge_homepage_on_del":1,"purge_archive_on_edit":1,"purge_archive_on_del":1,"purge_archive_on_new_comment":0,"purge_archive_on_deleted_comment":0,"purge_page_on_mod":1,"purge_page_on_new_comment":1,"purge_page_on_deleted_comment":1,"purge_feeds":1,"redis_hostname":"127.0.0.1","redis_port":"6379","redis_prefix":"nginx-cache:","redis_unix_socket":"","redis_database":0,"redis_username":"","redis_password":"","purge_url":"","redis_enabled_by_constant":0,"purge_amp_urls":1,"redis_socket_enabled_by_constant":0,"redis_acl_enabled_by_constant":0,"preload_cache":0,"is_cache_preloaded":0,"roles_with_purge_cap":[],"purge_woo_products":0}' --format=json --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || nh_ok=0
        fi
        if [ "$nh_ok" -eq 1 ]; then
            print_info "nginx-helper installed and configured for auto-purge on save"
        else
            print_warning "Could not set up nginx-helper (auto-purge on save) -- caching still works, just purge manually with 'wpdev cache-purge' or wait out the TTL. Retry with: wpdev cache ${site_name} on"
        fi
    else
        site_unset "$site_name" CACHE
        php_exec "$php_svc" wp plugin deactivate nginx-helper --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || true
    fi

    if docker exec wp-nginx nginx -t >/dev/null 2>&1; then
        docker exec wp-nginx nginx -s reload >/dev/null 2>&1
    else
        print_error "Generated an invalid nginx config for ${domain} -- run 'docker exec wp-nginx nginx -t' to see why."
    fi

    if [ "$mode" = "on" ]; then
        print_info "Full-page cache enabled for ${domain}."
        echo "Check it: curl -skI $(site_url "$domain")/ | grep -i x-fastcgi-cache"
        echo "(MISS the first request, HIT after -- BYPASS whenever you're logged in,"
        echo "posting a form, or hitting wp-admin.)"
    else
        print_info "Full-page cache disabled for ${domain}."
    fi
}

cmd_cache_purge() {
    if docker compose exec -T nginx true </dev/null >/dev/null 2>&1; then
        docker compose exec -T nginx sh -c "rm -rf /var/cache/nginx/fastcgi/*" </dev/null 2>/dev/null
        print_info "Full-page cache purged (shared across every site that has it enabled)."
    else
        print_warning "Nginx isn't running -- nothing to purge."
    fi
}

cmd_backup() {
    mkdir -p backups
    timestamp=$(date +%Y%m%d_%H%M%S)
    echo "Creating backup..."
    docker exec wp-mysql mysqldump -u root -p"$(grep DB_ROOT_PASSWORD .env | cut -d '=' -f2)" --all-databases > "backups/all_databases_${timestamp}.sql"
    echo "Backup saved to: backups/all_databases_${timestamp}.sql"
}

# Counterpart to `backup` -- until this existed, backup was one-directional:
# you could dump every database, but the only way to actually use that dump
# was hand-crafting a `mysql < dump.sql` yourself. A mysqldump --all-databases
# file already contains its own CREATE DATABASE/USE statements per database,
# so piping the whole thing into a bare `mysql` (no database selected) is the
# standard, correct way to restore one.
cmd_restore_all() {
    assume_yes=0
    args=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            *) args+=("$a") ;;
        esac
    done
    in_file="${args[0]:-}"
    if [ -z "$in_file" ]; then
        # Lexical sort = chronological, same reasoning as snapshot IDs: the
        # timestamp format (YYYYMMDD_HHMMSS) sorts correctly as text.
        in_file="$(ls -1 backups/all_databases_*.sql backups/all_databases_*.sql.gz 2>/dev/null | sort | tail -1)"
        if [ -z "$in_file" ]; then
            print_error "No backups found in backups/. Run 'wpdev backup' first, or pass a file explicitly."
        fi
        print_info "No file given — using the most recent backup: ${in_file}"
    fi
    if [ ! -f "$in_file" ]; then
        print_error "No such file: ${in_file}"
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    echo "This will REPLACE every database currently in MySQL with the contents of:"
    echo "  ${in_file}"
    echo ""
    echo "Any current data not already in this backup will be lost. This does NOT"
    echo "back up the current state first — run 'wpdev backup' before this if you"
    echo "want to keep what's there now."
    echo ""
    echo "Known sites right now: $(site_names | tr '\n' ' ')"
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Type RESTORE to confirm: " confirm
        if [ "$confirm" != "RESTORE" ]; then
            cancelled
        fi
    fi

    print_step "1/2 Restoring from ${in_file}..."
    # Not swallowing stderr here (unlike db-import) -- this touches every
    # database at once, so a partial/silent failure is worth seeing.
    if gzip -t "$in_file" 2>/dev/null; then
        gunzip -c "$in_file" | docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD"
    else
        docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" < "$in_file"
    fi
    print_info "Databases restored"

    print_step "2/2 Flushing Redis (every site's object cache)..."
    if docker compose exec -T redis true </dev/null >/dev/null 2>&1; then
        docker compose exec -T redis redis-cli FLUSHALL >/dev/null 2>&1
    fi
    print_info "Cache flushed"

    echo ""
    print_info "All databases restored from ${in_file}."
}

cmd_install_mkcert() { ./install-mkcert.sh; }

cmd_clean() { docker compose down; }

cmd_clean_all() {
    assume_yes=0
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
        esac
    done
    echo "⚠️  WARNING: This will delete all WordPress files and databases!"
    if [ "$assume_yes" -eq 1 ]; then
        confirm="yes"
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Are you sure? (yes/no): " confirm
    fi
    if [ "$confirm" = "yes" ]; then
        docker compose down -v
        rm -rf sites/*/ "$SITE_CONFIG_DIR"
        echo "All data removed."
    else
        cancelled
    fi
}

# Full removal, in three separately-confirmed stages — each one is
# independently safe to stop after, so cancelling partway through never
# leaves a confusing half-removed state:
#   1. containers + volumes + the images built from this repo (same as
#      clean-all, plus --rmi local, since clean-all alone leaves the
#      wp-local-dev-phpXX images behind)
#   2. the `wpdev` symlink on PATH (only if it actually points at this
#      checkout -- never touches a symlink belonging to some other project)
#   3. this directory itself, including every site's files, logs,
#      snapshots, and backups -- requires typing DELETE, not just yes/no,
#      since unlike steps 1-2 there is no undo
cmd_uninstall() {
    print_warning "This removes wp-local-dev's containers, volumes, and built images."
    echo "Site files on disk (sites/, backups/, snapshots/, logs/) are not touched by this step."
    read -p "Continue? (yes/no): " confirm
    if [ "$confirm" != "yes" ]; then
        cancelled
    fi
    docker compose down -v --rmi local
    print_info "Containers, volumes, and images removed."

    for bin_dir in "$HOME/.local/bin" "/usr/local/bin"; do
        link="${bin_dir}/wpdev"
        if [ -L "$link" ] && [ "$(readlink -f "$link")" = "${SCRIPT_DIR}/wpdev" ]; then
            rm -f "$link"
            print_info "Removed symlink ${link}"
        fi
    done

    echo
    echo "Everything above this line is done. What's left is this directory itself:"
    echo "  ${SCRIPT_DIR}"
    echo "including every site's files, database dumps, and snapshots -- there is no undo for this part."
    read -p "Delete it too? Type DELETE to confirm, anything else to keep it: " confirm2
    if [ "$confirm2" = "DELETE" ]; then
        target="$SCRIPT_DIR"
        cd /
        rm -rf "$target"
        echo "wp-local-dev fully removed."
    else
        print_info "Directory kept. Remove it yourself anytime with: rm -rf ${SCRIPT_DIR}"
    fi
}

# ---------------------------------------------------------------------------
# Sites
# ---------------------------------------------------------------------------

# Domains are derived from nginx/sites/*.conf, the actual source of truth for
# what's routable (default.conf is the catch-all, not a site; .template isn't
# a config at all — both excluded).
site_domains() {
    for conf in nginx/sites/*.conf; do
        [ -e "$conf" ] || continue
        name="$(basename "$conf" .conf)"
        [ "$name" = "default" ] && continue
        echo "$name"
    done
}

# The suffix a bare site name gets (`wpdev add shop` -> shop.test):
# DOMAIN_SUFFIX in .env, "test" if unset. Any suffix works for a single
# site -- give the full domain (shop.local) -- this is only the default.
domain_suffix() {
    local suffix
    suffix="$(sed -n 's/^DOMAIN_SUFFIX=//p' .env 2>/dev/null | tail -1)"
    suffix="${suffix#.}"
    echo "${suffix:-test}"
}

# A domain's site name, i.e. its directory under sites/. For an existing
# site that's whatever its vhost serves; a new one gets the domain minus
# its suffix, dots as dashes (shop.local -> shop, blog.shop.test ->
# blog-shop). Looked up rather than recomputed, so a site keeps its name
# whatever DOMAIN_SUFFIX later becomes.
site_name_of() {
    local conf="nginx/sites/$1.conf" name=""
    [ -f "$conf" ] && name="$(sed -n 's|^[[:space:]]*root /var/www/\([^/;]*\);.*|\1|p' "$conf" | head -1)"
    if [ -z "$name" ]; then
        name="${1%.*}"
        name="${name//./-}"
    fi
    echo "$name"
}

# A site's domain from its name: the vhost that serves sites/<name>, or
# <name>.<DOMAIN_SUFFIX> if none does.
site_domain_of() {
    local d
    for d in $(site_domains); do
        [ "$(site_name_of "$d")" = "$1" ] && { echo "$d"; return 0; }
    done
    echo "$1.$(domain_suffix)"
}

# Every site's name, one per line.
site_names() {
    local d
    for d in $(site_domains); do site_name_of "$d"; done
}

# Sets site_name and domain from a command's <site> argument, which may be
# the site's name (shop) or its domain (shop.test, shop.local).
resolve_site() {
    if [ -f "nginx/sites/$1.conf" ]; then
        domain="$1"
    else
        domain="$(site_domain_of "$(site_name_of "$1")")"
    fi
    site_name="$(site_name_of "$domain")"
}

# A freshly-created MySQL container (first-ever `up`, or any CI run, which
# is always a cold start) takes a few seconds to accept connections after
# `docker compose up` returns -- the container exists and is "Started" well
# before mysqld inside it is actually ready. Without this wait, the CREATE
# DATABASE step right after can fail outright against a cold MySQL, which
# never showed up testing by hand (this machine's MySQL was always already
# warm) and was only caught by the CI smoke test's first real run.
#
# -h127.0.0.1 forces a TCP connection, not a Unix socket -- confirmed by
# direct reproduction that mysqld's own bootstrap phase (which sets the
# root password and runs init scripts, before the real server starts)
# listens on the socket but not TCP, so a socket-based ping here can
# report "ready" during a ~5s window where the server is about to shut
# down and restart, right before the CREATE DATABASE step would run.
wait_for_mysql() {
    for _ in $(seq 1 30); do
        docker compose exec -T mysql mysqladmin ping -h127.0.0.1 -uroot -p"$DB_ROOT_PASSWORD" --silent </dev/null >/dev/null 2>&1 && return 0
        sleep 1
    done
    print_error "MySQL did not become ready within 30 seconds."
}

# "8.3" -> "php83" — the compose service/container name for a PHP version.
php_slug() { echo "php${1//./}"; }

# The compose service (php81/php82/php83/php84) that actually serves a given
# site, based on its PHP_VERSION. Falls back to the default version
# for sites that predate multi-PHP support (none saved) — which is
# exactly the version their Nginx vhost's literal `php:9000` already points
# at via the alias on php82, so this stays consistent with reality without
# needing every pre-existing site retrofitted.
site_php_service() {
    version="$(site_get "$1" PHP_VERSION)"
    [ -z "$version" ] && version="$DEFAULT_PHP_VERSION"
    php_slug "$version"
}

# Snapshot IDs sort lexically = chronologically, since they start with
# YYYYMMDD_HHMMSS.
site_snapshots() {
    for d in "snapshots/${1}"/*/; do
        [ -d "$d" ] || continue
        basename "$d"
    done | sort
}

cmd_list() {
    print_header "=== Configured WordPress Sites ==="
    echo ""

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        print_warning "No sites configured yet. Run: wpdev add"
        return
    fi

    for domain in $domains; do
        site_name="$(site_name_of "$domain")"
        if [ -d "sites/${site_name}" ]; then
            php_version="$(site_get "$site_name" PHP_VERSION)"
            [ -z "$php_version" ] && php_version="$DEFAULT_PHP_VERSION"
            wp_status="provisioned, php ${php_version}"
            site_is_off "$site_name" && wp_status="${wp_status}, off"
        else
            wp_status="no site files found (expected sites/${site_name})"
        fi
        echo "  $(site_url "$domain")  →  sites/${site_name}  ($wp_status)"
    done
    echo ""
}

# Runs <program> [args...] against the host desktop's session bus, from the
# api container: DESKTOP_BUS in .env (set by `wpdev up`), or exit 2 if
# there's none. From a throwaway container of the api's own image (it has
# dbus-send and gdbus), as you, without AppArmor: the session bus refuses
# anything under Docker's default AppArmor profile, and this way only
# that one call goes without it, never the api itself.
desktop_bus_run() {
    local bus
    bus="$(sed -n 's/^DESKTOP_BUS=//p' .env 2>/dev/null | tail -1)"
    [ -n "$bus" ] || return 2
    docker run --rm --network none --security-opt apparmor=unconfined \
        --user "$(id -u):$(id -g)" -v "${bus}:/bus" -e DBUS_SESSION_BUS_ADDRESS=unix:path=/bus \
        --entrypoint "$1" "$(docker inspect -f '{{.Config.Image}}' wp-api)" "${@:2}" \
        </dev/null >/dev/null 2>&1
}

# Terminal editors `wpdev open --editor=` can open a site in.
OPEN_EDITORS="nvim"

# Opens a site's folder: in the desktop's file manager, or with
# --editor=nvim in Neovim, in a new terminal window
# (scripts/edit-in-terminal.sh). From the host that's xdg-open (open on
# macOS), or the script itself. From the api container -- the dashboard's
# folder menu -- it goes over the host's session bus (desktop_bus_run):
# org.freedesktop.FileManager1, which Nautilus, Nemo, Dolphin and others
# answer, or the session's systemd, asked to start that script as you
# (it has your display; the api has none). The project is mounted at the
# same path in the api, so paths mean the same on the host.
cmd_open() {
    local arg="" editor="" a dir unit rc=0
    for a in "$@"; do
        case "$a" in
            --editor=*) editor="${a#--editor=}" ;;
            *) arg="$a" ;;
        esac
    done
    if [ -z "$arg" ]; then
        print_warning "Usage: wpdev open <site-name> [--editor=nvim]"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    if [ -n "$editor" ] && ! [[ " ${OPEN_EDITORS} " == *" ${editor} "* ]]; then
        print_error "Unknown editor '${editor}'. Supported: ${OPEN_EDITORS}"
    fi
    resolve_site "$arg"
    dir="${SCRIPT_DIR}/sites/${site_name}"
    [ -d "$dir" ] || print_error "No such site: ${arg} (checked sites/${site_name})"

    if [ -n "$editor" ]; then
        if [ -n "${WPDEV_IN_API:-}" ]; then
            # A transient user unit, like `systemd-run --user`; the unique
            # name lets several be open at once.
            unit="wpdev-edit-${site_name}-$(date +%s%N).service"
            desktop_bus_run gdbus call --session --dest org.freedesktop.systemd1 \
                --object-path /org/freedesktop/systemd1 --method org.freedesktop.systemd1.Manager.StartTransientUnit \
                "$unit" replace \
                "[('ExecStart', <[('/bin/sh', ['/bin/sh', '${SCRIPT_DIR}/scripts/edit-in-terminal.sh', '${dir}', '${editor}'], false)]>), ('CollectMode', <'inactive-or-failed'>)]" \
                "[]" || rc=$?
        else
            setsid "${SCRIPT_DIR}/scripts/edit-in-terminal.sh" "$dir" "$editor" >/dev/null 2>&1 < /dev/null &
        fi
    elif [ -n "${WPDEV_IN_API:-}" ]; then
        desktop_bus_run dbus-send --session --print-reply \
            --dest=org.freedesktop.FileManager1 /org/freedesktop/FileManager1 \
            org.freedesktop.FileManager1.ShowFolders "array:string:file://${dir// /%20}" string: || rc=$?
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$dir" >/dev/null 2>&1 &
    elif command -v open >/dev/null 2>&1; then
        open "$dir"
    else
        print_error "No way to open a folder here. It's ${dir}"
    fi
    case "$rc" in
        0) ;;
        2) print_error "No desktop session to open it in: that takes a Linux desktop, and a 'wpdev up' from it. The folder is ${dir}" ;;
        *) if [ -n "$editor" ]; then
               print_error "Your desktop session didn't start a terminal for ${editor}. The folder is ${dir}"
           else
               print_error "No file manager answered (org.freedesktop.FileManager1). The folder is ${dir}"
           fi ;;
    esac
    if [ -n "$editor" ]; then
        print_info "Opened ${dir} in ${editor}"
    else
        print_info "Opened ${dir}"
    fi
}

# The same check `add` makes, on its own: "ok", or why not (exit 1). A bare
# name gets DOMAIN_SUFFIX, as in `add`. For the dashboard, which asks as
# you type.
cmd_check_domain() {
    local domain problem
    domain="$(echo "$1" | tr 'A-Z' 'a-z')"
    [ -n "$domain" ] || { print_warning "Usage: wpdev check-domain <domain>"; return 1; }
    case "$domain" in *.*) ;; *) domain="${domain}.$(domain_suffix)" ;; esac
    problem="$(new_domain_problem "$domain")"
    if [ -n "$problem" ]; then
        echo "${domain}: ${problem}"
        return 1
    fi
    echo "${domain}: ok"
}

# Re-downloads data/iana-tlds.txt: new top-level domains still get
# delegated now and then. Only replaced once the download is complete and
# looks like the list.
cmd_update_tlds() {
    local tmp
    tmp="$(mktemp)"
    if ! curl -fsSL --max-time 30 https://data.iana.org/TLD/tlds-alpha-by-domain.txt -o "$tmp" \
        || ! grep -qx "COM" "$tmp"; then
        rm -f "$tmp"
        print_error "Couldn't download the list from data.iana.org"
    fi
    {
        sed -n '1,4p' "$TLD_LIST"
        sed -n '1s/^# /# IANA /p' "$tmp"
        grep -v '^#' "$tmp" | tr 'A-Z' 'a-z'
    } > "${TLD_LIST}.new"
    rm -f "$tmp"
    mv -f "${TLD_LIST}.new" "$TLD_LIST"
    print_info "$(grep -vc '^#' "$TLD_LIST") top-level domains ($(sed -n 's/^# IANA //p' "$TLD_LIST"))"
}

cmd_hosts() {
    print_header "=== Required /etc/hosts Entries ==="
    echo ""

    domains="$(site_domains)"
    if [ -z "$domains" ]; then
        print_warning "No sites configured yet."
        return
    fi

    for domain in $domains $(admin_domains); do
        echo "127.0.0.1    $domain"
    done
    echo ""
    print_info "Add missing entries with: echo '<line above>' | sudo tee -a /etc/hosts"
}

cmd_creds() {
    site="$1"
    if [ -z "$site" ]; then
        print_warning "Usage: wpdev creds <site-name>"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi

    dir="sites/${site}"
    if [ ! -d "$dir" ]; then
        print_warning "No such site directory: $dir"
        return 1
    fi

    php_version="$(site_get "$site" PHP_VERSION)"
    [ -z "$php_version" ] && php_version="$DEFAULT_PHP_VERSION"
    admin_pass="$(site_get "$site" ADMIN_PASSWORD)"
    db_pass="$(site_get "$site" DB_PASSWORD)"

    echo "Site: $site"
    echo "  PHP:       ${php_version} ($(php_slug "$php_version"))"
    if [ -n "$admin_pass" ]; then
        echo "  wp-admin:  admin / ${admin_pass}"
    else
        echo "  wp-admin:  (no saved password — site predates wpdev automation, or was installed manually)"
    fi
    if [ -n "$db_pass" ]; then
        echo "  DB user:   wp_${site//-/_} / ${db_pass}"
    else
        echo "  DB user:   (no saved password)"
    fi
    echo "  (saved in $(site_config_file "$site"))"
}

cmd_wp() {
    site="$1"
    if [ -z "$site" ]; then
        print_warning "Usage: wpdev wp <site-name> <wp-cli args...>"
        echo "Example: wpdev wp mysite plugin list"
        return 1
    fi
    shift
    php_exec "$(site_php_service "$site")" wp --path="/var/www/${site}" --allow-root "$@"
}

cmd_remove() {
    assume_yes=0
    args=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            *) args+=("$a") ;;
        esac
    done
    arg="${args[0]:-}"
    if [ -z "$arg" ]; then
        print_warning "Usage: wpdev remove <site-name> [--yes]"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi

    # Accept either the bare site name (matches `creds`/sites/<name>) or the
    # full domain (matches nginx/sites/<domain>.conf) — strip .test either way.
    resolve_site "$arg"
    # After `admin-domain off` only the setting remembers the domain whose
    # certificate is left.
    admin="$(site_admin_domain "$site_name")"
    [ -z "$admin" ] && admin="$(site_get "$site_name" ADMIN_DOMAIN)"

    if [ ! -f "nginx/sites/${domain}.conf" ] && [ ! -d "sites/${site_name}" ]; then
        print_error "No such site: ${domain} (checked nginx/sites/${domain}.conf and sites/${site_name}/)"
    fi

    php_svc="$(site_php_service "$site_name")"

    # Read the real DB_NAME/DB_USER from wp-config.php when available — same
    # principle as clone/doctor/adminer: don't guess wp_<slug>, since sites
    # set up before this tool existed don't follow that convention. Guessing
    # here would drop the wrong (nonexistent) database and silently orphan
    # the real one — exactly what happened once already with wp-lab.
    config="sites/${site_name}/wp-config.php"
    if [ -f "$config" ]; then
        db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
        db_user="$(grep "DB_USER" "$config" | sed -E "s/.*DB_USER',[[:space:]]*'([^']*)'.*/\1/")"
    fi
    if [ -z "${db_name:-}" ]; then
        db_slug="${site_name//-/_}"
        db_slug="${db_slug:0:28}"
        db_name="wp_${db_slug}"
        db_user="wp_${db_slug}"
    fi

    echo "This will permanently delete:"
    echo "  - sites/${site_name}/         (WordPress files)"
    echo "  - nginx/sites/${domain}.conf"
    echo "  - nginx/ssl/certs/${domain}.pem + private key"
    echo "  - logs/nginx/${site_name}_access.log + _error.log"
    if [ "$db_user" = "root" ]; then
        echo "  - MySQL database ${db_name} (its DB_USER is 'root' — shared infra, not dropped)"
    else
        echo "  - MySQL database ${db_name} and its user (${db_user})"
    fi
    echo "  - This site's cached keys in Redis (if any)"
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Type the domain to confirm (${domain}): " confirm
        if [ "$confirm" != "$domain" ]; then
            cancelled
        fi
    fi

    # Needs .env for root creds and mysql to be up. Skip gracefully if the
    # stack isn't running rather than failing the whole removal.
    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi

    if [ -n "${DB_ROOT_PASSWORD:-}" ] && docker compose exec -T mysql true </dev/null >/dev/null 2>&1; then
        if [ "$db_user" = "root" ]; then
            # Never drop the root user — it's shared across every site.
            docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
                DROP DATABASE IF EXISTS \`${db_name}\`;
            " </dev/null 2>/dev/null
            print_info "Dropped database '${db_name}'"
        else
            docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
                DROP DATABASE IF EXISTS \`${db_name}\`;
                DROP USER IF EXISTS '${db_user}'@'%';
            " </dev/null 2>/dev/null
            print_info "Dropped database '${db_name}' and user '${db_user}'"
        fi
    else
        print_warning "MySQL isn't reachable — database '${db_name}' was NOT dropped. Run 'wpdev up' then re-run this, or drop it manually."
    fi

    # Redis has no volume (pure cache), so this is just tidiness, not data
    # safety — orphaned keys under this site's prefix would otherwise sit in
    # the shared instance until it's restarted.
    if docker compose exec -T redis true </dev/null >/dev/null 2>&1; then
        docker compose exec -T redis sh -c "redis-cli --scan --pattern '${site_name}:*' | xargs -r redis-cli DEL" </dev/null >/dev/null 2>&1
    fi

    # WordPress files — written by the container (often as www-data/root), so
    # delete via the php container to sidestep host permission mismatches.
    if [ -d "sites/${site_name}" ]; then
        if php_exec "$php_svc" true </dev/null >/dev/null 2>&1; then
            # Root: a site from before #20 can hold root-owned files. Tried
            # a few times: WP-Cron or a request still in flight can write
            # into the folder (a cache file, a session) while rm walks it,
            # which leaves "Directory not empty" -- and under set -e a
            # failure here once stopped `remove` halfway, the database gone
            # but its vhost and certificate left behind.
            for attempt in 1 2 3 4 5; do
                php_exec_root "$php_svc" rm -rf "/var/www/${site_name}" </dev/null 2>/dev/null && break
                sleep 1
            done
            if [ -d "sites/${site_name}" ]; then
                print_warning "Couldn't remove all of sites/${site_name} -- something kept writing into it. The rest of the site is removed; delete the folder with: docker compose exec ${php_svc} rm -rf /var/www/${site_name}"
            fi
        elif ! rm -rf "sites/${site_name}" 2>/dev/null; then
            print_warning "Could not remove sites/${site_name} (permission denied and ${php_svc} container isn't running). Run 'wpdev up' and retry, or: sudo rm -rf sites/${site_name}"
        fi
        [ -d "sites/${site_name}" ] || print_info "Removed sites/${site_name}"
    fi

    if [ -n "$admin" ] && ! admin_domain_in_use "$admin" "$domain"; then
        rm -f "nginx/ssl/certs/${admin}.pem" "nginx/ssl/private/${admin}-key.pem"
    fi
    rm -f "nginx/sites/${domain}.conf" "nginx/ssl/certs/${domain}.pem" "nginx/ssl/private/${domain}-key.pem" "$(media_proxy_conf "$domain")" "$(admin_domain_conf "$domain")" "$(admin_domain_frontend_conf "$domain")" "$(off_conf "$domain")"
    print_info "Removed Nginx config and SSL certificate${admin:+ (and admin domain ${admin})}"
    rm -f "$(site_config_file "$site_name")"
    print_info "Removed $(site_config_file "$site_name")"
    if [ -n "$(site_backup_files "$site_name")" ]; then
        echo "  Its database backups are kept, in backups/${site_name}/ (its schedule, if any, is gone)."
    fi

    # Nginx (running as root in-container) owns these on the host too, so a
    # plain host-side `rm` would hit "Permission denied" — delete via the
    # container instead. Includes logrotate remnants, not just the live files.
    if docker compose exec -T nginx true </dev/null >/dev/null 2>&1; then
        docker compose exec -T nginx sh -c "rm -f /var/log/nginx/${site_name}_access.log* /var/log/nginx/${site_name}_error.log* /var/log/nginx/${site_name}_admin_access.log* /var/log/nginx/${site_name}_admin_error.log*" </dev/null
        print_info "Removed Nginx logs"
        docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1 || true
    else
        print_warning "Nginx isn't running — logs/nginx/${site_name}_{access,error}.log were NOT removed (root-owned). Run 'wpdev up' and retry, or: sudo rm -f logs/nginx/${site_name}_*.log"
    fi

    stop_unused_php

    echo ""
    print_info "${domain} removed."
    remove_hosts_entry "$domain"
}

cmd_clone() {
    assume_yes=0
    args=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            *) args+=("$a") ;;
        esac
    done
    source_arg="${args[0]:-}"
    new_arg="${args[1]:-}"
    if [ -z "$source_arg" ] || [ -z "$new_arg" ]; then
        print_warning "Usage: wpdev clone <source-site> <new-site> [--yes]"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi

    resolve_site "$source_arg"
    source_name="$site_name"
    source_domain="$domain"
    # A bare new name keeps the source's suffix (shop.local -> shop-copy.local).
    new_domain="$new_arg"
    case "$new_domain" in *.*) ;; *) new_domain="${new_domain}.${source_domain##*.}" ;; esac
    problem="$(new_domain_problem "$new_domain")"
    [ -z "$problem" ] || print_error "Can't clone to ${new_domain}: ${problem}"
    new_name="$(site_name_of "$new_domain")"

    source_config="sites/${source_name}/wp-config.php"
    if [ ! -f "$source_config" ]; then
        print_error "No such site: ${source_name} (checked ${source_config})"
    fi
    if [ -d "sites/${new_name}" ] || [ -f "nginx/sites/${new_domain}.conf" ]; then
        print_error "sites/${new_name} or nginx/sites/${new_domain}.conf already exists — run 'wpdev remove ${new_name}' first, or pick a different name."
    fi

    # The clone inherits the source's PHP version (its settings are copied
    # below), so this is also what site_php_service resolves to for it.
    php_svc="$(site_php_service "$source_name")"
    new_url="$(site_url "$new_domain")"

    echo "This will clone:"
    echo "  sites/${source_name}/  ->  sites/${new_name}/  (files + database)"
    echo "  New domain: $(site_url "$new_domain")"
    echo "  PHP version: $(source_php="$(site_get "$source_name" PHP_VERSION)"; echo "${source_php:-$DEFAULT_PHP_VERSION}") (same as source)"
    echo "  Admin login will be the same as ${source_domain} (it's a copy of that database)."
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Continue? (y/n): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            cancelled
        fi
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    # New DB always follows the standard wp_<slug> convention, regardless of
    # what naming the SOURCE site happens to use (some predate this tool).
    db_slug="${new_name//-/_}"
    db_slug="${db_slug:0:28}"
    new_db_name="wp_${db_slug}"
    new_db_user="wp_${db_slug}"
    new_db_pass="$(openssl rand -hex 16)"

    print_step "1/8 Starting MySQL + PHP (${php_svc})..."
    ensure_php_running "$php_svc"
    docker compose up -d mysql >/dev/null
    wait_for_mysql
    print_info "MySQL and PHP are up"

    print_step "2/8 Copying WordPress files..."
    # Root, then handed to you below: the source may predate #20 and hold
    # root-owned, owner-only files www-data couldn't read.
    php_exec_root "$php_svc" cp -a "/var/www/${source_name}" "/var/www/${new_name}" </dev/null
    # cp -a keeps symlinks verbatim, and an absolute one into the source
    # site would make the clone run the source's code. Query Monitor's
    # wp-content/db.php drop-in is exactly that, and it loads before
    # plugins, so the clone's own QM then fataled on a duplicate
    # autoloader class: a 500 on every page. (#15) Re-point every such
    # link at the same path inside the clone.
    php_exec_root "$php_svc" sh -c '
        src="/var/www/$1/"; dst="/var/www/$2/"
        find "$dst" -type l | while IFS= read -r link; do
            target="$(readlink "$link")"
            case "$target" in
                "$src"*) ln -sfn "${dst}${target#"$src"}" "$link" ;;
            esac
        done' sh "$source_name" "$new_name" </dev/null
    fix_site_ownership "$php_svc" "$new_name" || print_warning "Couldn't hand sites/${new_name} over to you — run: wpdev fix-perms ${new_name}"
    # Settings that describe the copy too: same PHP, same admin login (same
    # database), same production and cache rules. Not the DB password (the
    # clone gets its own user below), the admin domain (one site's), or the
    # page cache (the clone's vhost starts plain).
    rm -f "$(site_config_file "$new_name")"
    for key in PHP_VERSION ADMIN_PASSWORD PRODUCTION_URL CACHE_TTL CACHE_BYPASS_COOKIES CACHE_BYPASS_PATHS; do
        value="$(site_get "$source_name" "$key")"
        if [ -n "$value" ]; then site_set "$new_name" "$key" "$value"; fi
    done
    print_info "Files copied to sites/${new_name}"

    print_step "3/8 Creating Nginx configuration..."
    mkdir -p nginx/sites
    sed "s/DOMAIN/$new_domain/g" nginx/sites/site.conf.template > "nginx/sites/${new_domain}.conf"
    sed -i "s|/var/www/SITE_NAME|/var/www/$new_name|g" "nginx/sites/${new_domain}.conf"
    sed -i "s/SITE_NAME/$new_name/g" "nginx/sites/${new_domain}.conf"
    sed -i "s/PHP_UPSTREAM/$php_svc/g" "nginx/sites/${new_domain}.conf"
    print_info "Created nginx/sites/${new_domain}.conf"

    print_step "4/8 Cloning database..."
    source_db_name="$(grep "DB_NAME" "$source_config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
    docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
        CREATE DATABASE IF NOT EXISTS \`${new_db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        CREATE USER IF NOT EXISTS '${new_db_user}'@'%' IDENTIFIED BY '${new_db_pass}';
        ALTER USER '${new_db_user}'@'%' IDENTIFIED BY '${new_db_pass}';
        GRANT ALL PRIVILEGES ON \`${new_db_name}\`.* TO '${new_db_user}'@'%';
        FLUSH PRIVILEGES;
    " </dev/null 2>/dev/null
    docker compose exec -T mysql sh -c "mysqldump -uroot -p'${DB_ROOT_PASSWORD}' '${source_db_name}' | mysql -uroot -p'${DB_ROOT_PASSWORD}' '${new_db_name}'" </dev/null
    site_set "$new_name" DB_PASSWORD "$new_db_pass"
    print_info "Database '${source_db_name}' cloned to '${new_db_name}'"

    print_step "5/8 Rewriting wp-config.php for the clone..."
    # The URL the source's content actually uses -- its own WP_HOME, which
    # may carry a port (or a different one than nginx has now), rather than
    # a guess. Replacing a guessed https://<source> instead would turn
    # https://src.test:8444/... into https://new.test:8444:8444/...
    source_url="$(php_exec "$php_svc" wp config get WP_HOME --path="/var/www/${source_name}" --allow-root </dev/null 2>/dev/null | tr -d '\r')" || true
    [ -n "$source_url" ] || source_url="$(site_url "$source_domain")"
    # wp config set (not sed) so it works regardless of the source's file
    # layout/formatting, and correctly adds constants that aren't already there.
    php_exec "$php_svc" wp config set DB_NAME "${new_db_name}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    php_exec "$php_svc" wp config set DB_USER "${new_db_user}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    php_exec "$php_svc" wp config set DB_PASSWORD "${new_db_pass}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    php_exec "$php_svc" wp config set WP_HOME "${new_url}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    php_exec "$php_svc" wp config set WP_SITEURL "${new_url}" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    php_exec "$php_svc" wp config set WP_REDIS_PREFIX "${new_name}:" --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    php_exec "$php_svc" wp config set DISABLE_WP_CRON true --raw --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null
    # An admin domain belongs to one site, so the clone starts without one
    # (and without wpdev's mu-plugin, which names the source's domain).
    remove_admin_domain_plugin "$new_name" >/dev/null
    if [ -n "$(site_admin_domain "$source_name")" ]; then
        print_warning "${source_name}'s admin domain isn't cloned. Give ${new_name} its own: wpdev admin-domain ${new_name} <domain>"
    fi
    # A source with the media proxy on: the clone gets it too.
    if [ -f "$(media_proxy_conf "$source_domain")" ] && [ -n "$(site_get "$new_name" PRODUCTION_URL)" ]; then
        render_media_proxy "$new_domain" "$(site_get "$new_name" PRODUCTION_URL)"
    fi
    print_info "wp-config.php updated"

    print_step "6/8 Generating SSL certificate..."
    mkdir -p nginx/ssl/certs nginx/ssl/private
    if ! command -v mkcert >/dev/null 2>&1; then
        print_warning "mkcert not installed. Run 'wpdev install-mkcert' then re-run this."
    else
        mkcert -install 2>/dev/null || true
        mkcert -cert-file "nginx/ssl/certs/${new_domain}.pem" \
               -key-file "nginx/ssl/private/${new_domain}-key.pem" \
               "${new_domain}" 2>/dev/null
        print_info "SSL certificate created"
    fi

    print_step "7/8 Re-pointing URLs and enabling object cache..."
    php_exec "$php_svc" wp search-replace "${source_url}" "${new_url}" \
        --path="/var/www/${new_name}" --all-tables --allow-root </dev/null >/dev/null
    php_exec "$php_svc" wp search-replace "${source_domain}" "${new_domain}" \
        --path="/var/www/${new_name}" --all-tables --allow-root </dev/null >/dev/null
    php_exec "$php_svc" wp redis enable --path="/var/www/${new_name}" --allow-root </dev/null >/dev/null 2>&1 || true
    print_info "URLs re-pointed, object cache enabled"

    print_step "8/8 Reloading Nginx..."
    docker compose up -d nginx >/dev/null
    docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1 || true

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "${GREEN}✓ ${new_domain} is ready (cloned from ${source_domain})${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo -e "  Site:        ${GREEN}${new_url}${NC}"
    echo "  PHP version: $(new_php="$(site_get "$new_name" PHP_VERSION)"; echo "${new_php:-$DEFAULT_PHP_VERSION}") (${php_svc})"
    echo "  Admin login: same as ${source_domain} (wpdev creds ${new_name})"
    echo "  Database:    ${new_db_name} / ${new_db_user} (password: wpdev creds ${new_name})"
    echo ""

    ensure_hosts_entry "$new_domain" $(( assume_yes ? 0 : 1 ))
    echo ""
}

cmd_snapshot() {
    site_arg="$1"
    label="$2"
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev snapshot <site> [label]"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi

    site_name="$(site_name_of "$site_arg")"
    config="sites/${site_name}/wp-config.php"
    if [ ! -f "$config" ]; then
        print_error "No such site: ${site_name} (checked ${config})"
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    timestamp="$(date +%Y%m%d_%H%M%S)"
    snap_id="$timestamp"
    if [ -n "$label" ]; then
        safe_label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9_-' '-')"
        snap_id="${timestamp}_${safe_label}"
    fi
    snap_dir="snapshots/${site_name}/${snap_id}"
    mkdir -p "$snap_dir"

    db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"

    print_step "1/2 Dumping database (${db_name})..."
    docker compose exec -T mysql mysqldump -uroot -p"$DB_ROOT_PASSWORD" "$db_name" </dev/null 2>/dev/null | gzip > "$snap_dir/db.sql.gz"
    print_info "Database dumped ($(du -h "$snap_dir/db.sql.gz" | cut -f1))"

    print_step "2/2 Archiving files..."
    # Root: read-only here, and a site from before #20 can hold root-owned,
    # owner-only files that www-data couldn't read.
    php_exec_root "$(site_php_service "$site_name")" tar -czf - -C /var/www "${site_name}" </dev/null > "$snap_dir/files.tar.gz"
    print_info "Files archived ($(du -h "$snap_dir/files.tar.gz" | cut -f1))"

    echo ""
    print_info "Snapshot saved: ${snap_id}"
    echo "  Restore with: wpdev restore ${site_name} ${snap_id}"
    echo "  (or just 'wpdev restore ${site_name}' to restore the most recent snapshot)"
}

cmd_snapshots() {
    site_arg="$1"
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev snapshots <site>"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi

    site_name="$(site_name_of "$site_arg")"

    available="$(site_snapshots "$site_name")"
    if [ -z "$available" ]; then
        echo "No snapshots found for '${site_name}'. Create one with: wpdev snapshot ${site_name}"
        return 0
    fi

    print_header "=== Snapshots for ${site_name} ==="
    echo "$available"
}

cmd_restore() {
    assume_yes=0
    args=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            *) args+=("$a") ;;
        esac
    done
    site_arg="${args[0]:-}"
    snap_id="${args[1]:-}"
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev restore <site> [snapshot-id] [--yes]"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi

    resolve_site "$site_arg"

    available="$(site_snapshots "$site_name")"
    if [ -z "$available" ]; then
        print_error "No snapshots found for '${site_name}'. Create one first: wpdev snapshot ${site_name}"
    fi

    if [ -z "$snap_id" ]; then
        snap_id="$(echo "$available" | tail -1)"
        print_info "No snapshot specified — using the most recent: ${snap_id}"
    fi

    snap_dir="snapshots/${site_name}/${snap_id}"
    if [ ! -d "$snap_dir" ]; then
        print_warning "No such snapshot: ${snap_id}"
        echo "Available snapshots for ${site_name}:"
        echo "$available" | sed 's/^/  /'
        return 1
    fi

    echo "This will overwrite the CURRENT files and database of ${domain} with"
    echo "snapshot '${snap_id}'. The current state is NOT saved first — take a new"
    echo "snapshot now if you want to keep it (wpdev snapshot ${site_name})."
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Type the domain to confirm (${domain}): " confirm
        if [ "$confirm" != "$domain" ]; then
            cancelled
        fi
    fi

    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    db_name="$(grep "DB_NAME" "sites/${site_name}/wp-config.php" 2>/dev/null | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
    if [ -z "$db_name" ]; then
        db_slug="${site_name//-/_}"
        db_slug="${db_slug:0:28}"
        db_name="wp_${db_slug}"
    fi

    print_step "1/3 Restoring database (${db_name})..."
    docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
        DROP DATABASE IF EXISTS \`${db_name}\`;
        CREATE DATABASE \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
    " </dev/null 2>/dev/null
    gunzip -c "$snap_dir/db.sql.gz" | docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" "$db_name" 2>/dev/null
    print_info "Database restored"

    print_step "2/3 Restoring files..."
    php_svc="$(site_php_service "$site_name")"
    php_exec_root "$php_svc" sh -c "rm -rf /var/www/${site_name}" </dev/null
    php_exec_root "$php_svc" tar -xzf - -C /var/www < "$snap_dir/files.tar.gz"
    # An older snapshot carries whatever owners its files had back then.
    fix_site_ownership "$php_svc" "$site_name" || print_warning "Couldn't hand sites/${site_name} over to you — run: wpdev fix-perms ${site_name}"
    print_info "Files restored"

    print_step "3/3 Flushing this site's cache..."
    if docker compose exec -T redis true </dev/null >/dev/null 2>&1; then
        docker compose exec -T redis sh -c "redis-cli --scan --pattern '${site_name}:*' | xargs -r redis-cli DEL" </dev/null >/dev/null 2>&1
    fi
    docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1 || true
    print_info "Cache flushed (avoids serving stale cached content from before the restore)"

    echo ""
    print_info "${domain} restored to snapshot '${snap_id}'."
}

# --tables=a,b,c for db-export/db-import, into the tables array: checked
# here, since the names go into SQL (backtick-quoted) and onto mysqldump's
# command line. Run in the caller's shell, not $(...), so a bad name exits.
parse_table_list() {
    local list="$1" t
    tables=()
    for t in ${list//,/ }; do
        [[ "$t" =~ ^[A-Za-z0-9_\$-]{1,64}$ ]] || print_error "Not a table name: '${t}'"
        tables+=("$t")
    done
    [ "${#tables[@]}" -gt 0 ] || print_error "--tables= needs at least one table name"
}

# The site's database name, from its wp-config.php; exits if there's no
# such site. Sets site_name, config, db_name (and domain, via resolve_site).
db_site() {
    resolve_site "$1"
    config="sites/${site_name}/wp-config.php"
    if [ ! -f "$config" ]; then
        print_error "No such site: ${site_name} (checked ${config})"
    fi
    db_name="$(grep "DB_NAME" "$config" | sed -E "s/.*DB_NAME',[[:space:]]*'([^']*)'.*/\1/")"
}

load_db_root_password() {
    if [ -f .env ]; then
        set -a
        # shellcheck disable=SC1091
        source .env
        set +a
    fi
    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi
}

mysql_root() {
    docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" "$@"
}

cmd_db_tables() {
    if [ -z "${1:-}" ]; then
        print_warning "Usage: wpdev db-tables <site>"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    db_site "$1"
    load_db_root_password
    # Tab-separated, for the dashboard as much as for reading: name, rows
    # (InnoDB's estimate), bytes (data + indexes).
    mysql_root -N -B -e "
        SELECT table_name, table_rows, data_length + index_length
        FROM information_schema.tables
        WHERE table_schema = '${db_name}' AND table_type = 'BASE TABLE'
        ORDER BY table_name;" </dev/null 2>/dev/null
}

cmd_db_export() {
    local tables_arg="" has_tables=0 a args=() tables=()
    for a in "$@"; do
        case "$a" in
            --tables=*) tables_arg="${a#--tables=}"; has_tables=1 ;;
            *) args+=("$a") ;;
        esac
    done
    site_arg="${args[0]:-}"
    out_file="${args[1]:-}"
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev db-export <site> [output-file] [--tables=a,b,...]"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    [ "$has_tables" -eq 0 ] || parse_table_list "$tables_arg"

    db_site "$site_arg"
    load_db_root_password

    if [ -z "$out_file" ]; then
        mkdir -p backups
        out_file="backups/${site_name}_$(date +%Y%m%d_%H%M%S).sql.gz"
    fi
    out_dir="$(dirname "$out_file")"
    [ "$out_dir" != "." ] && mkdir -p "$out_dir"

    # mysqldump fails on a named table that isn't there -- its error is
    # kept for that. (The pipeline's own status is gzip's, hence PIPESTATUS.)
    local dump_err dump_rc
    dump_err="$(mktemp)"
    docker compose exec -T mysql mysqldump -uroot -p"$DB_ROOT_PASSWORD" "$db_name" "${tables[@]}" </dev/null 2>"$dump_err" | gzip > "$out_file"
    dump_rc="${PIPESTATUS[0]}"
    if [ "$dump_rc" -ne 0 ]; then
        grep -v "Using a password on the command line" "$dump_err" >&2 || true
        rm -f "$dump_err" "$out_file"
        print_error "Export of '${db_name}' failed"
    fi
    rm -f "$dump_err"
    local what="'${db_name}'"
    [ "${#tables[@]}" -eq 0 ] || what="${#tables[@]} table(s) of '${db_name}'"
    print_info "Exported ${what} (${site_name}) to ${out_file} ($(du -h "$out_file" | cut -f1))"
}

# Feeds a .sql or .sql.gz dump to mysql, into database $1. mysql's own
# error (a syntax error, a missing privilege in the dump's DEFINERs...) is
# the useful part of a failed import, so it's printed -- minus the warning
# about the password on the command line. Returns mysql's status.
import_dump_into() {
    local db="$1" file="$2" err rc=0
    err="$(mktemp)"
    if gzip -t "$file" 2>/dev/null; then
        gunzip -c "$file" | mysql_root "$db" 2>"$err" || rc=$?
    else
        mysql_root "$db" < "$file" 2>"$err" || rc=$?
    fi
    [ "$rc" -eq 0 ] || grep -v "Using a password on the command line" "$err" >&2 || true
    rm -f "$err"
    return "$rc"
}

cmd_db_import() {
    local assume_yes=0 rewrite_urls=0 label="" tables_arg="" has_tables=0 a args=() tables=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) assume_yes=1 ;;
            --rewrite-urls) rewrite_urls=1 ;;
            --label=*) label="${a#--label=}" ;;
            --tables=*) tables_arg="${a#--tables=}"; has_tables=1 ;;
            *) args+=("$a") ;;
        esac
    done
    site_arg="${args[0]:-}"
    in_file="${args[1]:-}"
    if [ -z "$site_arg" ] || [ -z "$in_file" ]; then
        print_warning "Usage: wpdev db-import <site> <file.sql[.gz]> [--tables=a,b,...] [--rewrite-urls] [--yes]"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    if [ ! -f "$in_file" ]; then
        print_error "No such file: ${in_file}"
    fi
    [ "$has_tables" -eq 0 ] || parse_table_list "$tables_arg"

    db_site "$site_arg"
    local src="${label:-$in_file}"

    if [ "${#tables[@]}" -eq 0 ]; then
        echo "This will REPLACE the entire current database '${db_name}' for ${domain}"
        echo "with the contents of ${src}. The current content is NOT saved first —"
    else
        echo "This will REPLACE ${#tables[@]} table(s) of '${db_name}' for ${domain}"
        echo "with the ones in ${src}: $(echo "${tables[*]}")"
        echo "Its other tables are kept. The replaced ones are NOT saved first —"
    fi
    echo "run 'wpdev db-export ${site_name}' first if you want to keep it."
    echo ""
    if [ "$assume_yes" -eq 1 ]; then
        print_info "Skipping confirmation (--yes)."
    else
        read -p "Type the domain to confirm (${domain}): " confirm
        if [ "$confirm" != "$domain" ]; then
            cancelled
        fi
    fi

    load_db_root_password

    local steps=2 old_url=""
    [ "$rewrite_urls" -eq 1 ] && steps=3

    if [ "${#tables[@]}" -eq 0 ]; then
        print_step "1/${steps} Importing into '${db_name}'..."
        mysql_root -e "
            DROP DATABASE IF EXISTS \`${db_name}\`;
            CREATE DATABASE \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        " </dev/null 2>/dev/null
        if ! import_dump_into "$db_name" "$in_file"; then
            print_error "Import failed part way; '${db_name}' holds only what came before the error."
        fi
        print_info "Database imported"
    else
        # Only some tables: the whole dump goes into a scratch database
        # first -- whatever tool made it, mysql sorts out where each
        # table's statements start and end -- and the chosen tables are
        # then moved across (RENAME TABLE: same server, so no copying).
        local stage="${db_name}__import" present t missing=() moves=""
        print_step "1/${steps} Importing ${#tables[@]} table(s) into '${db_name}'..."
        mysql_root -e "
            DROP DATABASE IF EXISTS \`${stage}\`;
            CREATE DATABASE \`${stage}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        " </dev/null 2>/dev/null
        if ! import_dump_into "$stage" "$in_file"; then
            mysql_root -e "DROP DATABASE IF EXISTS \`${stage}\`;" </dev/null >/dev/null 2>&1 || true
            print_error "The dump didn't load; '${db_name}' is unchanged."
        fi
        present="$(mysql_root -N -B -e "SELECT table_name FROM information_schema.tables WHERE table_schema = '${stage}';" </dev/null 2>/dev/null)"
        for t in "${tables[@]}"; do
            grep -qxF "$t" <<<"$present" || missing+=("$t")
            moves+="DROP TABLE IF EXISTS \`${db_name}\`.\`${t}\`; RENAME TABLE \`${stage}\`.\`${t}\` TO \`${db_name}\`.\`${t}\`; "
        done
        if [ "${#missing[@]}" -gt 0 ]; then
            mysql_root -e "DROP DATABASE IF EXISTS \`${stage}\`;" </dev/null >/dev/null 2>&1 || true
            print_error "Not in the dump: $(echo "${missing[*]}"); '${db_name}' is unchanged."
        fi
        # The dump's home URL, for --rewrite-urls: from its options table
        # even when that table isn't one being imported.
        if [ "$rewrite_urls" -eq 1 ]; then
            local options prefix
            prefix="$(sed -nE "s/^[[:space:]]*\\\$table_prefix[[:space:]]*=[[:space:]]*['\"]([^'\"]*)['\"].*/\1/p" "$config" | head -n1)"
            options="$(grep -xF "${prefix}options" <<<"$present" || grep -E '_options$' <<<"$present" | head -n1 || true)"
            [ -z "$options" ] || old_url="$(mysql_root -N -B -e "SELECT option_value FROM \`${stage}\`.\`${options}\` WHERE option_name = 'home';" </dev/null 2>/dev/null | tr -d '\r')"
        fi
        if ! mysql_root -e "SET FOREIGN_KEY_CHECKS = 0; ${moves} DROP DATABASE \`${stage}\`;" </dev/null 2>/dev/null; then
            mysql_root -e "DROP DATABASE IF EXISTS \`${stage}\`;" </dev/null >/dev/null 2>&1 || true
            print_error "Moving the tables into '${db_name}' failed part way."
        fi
        print_info "Imported: $(echo "${tables[*]}")"
    fi

    print_step "2/${steps} Flushing this site's cache..."
    if docker compose exec -T redis true </dev/null >/dev/null 2>&1; then
        docker compose exec -T redis sh -c "redis-cli --scan --pattern '${site_name}:*' | xargs -r redis-cli DEL" </dev/null >/dev/null 2>&1
    fi
    print_info "Cache flushed"

    local new_url old_host repointed=0
    new_url="$(site_url "$domain")"
    if [ "$rewrite_urls" -eq 1 ]; then
        print_step "3/${steps} Re-pointing URLs to ${new_url}..."
        # The dump's own address: its home option as stored -- `option get`
        # would answer with wp-config's WP_HOME, which is already this site.
        # Plugins and themes stay out of it: they're this site's files,
        # maybe not the dump's.
        if [ "${#tables[@]}" -eq 0 ]; then
            old_url="$(cmd_wp "$site_name" eval 'global $wpdb; echo $wpdb->get_var("SELECT option_value FROM {$wpdb->options} WHERE option_name = '"'"'home'"'"'");' --skip-plugins --skip-themes </dev/null 2>/dev/null | tr -d '\r')" || old_url=""
        fi
        old_url="${old_url%/}"
        if [ -z "$old_url" ]; then
            print_warning "Couldn't find the dump's home URL (no options table in it, or a table prefix other than this site's), so nothing was re-pointed."
        elif [ "$old_url" = "$new_url" ]; then
            print_info "Already ${new_url}; nothing to re-point"
        else
            # The full URL first, then the bare host for http://, //host and
            # escaped forms the first pass leaves -- in the imported tables
            # only, when that's some of them.
            old_host="${old_url#*://}"
            cmd_wp "$site_name" search-replace "$old_url" "$new_url" "${tables[@]}" --all-tables --skip-columns=guid --skip-plugins --skip-themes </dev/null >/dev/null
            cmd_wp "$site_name" search-replace "$old_host" "${new_url#*://}" "${tables[@]}" --all-tables --skip-columns=guid --skip-plugins --skip-themes </dev/null >/dev/null
            print_info "Re-pointed ${old_url} -> ${new_url}"
            repointed=1
        fi
    fi

    echo ""
    if [ "${#tables[@]}" -eq 0 ]; then
        print_info "${domain} database replaced from ${src}."
    else
        print_info "${#tables[@]} table(s) of ${domain} replaced from ${src}."
    fi
    if [ "$repointed" -eq 0 ] && [ "$rewrite_urls" -eq 0 ]; then
        echo "If this dump came from a different domain, re-point URLs with:"
        echo "  wpdev wp ${site_name} search-replace https://OLDDOMAIN ${new_url} --all-tables"
        echo "(or import with --rewrite-urls)"
    fi
}

# --- Database backups: backups/<site>/<site>_<UTC stamp>Z_<kind>.sql.gz ---
# kind is "manual" (wpdev db-backup, kept until removed) or "auto" (made on
# the site's schedule, BACKUP_EVERY, the newest BACKUP_KEEP of them kept).
# The stamp is UTC, marked Z, since backups are made both here and inside
# the api container, whose clock is UTC whatever the host's zone; ages come
# from the files' mtimes.
BACKUP_KEEP_DEFAULT=7
BACKUP_FILE_RE='^[a-z0-9-]+_[0-9]{8}-[0-9]{6}Z_(auto|manual)\.sql\.gz$'

# "30m", "6h", "1d", "2w" -> seconds; nothing for anything else.
backup_interval_seconds() {
    local n unit
    [[ "$1" =~ ^([0-9]{1,4})([mhdw])$ ]] || return 1
    n="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
    case "$unit" in
        m) echo $((n * 60)) ;;
        h) echo $((n * 3600)) ;;
        d) echo $((n * 86400)) ;;
        w) echo $((n * 604800)) ;;
    esac
}

# A site's backups, oldest first: one file name per line. $2 limits it to
# one kind.
site_backup_files() {
    local f
    for f in "backups/${1}/${1}"_*.sql.gz; do
        [ -f "$f" ] || continue
        f="$(basename "$f")"
        [[ "$f" =~ $BACKUP_FILE_RE ]] || continue
        [ -z "${2:-}" ] || [ "${BASH_REMATCH[1]}" = "$2" ] || continue
        echo "$f"
    done | sort
}

# db_backup_site <site-name> <manual|auto>: dump it, then (auto) drop the
# oldest automatic backups past BACKUP_KEEP.
db_backup_site() {
    local site="$1" kind="$2" dir file tmp err keep old
    db_site "$site"
    load_db_root_password
    dir="backups/${site_name}"
    mkdir -p "$dir"
    file="${dir}/${site_name}_$(date -u +%Y%m%d-%H%M%S)Z_${kind}.sql.gz"
    # Written under a temp name and renamed once complete, so neither a
    # list nor the schedule ever takes a half-written dump for a backup.
    tmp="${dir}/.partial-$$.sql.gz"
    err="$(mktemp)"
    docker compose exec -T mysql mysqldump -uroot -p"$DB_ROOT_PASSWORD" --single-transaction "$db_name" </dev/null 2>"$err" | gzip > "$tmp"
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
        grep -v "Using a password on the command line" "$err" >&2 || true
        rm -f "$err" "$tmp"
        print_error "Backing up '${db_name}' (${site_name}) failed"
    fi
    rm -f "$err"
    mv "$tmp" "$file"
    print_info "Backed up ${site_name} to ${file} ($(du -h "$file" | cut -f1))"

    if [ "$kind" = "auto" ]; then
        keep="$(site_get "$site_name" BACKUP_KEEP)"
        [[ "$keep" =~ ^[0-9]+$ ]] && [ "$keep" -ge 1 ] || keep="$BACKUP_KEEP_DEFAULT"
        site_backup_files "$site_name" auto | awk -v keep="$keep" '{ f[NR] = $0 } END { for (i = 1; i <= NR - keep; i++) print f[i] }' | while read -r old; do
            rm -f "${dir}/${old}"
            echo "  Removed ${old} (keeping the newest ${keep} automatic backups)"
        done
    fi
}

# Every site whose schedule says a backup is due: none yet, or the newest
# automatic one older than BACKUP_EVERY. What the api runs every minute;
# a host cron job can run it too. Quiet when nothing is due.
db_backup_due() {
    local site every secs newest age now
    docker compose exec -T mysql mysqladmin ping -h127.0.0.1 --silent </dev/null >/dev/null 2>&1 || return 0
    now="$(date +%s)"
    for site in $(site_names); do
        every="$(site_get "$site" BACKUP_EVERY)"
        [ -n "$every" ] || continue
        secs="$(backup_interval_seconds "$every")" || continue
        newest="$(site_backup_files "$site" auto | tail -n1)"
        if [ -n "$newest" ]; then
            age=$((now - $(date -r "backups/${site}/${newest}" +%s)))
            # A minute's slack: the check runs once a minute, so a backup
            # 59m59s old on an hourly schedule shouldn't wait for the next.
            [ "$age" -ge $((secs - 60)) ] || continue
        fi
        # One site failing (its database gone) mustn't stop the others.
        ( db_backup_site "$site" auto ) || print_warning "Scheduled backup of ${site} failed"
    done
}

cmd_db_backup() {
    local a sites=() all=0 site
    for a in "$@"; do
        case "$a" in
            --due) db_backup_due; return 0 ;;
            --all) all=1 ;;
            *) sites+=("$a") ;;
        esac
    done
    [ "$all" -eq 0 ] || mapfile -t sites < <(site_names)
    if [ "${#sites[@]}" -eq 0 ]; then
        print_warning "Usage: wpdev db-backup <site>... | --all | --due"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    for site in "${sites[@]}"; do
        db_backup_site "$site" manual
    done
}

# wpdev db-backups <site>                       list (tab-separated: file, kind, bytes, epoch)
# wpdev db-backups <site> schedule              show it: every=<interval|off> keep=<n>
# wpdev db-backups <site> schedule <every|off> [--keep=N]
# wpdev db-backups <site> rm <file>
cmd_db_backups() {
    local site_arg="${1:-}" action="${2:-}" f kind every keep a
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev db-backups <site> [schedule [<interval>|off] [--keep=N] | rm <file>]"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    db_site "$site_arg"
    case "$action" in
        "")
            site_backup_files "$site_name" | while read -r f; do
                [[ "$f" =~ $BACKUP_FILE_RE ]]
                kind="${BASH_REMATCH[1]}"
                printf '%s\t%s\t%s\t%s\n' "$f" "$kind" "$(wc -c < "backups/${site_name}/${f}" | tr -d ' ')" "$(date -r "backups/${site_name}/${f}" +%s)"
            done
            ;;
        schedule)
            shift 2
            keep=""
            every=""
            for a in "$@"; do
                case "$a" in
                    --keep=*) keep="${a#--keep=}" ;;
                    *) every="$a" ;;
                esac
            done
            if [ -n "$keep" ]; then
                [[ "$keep" =~ ^[0-9]{1,4}$ ]] && [ "$keep" -ge 1 ] || print_error "--keep needs a number, 1 or more"
                site_set "$site_name" BACKUP_KEEP "$keep"
            fi
            if [ "$every" = "off" ]; then
                site_unset "$site_name" BACKUP_EVERY
            elif [ -n "$every" ]; then
                local secs
                secs="$(backup_interval_seconds "$every")" || print_error "Not an interval: '${every}' -- a number and m, h, d or w, e.g. 6h or 1d"
                [ "$secs" -ge 300 ] || print_error "At least 5m between backups"
                site_set "$site_name" BACKUP_EVERY "$every"
            fi
            every="$(site_get "$site_name" BACKUP_EVERY)"
            keep="$(site_get "$site_name" BACKUP_KEEP)"
            echo "every=${every:-off} keep=${keep:-$BACKUP_KEEP_DEFAULT}"
            ;;
        rm)
            f="${3:-}"
            [[ "$f" =~ $BACKUP_FILE_RE ]] && [[ "$f" == "${site_name}_"* ]] || print_error "Not one of ${site_name}'s backups: '${f}'"
            [ -f "backups/${site_name}/${f}" ] || print_error "No such backup: ${f}"
            rm -f "backups/${site_name}/${f}"
            print_info "Removed ${f}"
            ;;
        *)
            print_error "Unknown action '${action}' -- schedule or rm"
            ;;
    esac
}

# --- WordPress debug settings and debug.log ---------------------------------
DEBUG_CONSTANTS="WP_DEBUG WP_DEBUG_LOG WP_DEBUG_DISPLAY SCRIPT_DEBUG SAVEQUERIES"
# A debug.log past this is moved to debug.log.1 (`debug-log --rotate-due`,
# which the api runs every minute), replacing the previous one.
DEBUG_LOG_ROTATE_BYTES=$((50 * 1024 * 1024))

# The constants as WordPress actually ends up with them, one KEY=value per
# line (var_export: true, false, 'a path', or "unset"). Read at runtime, not
# from the file: wp-config.php can define one twice, or behind a condition.
debug_constants() {
    cmd_wp "$1" eval '
        foreach (["WP_DEBUG", "WP_DEBUG_LOG", "WP_DEBUG_DISPLAY", "SCRIPT_DEBUG", "SAVEQUERIES"] as $k) {
            echo $k, "=", defined($k) ? var_export(constant($k), true) : "unset", "\n";
        }' --skip-plugins --skip-themes </dev/null 2>/dev/null | tr -d '\r'
}

# Where the site's debug log is on this side: WP_DEBUG_LOG's own path when
# it's one inside the site, wp-content/debug.log otherwise.
debug_log_file() {
    local site="$1" value="${2:-}" path
    path="$(sed -nE "s/^'(.*)'$/\1/p" <<<"$value")"
    if [[ "$path" == "/var/www/${site}/"* ]]; then
        echo "sites/${site}/${path#/var/www/${site}/}"
    else
        echo "sites/${site}/wp-content/debug.log"
    fi
}

# Sets a debug constant to true/false in wp-config.php. Every define() of
# it is rewritten -- wpdev's own wp-config.php has WP_DEBUG twice (its
# value, and WordPress's `if ( ! defined( 'WP_DEBUG' ) )` fallback), and
# `wp config set` would change just one of them, maybe the one that never
# runs. None at all: added before "That's all, stop editing!".
set_debug_constant() {
    local site="$1" key="$2" value="$3" config="sites/${1}/wp-config.php" re
    re="^([[:space:]]*define[[:space:]]*\\([[:space:]]*['\"]${key}['\"][[:space:]]*,[[:space:]]*)[^)]*[^)[:space:]]([[:space:]]*\\)[[:space:]]*;.*)$"
    if grep -qE "$re" "$config"; then
        sed -i -E "s/${re}/\\1${value}\\2/" "$config"
    elif grep -q "That's all, stop editing" "$config"; then
        sed -i "/That's all, stop editing/i define( '${key}', ${value} );\\n" "$config"
    else
        cmd_wp "$site" config set "$key" "$value" --raw --type=constant </dev/null >/dev/null
    fi
}

# wpdev debug <site>                    the constants, the log's path and size
# wpdev debug <site> on|off             WP_DEBUG (with on: log to file, not on the page)
# wpdev debug <site> set <KEY> true|false
cmd_debug() {
    local site_arg="${1:-}" action="${2:-}" key value now log
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev debug <site> [on|off|set <KEY> true|false]"
        echo "Keys: ${DEBUG_CONSTANTS}"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    db_site "$site_arg"

    case "$action" in
        "") ;;
        on)
            set_debug_constant "$site_name" WP_DEBUG true
            # A path of its own stays; only a plain on/off becomes true.
            grep -q "^WP_DEBUG_LOG='" <<<"$(debug_constants "$site_name")" || set_debug_constant "$site_name" WP_DEBUG_LOG true
            set_debug_constant "$site_name" WP_DEBUG_DISPLAY false
            ;;
        off)
            set_debug_constant "$site_name" WP_DEBUG false
            ;;
        set)
            key="${3:-}"; value="${4:-}"
            [[ " ${DEBUG_CONSTANTS} " == *" ${key} "* ]] || print_error "Not a debug setting: '${key}' (one of: ${DEBUG_CONSTANTS})"
            [[ "$value" == true || "$value" == false ]] || print_error "Value must be true or false, got '${value}'"
            set_debug_constant "$site_name" "$key" "$value"
            ;;
        *)
            print_error "Unknown action '${action}' -- on, off or set"
            ;;
    esac

    now="$(debug_constants "$site_name")"
    [ -n "$now" ] || print_error "Couldn't load ${site_name}'s wp-config.php to read its settings"
    # Checked against what WordPress now sees, so a value set somewhere
    # wpdev doesn't edit (a computed define, another included file) is
    # reported, not silently claimed.
    if [ "$action" = set ] && ! grep -qx "${key}=${value}" <<<"$now"; then
        echo "$now"
        print_error "${key} is still not ${value} -- something else in wp-config.php decides it"
    fi
    if [[ "$action" == on || "$action" == off ]]; then
        value=true; [ "$action" = off ] && value=false
        grep -qx "WP_DEBUG=${value}" <<<"$now" || { echo "$now"; print_error "WP_DEBUG is still not ${value} -- something else in wp-config.php decides it"; }
    fi
    echo "$now"
    log="$(debug_log_file "$site_name" "$(sed -n 's/^WP_DEBUG_LOG=//p' <<<"$now")")"
    echo "LOG=${log}"
    echo "LOG_BYTES=$( [ -f "$log" ] && wc -c < "$log" | tr -d ' ' || echo 0)"
}

# wpdev debug-log <site> [--lines=N] [--follow]   its end (and then new lines)
# wpdev debug-log <site> clear                     empty it
# wpdev debug-log --rotate-due                     move any past 50 MB to .1
cmd_debug_log() {
    local site_arg="" lines=200 follow=0 clear=0 a log site size
    for a in "$@"; do
        case "$a" in
            --rotate-due)
                for site in $(site_names); do
                    # The default place, plus wherever WP_DEBUG_LOG points --
                    # without booting WordPress for every site every minute,
                    # so only a literal path in wp-config.php counts.
                    for log in "sites/${site}/wp-content/debug.log" \
                        $(sed -nE "s#^[[:space:]]*define[[:space:]]*\\([[:space:]]*['\"]WP_DEBUG_LOG['\"][[:space:]]*,[[:space:]]*['\"]/var/www/${site}/([^'\"]+)['\"].*#sites/${site}/\\1#p" "sites/${site}/wp-config.php" 2>/dev/null); do
                        [ -f "$log" ] || continue
                        size="$(wc -c < "$log" | tr -d ' ')"
                        [ "$size" -gt "$DEBUG_LOG_ROTATE_BYTES" ] || continue
                        # mv, not copy-and-truncate: PHP opens the log for each
                        # message, so the next one starts a fresh file.
                        mv -f "$log" "${log}.1"
                        print_info "Rotated ${log} ($((size / 1024 / 1024)) MB) to ${log}.1"
                    done
                done
                return 0
                ;;
            --lines=*) lines="${a#--lines=}" ;;
            --follow|-f) follow=1 ;;
            clear) clear=1 ;;
            *) site_arg="$a" ;;
        esac
    done
    if [ -z "$site_arg" ]; then
        print_warning "Usage: wpdev debug-log <site> [--lines=N] [--follow] | <site> clear | --rotate-due"
        echo "Known sites: $(site_names | tr '\n' ' ')"
        return 1
    fi
    [[ "$lines" =~ ^[0-9]{1,6}$ ]] || print_error "--lines needs a number"
    db_site "$site_arg"
    log="$(debug_log_file "$site_name" "$(debug_constants "$site_name" | sed -n 's/^WP_DEBUG_LOG=//p')")"

    if [ "$clear" -eq 1 ]; then
        # Truncated in place, so whatever has it open keeps writing to it.
        [ ! -f "$log" ] || : > "$log"
        rm -f "${log}.1"
        print_info "Cleared ${log}"
        return 0
    fi
    if [ "$follow" -eq 1 ]; then
        # exec, like `logs`: the api's SIGTERM reaches tail itself. -F
        # follows the name, so a rotation or a log created later is picked up.
        exec tail -n "$lines" -F "$log" 2>/dev/null
    fi
    [ -f "$log" ] || return 0
    tail -n "$lines" "$log"
}

# --- Sharing a site with other devices (`wpdev share`) ---------------------
# A shared site gets a small proxy of its own: an nginx:alpine container on
# the stack's network that publishes one port (the first free one from
# 39100) while the share lasts, so other devices on the network reach the
# site at http://<LAN IP>:<port>. It proxies to the site's real vhost on
# the stack's nginx with the site's own Host, so WordPress runs exactly as
# usual, and rewrites the site's address in what comes back (pages, CSS,
# JSON, redirects, cookies) to whichever address the visitor used. Nothing
# in WordPress or its database changes, and the stack itself publishes no
# extra ports -- the proxy's exists only while something is shared.
# --public adds a tunnel (localhost.run, over SSH: no account, nothing to
# install) to the same proxy, for an https:// address reachable from
# anywhere. Every share expires (SHARE_UNTIL); `share --expire-due`, run
# each minute by the api, turns expired ones off.
SHARE_PORT_FIRST=39100
SHARE_PORT_LAST=39199
SHARE_MAX_SECONDS=$((24 * 3600))
SHARE_TUNNEL_HOST="localhost.run"
# Pinned, so the tunnel can't be pointed at an impostor.
SHARE_TUNNEL_HOSTKEY="localhost.run ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILVqOuSMnyeGDVO1lG6EaG5In/dXABCchhmHKkuRU2s9"
SHARE_TUNNEL_URL_RE='https://[a-z0-9-]+\.lhr\.life'

share_conf() { echo "nginx/sites/share/$1.conf"; }
share_htpasswd() { echo "nginx/sites/share/$1.htpasswd"; }
# Not wp-*, which doctor would report as orphans while they run.
share_proxy_name() { echo "wpdev-share-$1"; }
share_tunnel_name() { echo "wpdev-share-tunnel-$1"; }

container_running() {
    [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = "true" ]
}

# The stack's network, which the proxy and tunnel join to reach nginx.
stack_network() {
    docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' wp-nginx 2>/dev/null | head -n1
}

# This machine's address on its local network: the source address of its
# default route, which is what other devices on that network see. Inside
# the api container that's the container's own, so it's asked from a
# throwaway container on the host's network instead.
host_lan_ip() {
    local out
    if [ -n "${WPDEV_IN_API:-}" ]; then
        out="$(docker run --rm --network host --entrypoint ip nginx:alpine -4 route get 1.1.1.1 </dev/null 2>/dev/null)" || out=""
    else
        out="$(ip -4 route get 1.1.1.1 2>/dev/null)" || out=""
    fi
    sed -nE 's/.* src ([0-9.]+).*/\1/p' <<<"$out" | head -n1
}

# "30m", "2h", "1d" -> seconds, at most a day.
share_duration_seconds() {
    local secs
    secs="$(backup_interval_seconds "$1")" || return 1
    [ "$secs" -ge 60 ] && [ "$secs" -le "$SHARE_MAX_SECONDS" ] || return 1
    echo "$secs"
}

render_share_conf() {
    local domain="$1" admin="$2" password="$3" origin host conf htpasswd auth="" guard=""
    origin="$(site_url "$domain")"
    host="${origin#https://}"
    conf="$(share_conf "$domain")"
    htpasswd="$(share_htpasswd "$domain")"
    mkdir -p "$(dirname "$conf")"

    if [ -n "$password" ]; then
        printf 'preview:%s\n' "$(openssl passwd -apr1 "$password")" > "$htpasswd"
        auth="    auth_basic \"Shared preview of ${domain}\";
    auth_basic_user_file /etc/nginx/share.htpasswd;"
    else
        rm -f "$htpasswd"
    fi
    if [ "$admin" != "1" ]; then
        # A preview is for looking at the site, and a local site's admin
        # login is rarely one to hand out. admin-ajax.php stays: front-end
        # features (forms, carts, filters) post to it.
        guard='    location ~ ^/(?:wp-login\.php|xmlrpc\.php|wp-admin(?:/(?!admin-ajax\.php).*)?$) {
        default_type text/html;
        return 403 "<!doctype html><title>Not shared</title><p style=\"font:16px system-ui;margin:3em auto;max-width:32em\">wp-admin isn'"'"'t part of this shared preview.</p>";
    }
'
    fi

    cat > "$conf" <<CONF
# Managed by \`wpdev share\` for ${domain}, run by its own proxy container
# ($(share_proxy_name "$(site_name_of "$domain")")) -- \`wpdev share ${domain} off\`
# removes both.
server {
    listen 8080;
    server_name _;

${auth}
    # The address the visitor used, to put in place of ${host} in what
    # the site sends back: http on the LAN, https through the tunnel.
    set \$share_scheme http;
    if (\$http_x_forwarded_proto = "https") { set \$share_scheme https; }
    if (\$http_host ~* "\\.lhr\\.life\$") { set \$share_scheme https; }
    set \$share_origin "\$share_scheme://\$http_host";
    set \$share_origin_json "\$share_scheme:\\/\\/\$http_host";
    set \$share_origin_encoded "\$share_scheme%3A%2F%2F\$http_host";

    add_header X-Robots-Tag "noindex, nofollow" always;
    client_max_body_size 64m;

    # Log files (debug.log and its rotated .1) aren't for anyone.
    location ~* \\.log(\\.\\d+)?\$ {
        deny all;
    }

${guard}
    location / {
        # The site's own vhost on the stack's nginx, with its own Host:
        # WordPress sees an ordinary request for ${domain}.
        proxy_pass https://nginx:443;
        proxy_ssl_server_name on;
        proxy_ssl_name ${domain};
        proxy_set_header Host ${host};
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Wpdev-Share "1";
        # Uncompressed, so sub_filter can read it.
        proxy_set_header Accept-Encoding "";

        proxy_redirect ~^https?://${host//./\\.}(/.*)?\$ \$share_origin\$1;
        proxy_cookie_domain ${domain} \$host;
        # Over plain http on the LAN a Secure cookie would be dropped.
        proxy_cookie_flags ~ nosecure;

        sub_filter_once off;
        sub_filter_types text/css text/javascript application/javascript application/json application/ld+json application/xml text/xml application/rss+xml application/atom+xml image/svg+xml;
        sub_filter "https://${host}" \$share_origin;
        sub_filter "http://${host}" \$share_origin;
        sub_filter "https:\\/\\/${host}" \$share_origin_json;
        sub_filter "https%3A%2F%2F${host}" \$share_origin_encoded;
    }
}
CONF
}

# (Re)starts <site>'s proxy with its current config, on <port> if that's
# free, otherwise the first free one from SHARE_PORT_FIRST. Prints the
# port it got. A port another program holds just means the next one.
start_share_proxy() {
    local site="$1" want="$2" domain name network bind port htpasswd mounts=() p
    domain="$(site_domain_of "$site")"
    name="$(share_proxy_name "$site")"
    network="$(stack_network)"
    [ -n "$network" ] || { print_warning "nginx isn't running -- start the stack first: wpdev up"; return 1; }
    bind="${SHARE_BIND:-$(grep -s '^SHARE_BIND=' .env | cut -d= -f2- || true)}"
    bind="${bind:-0.0.0.0}"
    mounts=(-v "${PWD}/$(share_conf "$domain"):/etc/nginx/conf.d/default.conf:ro")
    htpasswd="$(share_htpasswd "$domain")"
    [ ! -f "$htpasswd" ] || mounts+=(-v "${PWD}/${htpasswd}:/etc/nginx/share.htpasswd:ro")

    docker rm -f "$name" >/dev/null 2>&1 || true
    for p in ${want:+$want} $(seq "$SHARE_PORT_FIRST" "$SHARE_PORT_LAST"); do
        if docker run -d --name "$name" --label "wpdev.share=${site}" --network "$network" --restart unless-stopped \
            -p "${bind}:${p}:8080" "${mounts[@]}" nginx:alpine </dev/null >/dev/null 2>&1; then
            sleep 1
            if container_running "$name"; then
                echo "$p"
                return 0
            fi
            # Started, then stopped: its config, not the port.
            docker logs --tail 5 "$name" 2>&1 | sed 's/^/    /' >&2
            docker rm -f "$name" >/dev/null 2>&1 || true
            return 1
        fi
        docker rm -f "$name" >/dev/null 2>&1 || true
    done
    print_warning "No free port from ${SHARE_PORT_FIRST} to ${SHARE_PORT_LAST}"
    return 1
}

# The tunnel's public address: the last one it announced (it can be given
# a new one if it reconnects), or nothing yet.
share_tunnel_url() {
    docker logs "$(share_tunnel_name "$1")" 2>&1 | grep -oE "$SHARE_TUNNEL_URL_RE" | tail -n1 || true
}

# Starts the tunnel to <site>'s proxy as a container of its own on the
# stack's network (the api image, which has ssh), and waits up to 30s for
# its address.
start_share_tunnel() {
    local site="$1" name image network url i
    name="$(share_tunnel_name "$site")"
    image="$(docker inspect -f '{{.Config.Image}}' wp-api 2>/dev/null)"
    [ -n "$image" ] || image="$(docker compose config --images api 2>/dev/null | head -n1)"
    network="$(stack_network)"
    [ -n "$image" ] && [ -n "$network" ] || { print_warning "Couldn't find the api image or the stack's network -- is the stack up? (wpdev up)"; return 1; }
    docker rm -f "$name" >/dev/null 2>&1 || true
    docker run -d --name "$name" --label "wpdev.share=${site}" --network "$network" --restart unless-stopped \
        -e "KNOWN_HOST=${SHARE_TUNNEL_HOSTKEY}" --entrypoint sh "$image" -c \
        'printf "%s\n" "$KNOWN_HOST" > /tmp/known_hosts
         exec ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/tmp/known_hosts \
             -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes \
             -T -R "80:'"$(share_proxy_name "$site")"':8080" "nokey@'"${SHARE_TUNNEL_HOST}"'" -- --output json' \
        </dev/null >/dev/null
    for i in $(seq 1 30); do
        url="$(share_tunnel_url "$site")"
        [ -n "$url" ] && { echo "$url"; return 0; }
        container_running "$name" || break
        sleep 1
    done
    docker logs --tail 5 "$name" 2>&1 | sed 's/^/    /' >&2
    docker rm -f "$name" >/dev/null 2>&1 || true
    return 1
}

share_off() {
    local site="$1" domain key
    domain="$(site_domain_of "$site")"
    docker rm -f "$(share_tunnel_name "$site")" "$(share_proxy_name "$site")" >/dev/null 2>&1 || true
    rm -f "$(share_conf "$domain")" "$(share_htpasswd "$domain")"
    for key in SHARE_PORT SHARE_UNTIL SHARE_PUBLIC SHARE_ADMIN SHARE_PASSWORD; do site_unset "$site" "$key"; done
}

# KEY=value lines for a site's share; SHARED=0 and nothing else when it
# isn't shared.
share_status() {
    local site="$1" until port ip tunnel="" url=""
    until="$(site_get "$site" SHARE_UNTIL)"
    port="$(site_get "$site" SHARE_PORT)"
    if [ -z "$until" ] || ! docker inspect "$(share_proxy_name "$site")" >/dev/null 2>&1; then
        echo "SHARED=0"
        return 0
    fi
    ip="$(host_lan_ip)"
    echo "SHARED=1"
    echo "DOMAIN=$(site_domain_of "$site")"
    echo "PORT=${port}"
    echo "PROXY=$(container_running "$(share_proxy_name "$site")" && echo up || echo down)"
    echo "LAN_URL=${ip:+http://${ip}:${port}}"
    echo "LOCAL_URL=http://127.0.0.1:${port}"
    if [ "$(site_get "$site" SHARE_PUBLIC)" = "1" ]; then
        if container_running "$(share_tunnel_name "$site")"; then
            url="$(share_tunnel_url "$site")"
            tunnel="${url:+up}"; tunnel="${tunnel:-starting}"
        else
            tunnel="down"
        fi
    fi
    echo "PUBLIC_URL=${url}"
    echo "TUNNEL=${tunnel:-off}"
    echo "UNTIL=${until}"
    echo "ADMIN=$(site_get "$site" SHARE_ADMIN)"
    echo "PASSWORD=$(site_get "$site" SHARE_PASSWORD)"
}

# wpdev share                                  every shared site
# wpdev share <site>                           its share (KEY=value lines)
# wpdev share <site> on [--for=1h] [--public] [--admin] [--password=X]
# wpdev share <site> off
# wpdev share --expire-due | --all-off
cmd_share() {
    local site_arg="" action="" a duration="1h" public=0 admin=0 password="" secs port until site now
    for a in "$@"; do
        case "$a" in
            --expire-due)
                now="$(date +%s)"
                for site in $(site_names); do
                    until="$(site_get "$site" SHARE_UNTIL)"
                    [ -n "$until" ] && [ "$until" -le "$now" ] || continue
                    share_off "$site"
                    print_info "Share of $(site_domain_of "$site") expired and was turned off"
                done
                return 0
                ;;
            --all-off)
                for site in $(site_names); do
                    [ -n "$(site_get "$site" SHARE_UNTIL)" ] || continue
                    share_off "$site"
                    print_info "Stopped sharing $(site_domain_of "$site")"
                done
                docker ps -aq --filter label=wpdev.share | xargs -r docker rm -f >/dev/null 2>&1 || true
                return 0
                ;;
            --for=*) duration="${a#--for=}" ;;
            --public) public=1 ;;
            --admin) admin=1 ;;
            --password=*) password="${a#--password=}" ;;
            on|off) action="$a" ;;
            -*) print_error "Unknown option: ${a}" ;;
            *) site_arg="$a" ;;
        esac
    done

    if [ -z "$site_arg" ]; then
        for site in $(site_names); do
            [ -n "$(site_get "$site" SHARE_UNTIL)" ] || continue
            site_domain_of "$site"
            share_status "$site" | sed 's/^/  /'
        done
        return 0
    fi
    resolve_site "$site_arg"
    [ -f "nginx/sites/${domain}.conf" ] || print_error "No such site: ${site_arg}"

    case "$action" in
        "")
            share_status "$site_name"
            ;;
        off)
            share_off "$site_name"
            print_info "Stopped sharing ${domain}"
            ;;
        on)
            secs="$(share_duration_seconds "$duration")" || print_error "--for takes 1m to 1d, e.g. 30m, 2h, 1d (got '${duration}')"
            [[ -z "$password" || "$password" =~ ^[[:print:]]{4,64}$ ]] || print_error "The password needs 4 to 64 printable characters"
            container_running wp-nginx || print_error "nginx isn't running -- start the stack first: wpdev up"

            render_share_conf "$domain" "$admin" "$password"
            # The port it had, when changing a running share, so the
            # address handed out keeps working.
            if ! port="$(start_share_proxy "$site_name" "$(site_get "$site_name" SHARE_PORT)")"; then
                share_off "$site_name"
                print_error "The share's proxy didn't start (above) -- nothing was shared"
            fi
            until=$(($(date +%s) + secs))
            site_set "$site_name" SHARE_PORT "$port"
            site_set "$site_name" SHARE_UNTIL "$until"
            site_set "$site_name" SHARE_ADMIN "$admin"
            if [ -n "$password" ]; then site_set "$site_name" SHARE_PASSWORD "$password"; else site_unset "$site_name" SHARE_PASSWORD; fi

            if [ "$public" -eq 1 ]; then
                site_set "$site_name" SHARE_PUBLIC 1
                # The tunnel points at the proxy by name, so a running one
                # carries on (same address) through the proxy's restart.
                if ! { container_running "$(share_tunnel_name "$site_name")" && [ -n "$(share_tunnel_url "$site_name")" ]; }; then
                    if ! start_share_tunnel "$site_name" >/dev/null; then
                        site_unset "$site_name" SHARE_PUBLIC
                        print_warning "The public tunnel (${SHARE_TUNNEL_HOST}) didn't come up -- see above. The site is still shared on your network."
                    fi
                fi
            else
                site_unset "$site_name" SHARE_PUBLIC
                docker rm -f "$(share_tunnel_name "$site_name")" >/dev/null 2>&1 || true
            fi

            print_info "Sharing ${domain} until $(date -d "@${until}" '+%H:%M' 2>/dev/null || date -r "$until" '+%H:%M')"
            share_status "$site_name" | sed -n 's/^LAN_URL=\(.\{1,\}\)/  On your network: \1/p; s/^PUBLIC_URL=\(.\{1,\}\)/  Public:          \1/p'
            [ "$admin" = "1" ] || echo "  wp-admin isn't shared (--admin to include it)."
            [ -z "$password" ] || echo "  Password-protected: user 'preview', password '${password}'."
            ;;
    esac
}

# ---------------------------------------------------------------------------
# On / off: a site you're not using costs nothing
# ---------------------------------------------------------------------------
# Sites share their containers (one PHP-FPM per version, one MySQL, nginx),
# so "off" isn't a container of its own stopping. It's everything the site
# makes the stack do: nginx answers it with a short page before PHP ever
# sees the request, WP-Cron skips it (php/wp-cron-runner.sh), and its PHP
# version stops counting as in use (php_versions_in_use) -- so that
# container stops when no site that's on needs it. Files, database and
# settings are untouched, and `on` brings it back in seconds.

off_conf() { echo "nginx/sites/off/$1.conf"; }

site_is_off() { [ "$(site_get "$1" SITE_STATE)" = "off" ]; }

# epoch -> "2026-10-20 14:02", or nothing.
format_epoch() {
    [ -n "$1" ] && date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null
    return 0
}

# "since 2026-10-20 14:02, by auto-off", for messages.
off_description() {
    local since by
    since="$(format_epoch "$(site_get "$1" OFF_SINCE)")"
    by="$(site_get "$1" OFF_BY)"
    echo "since ${since:-?}, by ${by:-you}"
}

# The "this site is off" page for <domain>. Server-level directives only,
# so it answers before any location block -- the media proxy's and admin
# domain's included. No $ or ' in the page: nginx would read them.
render_off_conf() {
    local domain="$1" site="$2" conf
    conf="$(off_conf "$domain")"
    mkdir -p "$(dirname "$conf")"
    cat > "$conf" <<CONF
# Managed by \`wpdev off\` for ${domain} -- \`wpdev on ${site}\` removes it.
add_header Cache-Control "no-store" always;
add_header Retry-After 3600 always;
default_type text/html;
return 503 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${domain} is switched off</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;font:16px/1.6 system-ui,sans-serif;background:#f6f7f9;color:#1d2327}main{max-width:34rem;padding:2rem 1rem}h1{font-size:1.4rem;margin:0 0 .5rem}code{background:#e3e6ea;padding:.1rem .4rem;border-radius:4px}@media (prefers-color-scheme:dark){body{background:#16181d;color:#e6e8ec}code{background:#2a2e36}}</style></head><body><main><h1>${domain} is switched off</h1><p>This local site is off to save resources. Its files and database are untouched.</p><p>Turn it back on with <code>wpdev on ${site}</code>, or from the dashboard.</p></main></body></html>';
CONF
}

# Waits (up to 20s) until PHP-FPM in <service> accepts connections: its
# container counts as started a moment before that, and a page served in
# that moment is a 502.
wait_for_php() {
    local i
    for i in $(seq 1 40); do
        docker exec "wp-$1" bash -c 'echo > /dev/tcp/127.0.0.1/9000' >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    print_warning "wp-$1 started but PHP-FPM isn't answering yet -- the site may show an error for a moment"
}

# Starts <service> quietly (Compose's progress lines go nowhere) and waits
# until it serves. A first-time image build still says so, on stdout.
start_php_quietly() {
    ensure_php_running "$1" 2>/dev/null || print_error "Couldn't start wp-$1 -- try: docker compose up -d $1"
    wait_for_php "$1"
}

# Nginx picks up on/off changes; a stopped nginx reads them when it starts.
reload_nginx_for_power() {
    container_running wp-nginx || return 0
    reload_nginx_or_fail || print_warning "nginx -t failed after the change -- run: wpdev reload-nginx"
}

# Marks <site> off and writes its page. Applying it (nginx reload, PHP stop)
# is the caller's job, once for however many sites it switched.
site_off() {
    local site="$1" by="$2" domain
    domain="$(site_domain_of "$site")"
    if [ -n "$(site_get "$site" SHARE_UNTIL)" ]; then
        share_off "$site"
        print_info "Stopped sharing ${domain}"
    fi
    site_set "$site" SITE_STATE off
    site_set "$site" OFF_SINCE "$(date +%s)"
    site_set "$site" OFF_BY "$by"
    [ -f "nginx/sites/${domain}.conf" ] && ensure_vhost_includes "$domain"
    render_off_conf "$domain" "$site"
}

# Every off site has its page and no site that's on has one -- after a
# snapshot restore, a hand-edited config, or an upgrade from before on/off.
sync_off_pages() {
    local site domain changed=0 conf
    for site in $(site_names); do
        domain="$(site_domain_of "$site")"
        conf="$(off_conf "$domain")"
        if site_is_off "$site"; then
            if [ ! -f "$conf" ] || ! grep -q 'sites/off/' "nginx/sites/${domain}.conf"; then
                ensure_vhost_includes "$domain"
                render_off_conf "$domain" "$site"
                changed=1
            fi
        elif [ -f "$conf" ]; then
            rm -f "$conf"
            changed=1
        fi
    done
    [ "$changed" = 1 ] && reload_nginx_for_power
    return 0
}

# The site names a command's arguments mean: each one given, or every site
# with --all. Unknown ones are an error before anything changes.
power_targets() {
    local a all=0 names=""
    for a in "$@"; do
        case "$a" in
            --all) all=1 ;;
            -*) print_error "Unknown option: ${a}" >&2 ;;
            *)
                resolve_site "$a"
                [ -f "nginx/sites/${domain}.conf" ] || print_error "No such site: ${a}" >&2
                names="${names} ${site_name}"
                ;;
        esac
    done
    [ "$all" = 1 ] && names="$(site_names | tr '\n' ' ')"
    echo $names
}

# wpdev off <site>... | --all
cmd_off() {
    local targets site domain switched=0
    targets="$(power_targets "$@")"
    [ -n "$targets" ] || { print_warning "Usage: wpdev off <site>... | --all"; return 1; }
    for site in $targets; do
        domain="$(site_domain_of "$site")"
        if site_is_off "$site"; then
            print_info "${domain} is already off"
            continue
        fi
        site_off "$site" you
        print_info "${domain} is off -- wpdev on ${site} brings it back"
        switched=1
    done
    [ "$switched" = 1 ] || return 0
    reload_nginx_for_power
    stop_unused_php
}

# wpdev on <site>... | --all
# Its PHP starts before its page goes, so there's no moment of 502s.
cmd_on() {
    local targets site domain svc started=" " switched=0
    targets="$(power_targets "$@")"
    [ -n "$targets" ] || { print_warning "Usage: wpdev on <site>... | --all"; return 1; }
    for site in $targets; do
        domain="$(site_domain_of "$site")"
        if ! site_is_off "$site"; then
            print_info "${domain} is already on"
            continue
        fi
        svc="$(site_php_service "$site")"
        if container_running wp-nginx; then
            case "$started" in
                *" ${svc} "*) ;;
                *) start_php_quietly "$svc"; started="${started}${svc} " ;;
            esac
        fi
        site_unset "$site" SITE_STATE
        site_unset "$site" OFF_SINCE
        site_unset "$site" OFF_BY
        site_set "$site" LAST_ON "$(date +%s)"
        rm -f "$(off_conf "$domain")"
        print_info "${domain} is on: $(site_url "$domain")"
        switched=1
    done
    [ "$switched" = 1 ] || return 0
    reload_nginx_for_power
    container_running wp-nginx || print_info "The stack isn't running -- wpdev up starts it with these sites on."
}

# A site's auto-off setting -- its own AUTO_OFF, else AUTO_OFF_AFTER in
# .env, else never -- and where it came from: "<value> <site|default>".
auto_off_setting() {
    local v
    v="$(site_get "$1" AUTO_OFF)"
    if [ -n "$v" ]; then echo "$v site"; return 0; fi
    v="$(sed -n 's/^AUTO_OFF_AFTER=//p' .env 2>/dev/null | tail -1 | tr -d '"\r'"'"' ')"
    echo "${v:-never} default"
}

# When <site> last had a visit (epoch), from its nginx access log -- the
# newest request that isn't wpdev's own check (status) or WordPress
# calling itself (loopbacks, cron spawns). Nothing when there's none.
site_last_visit() {
    local log="logs/nginx/${1}_access.log" line stamp
    [ -r "$log" ] || return 0
    line="$(tac "$log" 2>/dev/null | grep -v -m1 -e "\"${WPDEV_PROBE_UA}\"" -e '"WordPress/' || true)"
    stamp="$(echo "$line" | sed -n 's/^[^[]*\[\([^]]*\)\].*/\1/p')"
    [ -n "$stamp" ] || return 0
    # 20/Oct/2026:19:18:03 +0000 -> 20 Oct 2026 19:18:03 +0000
    date -d "$(echo "$stamp" | sed 's|/| |g; s|:| |')" +%s 2>/dev/null || true
}

# AUTO_OFF_AFTER from .env as it was first seen, "<value> <epoch>", kept in
# .wpdev/ -- .env is edited by hand, so this is how wpdev learns when the
# default changed. Updated (and the clock restarted) whenever it differs.
AUTO_OFF_DEFAULT_STATE=".wpdev/auto-off-default"
auto_off_default_since() {
    local value="$1" saved_value saved_at
    read -r saved_value saved_at 2>/dev/null <"$AUTO_OFF_DEFAULT_STATE" || true
    if [ "$saved_value" != "$value" ] || [ -z "$saved_at" ]; then
        saved_at="$(date +%s)"
        mkdir -p "$(dirname "$AUTO_OFF_DEFAULT_STATE")"
        echo "${value} ${saved_at}" >"$AUTO_OFF_DEFAULT_STATE" 2>/dev/null || true
    fi
    echo "$saved_at"
}

# Since when <site> has been idle (epoch): the newest of its last visit,
# when it was last switched on, when nginx last started (so a stack that
# was down all weekend doesn't switch every site off the minute it comes
# back), and when its auto-off limit was set (so turning auto-off on, or
# shortening it, never switches off a site the moment it's saved).
# Nothing when none is known.
site_idle_since() {
    local t newest=0 started default_at="" setting source
    started="$(docker inspect -f '{{.State.StartedAt}}' wp-nginx 2>/dev/null || true)"
    [ -n "$started" ] && started="$(date -d "$started" +%s 2>/dev/null || true)"
    read -r setting source <<<"$(auto_off_setting "$1")"
    if [ "$source" = "default" ] && [ "$setting" != "never" ]; then
        default_at="$(auto_off_default_since "$setting")"
    fi
    for t in "$(site_last_visit "$1")" "$(site_get "$1" LAST_ON)" "$started" \
        "$(site_get "$1" AUTO_OFF_SET)" "$default_at"; do
        [ -n "$t" ] && [ "$t" -gt "$newest" ] && newest="$t"
    done
    [ "$newest" -gt 0 ] && echo "$newest"
    return 0
}

# wpdev auto-off                          every site's setting
# wpdev auto-off <site>                   its setting (KEY=value lines)
# wpdev auto-off <site> <3d|12h|never|default>
# wpdev auto-off --due                    switch off sites idle past theirs
cmd_auto_off() {
    local site_arg="${1:-}" value="${2:-}" setting source secs idle now site switched=0
    now="$(date +%s)"
    case "$site_arg" in
        --due)
            container_running wp-nginx || return 0
            for site in $(site_names); do
                site_is_off "$site" && continue
                # A shared site has someone else looking at it.
                [ -n "$(site_get "$site" SHARE_UNTIL)" ] && continue
                read -r setting source <<<"$(auto_off_setting "$site")"
                secs="$(backup_interval_seconds "$setting")" || continue
                idle="$(site_idle_since "$site")"
                [ -n "$idle" ] || continue
                [ $((now - idle)) -ge "$secs" ] || continue
                site_off "$site" auto-off
                print_info "Switched $(site_domain_of "$site") off: no visits for ${setting}"
                switched=1
            done
            if [ "$switched" = 1 ]; then
                reload_nginx_for_power
                stop_unused_php
            fi
            return 0
            ;;
        "")
            printf "%-28s %-6s %-14s %s\n" "DOMAIN" "STATE" "AUTO-OFF" "IDLE SINCE"
            for site in $(site_names); do
                read -r setting source <<<"$(auto_off_setting "$site")"
                [ "$source" = "default" ] && setting="${setting} (default)"
                idle="$(format_epoch "$(site_idle_since "$site")")"
                printf "%-28s %-6s %-14s %s\n" "$(site_domain_of "$site")" \
                    "$(site_is_off "$site" && echo off || echo on)" "$setting" "${idle:-?}"
            done
            return 0
            ;;
        -*) print_error "Unknown option: ${site_arg}" ;;
    esac

    resolve_site "$site_arg"
    [ -f "nginx/sites/${domain}.conf" ] || print_error "No such site: ${site_arg}"

    case "$value" in
        "")
            read -r setting source <<<"$(auto_off_setting "$site_name")"
            idle="$(site_idle_since "$site_name")"
            echo "STATE=$(site_is_off "$site_name" && echo off || echo on)"
            echo "OFF_SINCE=$(site_get "$site_name" OFF_SINCE)"
            echo "OFF_BY=$(site_get "$site_name" OFF_BY)"
            echo "AUTO_OFF=${setting}"
            echo "SOURCE=${source}"
            echo "IDLE_SINCE=${idle}"
            if secs="$(backup_interval_seconds "$setting")" && [ -n "$idle" ] && ! site_is_off "$site_name"; then
                echo "OFF_AT=$((idle + secs))"
            else
                echo "OFF_AT="
            fi
            ;;
        default)
            site_unset "$site_name" AUTO_OFF
            site_set "$site_name" AUTO_OFF_SET "$(date +%s)"
            read -r setting source <<<"$(auto_off_setting "$site_name")"
            print_info "${domain} follows the default auto-off (AUTO_OFF_AFTER in .env): ${setting}"
            ;;
        never|off)
            site_set "$site_name" AUTO_OFF never
            print_info "${domain} never switches itself off"
            ;;
        *)
            backup_interval_seconds "$value" >/dev/null || print_error "Auto-off takes a time like 30m, 12h, 3d or 1w, or never / default (got '${value}')"
            site_set "$site_name" AUTO_OFF "$value"
            site_set "$site_name" AUTO_OFF_SET "$(date +%s)"
            print_info "${domain} switches itself off after ${value} without a visit"
            ;;
    esac
}

# Commands that need a site's PHP, run against a site that's off: start its
# PHP container just for this command, and stop it again on the way out
# when still nothing that's on needs it. On stderr, so `wpdev wp`'s own
# output stays clean.
wake_php_for_off_site() {
    local arg="$1" name svc
    [ -n "$arg" ] && [ "${arg#-}" = "$arg" ] || return 0
    name="$(resolve_site "$arg"; echo "$site_name")"
    [ -f "$(site_config_file "$name")" ] && site_is_off "$name" || return 0
    svc="$(site_php_service "$name")"
    container_running "wp-${svc}" && return 0
    container_running wp-nginx || return 0
    print_warning "$(site_domain_of "$name") is off -- starting wp-${svc} just for this command" >&2
    start_php_quietly "$svc" >&2
    trap 'stop_unused_php >/dev/null 2>&1 || true' EXIT
}

cmd_add() {
    # --domain=/--php= let this run headless (e.g. driven by an API instead
    # of a human at a TTY). Providing --domain is what signals non-interactive
    # mode: it skips the domain prompt, the PHP-version prompt (falling back
    # to DEFAULT_PHP_VERSION if --php wasn't also given), and the final
    # "Continue? (y/n)" confirmation -- all three use a bare `read -p` with no
    # `|| true`, which would otherwise take the whole run down under `set -e`
    # the moment stdin isn't an interactive TTY (e.g. piped from /dev/null).
    domain=""
    php_version=""
    wp_version=""
    repair=0
    for a in "$@"; do
        case "$a" in
            --domain=*) domain="${a#--domain=}" ;;
            --php=*) php_version="${a#--php=}" ;;
            --wp-version=*) wp_version="${a#--wp-version=}" ;;
            --repair) repair=1 ;;
        esac
    done
    non_interactive=0
    [ -n "$domain" ] && non_interactive=1

    # 0. Make sure .env exists, and load it (needed for DB_ROOT_PASSWORD)
    if [ ! -f .env ]; then
        cp .env.example .env
        print_info "Created .env from .env.example"
    fi
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a

    if [ -z "${DB_ROOT_PASSWORD:-}" ]; then
        print_error "DB_ROOT_PASSWORD is not set in .env"
    fi

    echo "======================================"
    echo "  New WordPress Site Setup"
    echo "======================================"
    echo ""
    if [ -z "$domain" ]; then
        read -p "Enter domain name (e.g., mysite.$(domain_suffix), or just mysite): " domain
    fi

    if [ -z "$domain" ]; then
        print_error "Domain name cannot be empty!"
    fi
    domain="$(echo "$domain" | tr 'A-Z' 'a-z')"
    # A bare name gets the default suffix (DOMAIN_SUFFIX in .env).
    case "$domain" in *.*) ;; *) domain="${domain}.$(domain_suffix)" ;; esac
    # An existing site is only re-run on purpose (every step skips what's
    # already there, so that repairs one); anything else must be a domain
    # that's free and not a real one -- see new_domain_problem.
    if [ -f "nginx/sites/${domain}.conf" ]; then
        if [ "$repair" -eq 1 ]; then
            print_info "${domain} is already a site -- repairing: only missing steps run."
        elif [ "$non_interactive" -eq 1 ]; then
            print_error "${domain} is already a site. To redo any missing steps: wpdev add --domain=${domain} --repair"
        else
            print_warning "${domain} is already a site -- continuing only redoes missing steps."
        fi
    else
        problem="$(new_domain_problem "$domain")"
        [ -z "$problem" ] || print_error "Can't add ${domain}: ${problem}"
    fi

    site_name="$(site_name_of "$domain")"

    # MySQL identifiers: no dots/dashes, capped at 32 chars (MySQL user limit).
    # A new site's name already fits (SITE_NAME_MAX); the cut is for sites
    # added before that limit.
    db_slug="${site_name//-/_}"
    db_slug="${db_slug:0:28}"
    db_name="wp_${db_slug}"
    db_user="wp_${db_slug}"

    # PHP version — only asked for a genuinely new site; re-running `add` on
    # one that already has a PHP_VERSION saved reuses it silently, same as
    # every other idempotent step below (nginx conf, wp-config, cert). This
    # isn't how you'd change an existing site's PHP version — no config
    # regeneration happens here, so changing it later needs manual follow-up.
    if [ -n "$(site_get "$site_name" PHP_VERSION)" ]; then
        php_version="$(site_get "$site_name" PHP_VERSION)"
    elif [ -n "$php_version" ]; then
        case " $SUPPORTED_PHP_VERSIONS " in
            *" $php_version "*) ;;
            *) print_error "Unknown PHP version '${php_version}'. Supported: $SUPPORTED_PHP_VERSIONS" ;;
        esac
    elif [ "$non_interactive" -eq 1 ]; then
        php_version="$DEFAULT_PHP_VERSION"
    else
        read -p "PHP version [$DEFAULT_PHP_VERSION] (choices: $SUPPORTED_PHP_VERSIONS): " php_version
        php_version="${php_version:-$DEFAULT_PHP_VERSION}"
        case " $SUPPORTED_PHP_VERSIONS " in
            *" $php_version "*) ;;
            *) print_error "Unknown PHP version '${php_version}'. Supported: $SUPPORTED_PHP_VERSIONS" ;;
        esac
    fi
    php_svc="$(php_slug "$php_version")"
    url="$(site_url "$domain")"

    # WordPress version — optional, empty means "whatever wp-cli resolves
    # as latest" (passed straight through to `wp core download`, so there's
    # no fixed list to validate against or keep up to date the way PHP's
    # SUPPORTED_PHP_VERSIONS has to be -- an unknown/mistyped version just
    # fails there with wp-cli's own real error instead of a guessed one).
    # Same idempotency note as PHP version: only asked for a genuinely new
    # site, and even then only matters if step 3 below actually downloads
    # anything -- an existing, non-empty site directory skips the download
    # (and so this answer) entirely.
    if [ -z "$wp_version" ] && [ "$non_interactive" -ne 1 ]; then
        read -p "WordPress version [latest]: " wp_version
    fi

    echo ""
    echo "Domain:          $domain"
    echo "Site directory:  sites/$site_name"
    echo "Database:        $db_name"
    echo "PHP version:     $php_version ($php_svc)"
    echo "WordPress:       ${wp_version:-latest}"
    echo ""
    if [ "$non_interactive" -eq 1 ]; then
        print_info "Skipping confirmation (--domain given -- non-interactive mode)."
    else
        read -p "Continue? (y/n): " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            cancelled
        fi
    fi

    # 1. Bring up MySQL + PHP + Redis (needed for wp-cli/db/cache steps below;
    #    harmless if already running). Nginx is brought up/reloaded later
    #    once its config and cert exist.
    print_step "1/9 Starting MySQL + ${php_svc} + Redis..."
    ensure_php_running "$php_svc"
    docker compose up -d mysql redis >/dev/null
    wait_for_mysql
    print_info "MySQL, PHP and Redis are up"

    # 2. Nginx configuration — one file, immediately served (no enable step)
    print_step "2/9 Creating Nginx configuration..."
    mkdir -p nginx/sites

    if [ -f "nginx/sites/${domain}.conf" ]; then
        print_warning "Config nginx/sites/${domain}.conf already exists. Skipping."
    else
        if [ ! -f "nginx/sites/site.conf.template" ]; then
            print_error "Template file nginx/sites/site.conf.template not found!"
        fi

        sed "s/DOMAIN/$domain/g" nginx/sites/site.conf.template > "nginx/sites/${domain}.conf"
        sed -i "s|/var/www/SITE_NAME|/var/www/$site_name|g" "nginx/sites/${domain}.conf"
        sed -i "s/SITE_NAME/$site_name/g" "nginx/sites/${domain}.conf"
        sed -i "s/PHP_UPSTREAM/$php_svc/g" "nginx/sites/${domain}.conf"
        print_info "Created nginx/sites/${domain}.conf"
    fi

    # 3. Download WordPress
    print_step "3/9 Downloading WordPress..."
    mkdir -p "sites/$site_name"
    site_set "$site_name" PHP_VERSION "$php_version"

    if [ "$(ls -A "sites/$site_name" 2>/dev/null | grep -v '^\.gitkeep$')" ]; then
        print_warning "Directory sites/$site_name is not empty. Skipping WordPress download."
        preexisting_site=1
    else
        preexisting_site=0
        print_info "Downloading WordPress${wp_version:+ ${wp_version}}..."
        # wp-cli's own downloader, not a manual curl+tar+mv -- it already
        # knows how to resolve "latest" vs. a specific version, which is
        # all `--version` does here. Not best-effort/guarded: a failure
        # here (bad version string, network down) should stop the whole
        # thing, same as the old curl call did.
        download_args=(core download --path="/var/www/${site_name}" --allow-root)
        [ -n "$wp_version" ] && download_args+=(--version="$wp_version")
        # memory_limit: wp-cli extracts the tarball with PharData, which
        # holds it in memory -- current WordPress releases no longer fit in
        # PHP's default 128M ("Allowed memory size ... exhausted" in
        # Extractor.php). Raised for this one call only, not image-wide.
        php_exec "$php_svc" php -d memory_limit=512M /usr/local/bin/wp "${download_args[@]}" </dev/null >/dev/null
        print_info "WordPress downloaded to sites/$site_name"
    fi

    # 4. Database + dedicated DB user
    print_step "4/9 Provisioning database..."

    # Safety net: files already existed (step 3 skipped the download) but
    # wp-config.php is missing — this is NOT the normal "brand new site"
    # case. It usually means an already-configured site's wp-config.php was
    # deleted/lost, possibly pointing at a differently-named database this
    # tool doesn't know about. Silently creating a fresh wp_<slug> database
    # here would orphan the real one instead of reconnecting to it.
    if [ "$preexisting_site" -eq 1 ] && [ ! -f "sites/${site_name}/wp-config.php" ]; then
        print_warning "sites/${site_name}/ already has WordPress files but no wp-config.php."
        print_warning "If this site was set up before (manually, or its config was lost), a NEW"
        print_warning "database '${db_name}' will be created and connected — it will NOT reuse"
        print_warning "an existing differently-named database, which would be left orphaned."
        read -p "Type 'yes' to create a fresh database and wp-config.php anyway: " force_confirm
        if [ "$force_confirm" != "yes" ]; then
            print_error "Aborted. If this site has an existing database, restore wp-config.php by hand instead."
        fi
    fi

    db_pass="$(site_get "$site_name" DB_PASSWORD)"
    if [ -n "$db_pass" ]; then
        print_info "Reusing existing database credentials"
    else
        db_pass="$(openssl rand -hex 16)"
        site_set "$site_name" DB_PASSWORD "$db_pass"
    fi

    docker compose exec -T mysql mysql -uroot -p"$DB_ROOT_PASSWORD" -e "
        CREATE DATABASE IF NOT EXISTS \`${db_name}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        CREATE USER IF NOT EXISTS '${db_user}'@'%' IDENTIFIED BY '${db_pass}';
        ALTER USER '${db_user}'@'%' IDENTIFIED BY '${db_pass}';
        GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO '${db_user}'@'%';
        FLUSH PRIVILEGES;
    " </dev/null 2>/dev/null
    print_info "Database '${db_name}' and user '${db_user}' ready"

    # 5. wp-config.php via WP-CLI
    print_step "5/9 Generating wp-config.php..."
    if [ -f "sites/${site_name}/wp-config.php" ]; then
        print_info "wp-config.php already exists. Skipping."
    else
        php_exec "$php_svc" wp config create \
            --path="/var/www/${site_name}" \
            --dbname="${db_name}" \
            --dbuser="${db_user}" \
            --dbpass="${db_pass}" \
            --dbhost="mysql" \
            --skip-check \
            --allow-root \
            --extra-php <<PHP
define('WP_HOME', '${url}');
define('WP_SITEURL', '${url}');
define('WP_DEBUG', true);
define('WP_DEBUG_LOG', true);
define('WP_DEBUG_DISPLAY', false);
define('FS_METHOD', 'direct');
define('WP_CACHE', true);
define('WP_REDIS_HOST', 'redis');
define('WP_REDIS_PREFIX', '${site_name}:');
define('DISABLE_WP_CRON', true);
PHP
        print_info "wp-config.php created"
    fi

    # 6. SSL certificate
    print_step "6/9 Generating SSL certificate..."
    mkdir -p nginx/ssl/certs nginx/ssl/private

    if ! command -v mkcert >/dev/null 2>&1; then
        print_warning "mkcert not installed. Run 'wpdev install-mkcert' then re-run this."
        print_warning "Skipping SSL certificate generation."
    else
        if [ -f "nginx/ssl/certs/${domain}.pem" ]; then
            print_info "SSL certificate already exists for ${domain}"
        else
            mkcert -install 2>/dev/null || true
            mkcert -cert-file "nginx/ssl/certs/${domain}.pem" \
                   -key-file "nginx/ssl/private/${domain}-key.pem" \
                   "${domain}" 2>/dev/null
            print_info "SSL certificate created"
        fi
    fi

    # 7. WordPress install (skip the browser installer entirely)
    print_step "7/9 Installing WordPress..."
    if php_exec "$php_svc" wp core is-installed --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
        print_info "WordPress already installed. Skipping."
    else
        admin_pass="$(site_get "$site_name" ADMIN_PASSWORD)"
        if [ -z "$admin_pass" ]; then
            admin_pass="$(openssl rand -base64 18 | tr -dc 'A-Za-z0-9')"
            site_set "$site_name" ADMIN_PASSWORD "$admin_pass"
        fi

        php_exec "$php_svc" wp core install \
            --path="/var/www/${site_name}" \
            --url="${url}" \
            --title="${domain}" \
            --admin_user="admin" \
            --admin_password="${admin_pass}" \
            --admin_email="admin@${domain}" \
            --skip-email \
            --allow-root </dev/null >/dev/null
        print_info "WordPress installed"
    fi

    admin_pass="$(site_get "$site_name" ADMIN_PASSWORD)"
    [ -z "$admin_pass" ] && admin_pass="(not saved — WordPress was already installed)"

    # 8. Object cache — install + activate the redis-cache plugin and drop in
    # its object-cache.php, then verify Redis actually responds. A failed
    # `redis enable` is a warning, not a hard stop: the site works fine
    # without an object cache, just slower.
    print_step "8/9 Enabling Redis object cache..."
    # Best-effort, not required: a failed plugin download (no network
    # reaching wordpress.org, etc.) must not take the rest of site
    # provisioning down with it -- the site is perfectly usable without
    # object caching, just slower on repeat queries. Same reasoning and
    # same bug class as nginx-helper's install further down.
    redis_plugin_ok=1
    if php_exec "$php_svc" wp plugin is-installed redis-cache --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
        print_info "redis-cache plugin already installed"
    elif php_exec "$php_svc" wp plugin install redis-cache --activate --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
        print_info "redis-cache plugin installed and activated"
    else
        redis_plugin_ok=0
        print_warning "Could not install the redis-cache plugin -- site works fine without object caching."
        print_warning "Retry with: wpdev wp ${site_name} plugin install redis-cache --activate"
    fi

    if [ "$redis_plugin_ok" -eq 1 ]; then
        if php_exec "$php_svc" wp redis status --path="/var/www/${site_name}" --allow-root </dev/null 2>/dev/null | grep -q "Connected"; then
            print_info "Object cache already enabled"
        elif php_exec "$php_svc" wp redis enable --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
            print_info "Object cache enabled"
        else
            print_warning "Could not enable the Redis object cache — site works fine without it."
            print_warning "Check with: wpdev wp ${site_name} redis status"
        fi
    fi

    # 9. Dev-experience plugins -- remove WordPress's stock defaults nobody
    # uses in a dev environment, add the two most useful general-purpose
    # debugging plugins. Not tied to Redis/FastCGI caching specifically
    # (unlike redis-cache above, these are just a better default for every
    # site regardless of what else is turned on).
    print_step "9/9 Removing default plugins, installing dev plugins..."
    php_exec "$php_svc" wp plugin delete hello akismet --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1 || true
    print_info "Removed Hello Dolly + Akismet (if present)"

    # Best-effort, not required, same reasoning as redis-cache/nginx-helper:
    # a failed download must not take the rest of provisioning down with it.
    for plugin in query-monitor wp-crontrol; do
        if php_exec "$php_svc" wp plugin is-installed "$plugin" --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
            print_info "${plugin} already installed"
        elif php_exec "$php_svc" wp plugin install "$plugin" --activate --path="/var/www/${site_name}" --allow-root </dev/null >/dev/null 2>&1; then
            print_info "${plugin} installed and activated"
        else
            print_warning "Could not install ${plugin} -- skipping (not required for the site to work)."
        fi
    done

    # Everything above already ran as you (php_exec), so this is a safety
    # net: an existing site directory `add` adopted, files a step created
    # as root, an older php image. (#20)
    if fix_site_ownership "$php_svc" "$site_name"; then
        print_info "Site files are owned by you — editable from your editor, and writable by WordPress itself"
    else
        print_warning "Couldn't hand sites/${site_name} over to you — wp-admin plugin updates may fail. Run: wpdev fix-perms ${site_name}"
    fi

    # Bring up Nginx (and reload, in case it was already running) so the new
    # vhost + cert are picked up.
    docker compose up -d nginx >/dev/null
    docker exec wp-nginx nginx -t >/dev/null 2>&1 && docker exec wp-nginx nginx -s reload >/dev/null 2>&1 || true

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "${GREEN}✓ ${domain} is ready${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo -e "  Site:        ${GREEN}${url}${NC}"
    echo "  PHP version: ${php_version} (${php_svc})"
    echo -e "  Admin login: ${GREEN}${url}/wp-admin${NC}  (admin / ${admin_pass})"
    echo "  Database:    ${db_name} (user ${db_user} / ${db_pass})"
    echo "  Adminer:     wpdev adminer ${site_name}  (server mysql, user ${db_user} -- not root, not admin)"
    echo "  Object cache: Redis (check with: wpdev wp ${site_name} redis status)"
    echo "  Outgoing mail: caught by Mailpit — wpdev mailpit"
    echo ""
    echo "Credentials are saved in $(site_config_file "$site_name") (git-ignored, readable only by you)."
    echo ""

    # Optional: /etc/hosts
    ensure_hosts_entry "$domain" $(( non_interactive ? 0 : 1 ))
    echo ""
}

# The host ports were renumbered when Portainer left (it had 39003):
# Mailpit, the api and the dashboard each moved down one to close the gap.
# An .env made from the old .env.example still holds the old defaults, so
# a value that's still its old default moves; one you chose stays. Done
# per key in ascending order (each new number was just vacated by the
# previous key), skipped if the new number is taken by another setting,
# Runs once per .env (the marker line below), so a move it had to skip
# warns once rather than on every command. Reported on stderr, so it never
# mixes into output a caller parses.
ENV_PORTS_MARKER="# wpdev: ports renumbered (Mailpit 39003/39004, API 39005, dashboard 39006)"
migrate_env_ports() {
    [ -f .env ] || return 0
    grep -qxF "$ENV_PORTS_MARKER" .env && return 0
    local pair key old new moved=""
    sed -i '/^PORTAINER_PORT=[0-9]*$/d' .env
    for pair in MAILPIT_UI_PORT:39004:39003 MAILPIT_SMTP_PORT:39005:39004 API_PORT:39006:39005 DASHBOARD_PORT:39007:39006; do
        IFS=: read -r key old new <<<"$pair"
        grep -qx "${key}=${old}" .env || continue
        if grep -qE "^[A-Z_]+=${new}\$" .env; then
            print_warning "Not moving ${key} to ${new}: another setting in .env already uses it." >&2
            continue
        fi
        sed -i "s/^${key}=${old}\$/${key}=${new}/" .env
        moved="${moved} ${key} ${old}→${new},"
    done
    printf '\n%s\n' "$ENV_PORTS_MARKER" >>.env
    if [ -n "$moved" ]; then
        echo -e "${GREEN}✓${NC} Ports renumbered in .env (Portainer's 39003 is free now):${moved%,}. Run 'wpdev up' to apply them." >&2
    fi
    return 0
}

